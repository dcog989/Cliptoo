# This is the top level editorconfig
root = true

# Defaults: Rust, Python, C/C++, Slint and most languages use 4 spaces
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Web and frontend files use 2 spaces
[*.{astro,cjs,css,htm,html,js,json,json5,jsonc,jsx,less,mjs,sass,scss,svelte,svg,ts,tsx,vue,xhtml,xml,xsd,xsl}]
indent_size = 2

# Data and config files use 2 spaces
[*.{yaml,yml,toml}]
indent_size = 2

# Shell and CMake scripts use 2 spaces
[*.{bash,bashrc,cmake,fish,sh,zsh}]
indent_size = 2
[CMakeLists.txt]
indent_size = 2

# These use tabs
[*.{go,Makefile,makefile,GNUMakefile}]
indent_style = tab
tab_width = 4

# Markdown may need trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

# Windows command scripts use CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Do not touch generated directories
[{.git,.mypy_cache,.pytest_cache,.ruff_cache,.terraform,.venv,build,coverage,dist,node_modules,out,target,vendor,__pycache__}/**]
indent_size = unset
trim_trailing_whitespace = unset
end_of_line = unset
insert_final_newline = unset

# Do not touch lock files
[{*.lock,Cargo.lock,package-lock.json,pnpm-lock.yaml,bun.lock,bun.lockb,poetry.lock,uv.lock}]
indent_size = unset
trim_trailing_whitespace = unset
end_of_line = unset
insert_final_newline = unset
