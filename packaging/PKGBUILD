# Maintainer: Cliptoo Contributors
#
# Packages the already-built release binary (target/release/cliptoo) rather
# than rebuilding from source. Run `make package` from the repository root,
# or `cargo build --release -p cliptoo` then `makepkg` from this directory.
pkgname=cliptoo
pkgver=2.16.0
pkgrel=1
pkgdesc="Native clipboard manager for KDE Plasma 6 / Wayland"
arch=('x86_64')
url="https://github.com/dcog989/Cliptoo"
license=('MIT')
options=('!debug')
# Cliptoo targets Wayland / KDE Plasma 6. On Wayland, the XDG Desktop Portal
# is the only sanctioned mechanism for client apps to register a global
# hotkey; there is no X11-style XGrabKey fallback. The KDE portal backend
# (xdg-desktop-portal-kde) transitively pulls the router (xdg-desktop-portal)
# and is the appropriate dependency for this app's target environment.
# See src/ui/src/hotkeys.rs and .docs/HLD.md §9.1.
depends=(
    'qt6-base'
    'qt6-wayland'
    'wayland'
    'libxkbcommon'
    'xdg-desktop-portal-kde'
    'kwindowsystem'
)
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/../target/release/cliptoo" "$pkgdir/usr/bin/cliptoo"
    install -Dm644 "$startdir/../packaging/cliptoo.desktop" "$pkgdir/usr/share/applications/cliptoo.desktop"
    install -Dm644 "$startdir/../src/ui/assets/cliptoo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cliptoo.svg"
    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
