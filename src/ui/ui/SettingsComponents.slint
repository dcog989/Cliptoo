import { Theme } from "Theme.slint";
import { InputBox } from "InputBox.slint";

// Row scaffolding shared by every settings row: fixed-width label column +
// the caller's cells, normally a single `InputBox`. `fill` lets the field take
// the row's remaining width; otherwise cells keep their preferred size, so a
// row can also place a trailing action after the field.
export component SettingsRow {
    in property <string> label;
    in property <string> tooltip-text;
    in property <bool> fill: false;

    height: 32px;
    // Fill the host row's width: as a child of a non-layout component root
    // (the row), an implicit-size custom component would otherwise be centered
    // at its preferred width instead of stretching across the row.
    width: 100%;

    HorizontalLayout {
        spacing: 12px;
        // Stretch alignment lets a `fill` field consume the remaining row
        // width (via horizontal-stretch); `start` pins hugging cells to their
        // preferred size. A single fixed alignment can't serve both.
        alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;

        Text {
            width: 180px;
            text: root.label;
            color: Theme.fg-primary;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }

        @children
    }

    if root.tooltip-text != "": Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

// Uppercase category heading that labels a group of options.
export component SectionHeader {
    in property <string> text;
    in property <length> top-margin: 14px;

    width: 100%;
    VerticalLayout {
        padding-top: root.top-margin;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: Theme.accent-primary;
            font-size: Theme.font-size + 2px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: left;
        }
    }
}

export component StepperButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip-text;
    // Accessible name. The glyph alone ("−", "‹") is not descriptive.
    in property <string> action-label: "";
    // Optical nudge for glyphs whose ink sits below the line's optical center
    // (guillemets ‹ ›); the math +/− glyphs need none.
    in property <length> glyph-offset: 0px;
    callback clicked;
    out property <bool> hovered: touch.has-hover;

    min-width: 24px;
    // Fill the field's interior (28px field, minus 1px border top and bottom)
    // so the hover fill never covers the field outline.
    height: 26px;
    border-radius: 4px;
    background: touch.has-hover || step-focus.has-focus ? Theme.bg-row-hover : transparent;
    border-width: step-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent-primary;
    animate background { duration: Theme.anim-fast; }

    accessible-role: button;
    accessible-label: root.action-label != "" ? root.action-label : root.text;
    accessible-action-default => {
        root.clicked();
    }

    step-focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }

        Text {
            text: root.text;
            color: Theme.fg-primary;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
            y: root.glyph-offset;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                step-focus.focus();
                root.clicked();
            }
        }
    }

    if root.tooltip-text != "": Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component TextRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;
        fill: true;

        InputBox {
            horizontal-stretch: 1;
            min-width: 300px;
            hot: ti.has-focus;
            hover: input-touch.has-hover;

            // The TextInput consumes pointer moves, so a sibling hover area
            // never sees them. An enclosing TouchArea does: its filter runs
            // before the child takes the event.
            input-touch := TouchArea {
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    ti := TextInput {
                        text <=> root.value;
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        accessible-label: root.label;
                        // Commit as the text changes: hiding the window does not drop
                        // focus back to the page, so a blur-only commit lost edits.
                        edited => {
                            root.committed(root.value);
                        }
                    }
                }
            }
        }
    }
}

export component HotkeyRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);
    private property <bool> captured: false;
    private property <string> display-text: (ti.has-focus && !root.captured) ? "Press hotkey…" : root.value;

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;

        InputBox {
            hot: ti.has-focus;
            hover: hotkey-touch.has-hover;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                ti := TextInput {
                    text <=> root.display-text;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    accessible-label: root.label;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            ti.clear-focus();
                            accept
                        } else if (event.text >= "\u{0010}" && event.text <= "\u{0018}") {
                            // A bare modifier key. Slint encodes Shift/Control/
                            // Alt/Meta/CapsLock as U+0010..U+0018 (see Slint's
                            // key_codes table); committing here would capture a
                            // modifier with no key (and `clean_hotkey_text`'s
                            // control-char mapping would turn it into a phantom
                            // letter). Wait for the actual key instead.
                            reject
                        } else {
                            root.value = (event.modifiers.control ? "Ctrl+" : "")
                                + (event.modifiers.alt ? "Alt+" : "")
                                + (event.modifiers.shift ? "Shift+" : "")
                                + (event.modifiers.meta ? "Meta+" : "")
                                + event.text;
                            root.captured = true;
                            root.committed(root.value);
                            // Release focus so the next key press does not
                            // silently overwrite the hotkey just assigned.
                            ti.clear-focus();
                            accept
                        }
                    }
                }
            }

            hotkey-touch := TouchArea {
                clicked => {
                    root.captured = false;
                    ti.focus();
                }
            }
        }
    }
}

// Shared body of the −/+ and ‹/› rows: two steppers around a value cell.
export component StepperRowBody {
    in property <string> leading-glyph: "−";
    in property <string> trailing-glyph: "+";
    // Accessible names for the two buttons.
    in property <string> leading-label: @tr("Decrease");
    in property <string> trailing-label: @tr("Increase");
    in property <length> glyph-offset: 0px;
    callback step-back();
    callback step-forward();

    out property <bool> prev-hover: prev.hovered;
    out property <bool> next-hover: next.hovered;

    HorizontalLayout {
        padding-left: 1px;
        padding-right: 1px;
        spacing: 4px;
        cross-axis-alignment: center;
        prev := StepperButton {
            text: root.leading-glyph;
            action-label: root.leading-label;
            glyph-offset: root.glyph-offset;
            clicked => {
                root.step-back();
            }
        }

        @children

        next := StepperButton {
            text: root.trailing-glyph;
            action-label: root.trailing-label;
            glyph-offset: root.glyph-offset;
            clicked => {
                root.step-forward();
            }
        }
    }
}

export component IntRow {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-val: 0;
    in property <int> max-val: 99999;
    in property <int> step: 1;
    in property <string> unit: "";
    in property <string> tooltip-text;
    callback committed(int);

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;

        InputBox {
            hover: int-body.prev-hover || int-body.next-hover;

            int-body := StepperRowBody {
                step-back() => {
                    root.value = Math.max(root.min-val, root.value - root.step);
                    root.committed(root.value);
                }
                step-forward() => {
                    root.value = Math.min(root.max-val, root.value + root.step);
                    root.committed(root.value);
                }

                Text {
                    text: "\{root.value}\{root.unit}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }
            }
        }
    }
}

export component FloatRow {
    in property <string> label;
    in-out property <int> value-hundredths;
    in property <int> min-hundredths: 0;
    in property <int> max-hundredths: 9999;
    in property <int> step-hundredths: 50;
    in property <string> unit: "";
    in property <string> tooltip-text;
    callback committed(float);

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;

        InputBox {
            hover: float-body.prev-hover || float-body.next-hover;

            float-body := StepperRowBody {
                step-back() => {
                    root.value-hundredths = Math.max(root.min-hundredths, root.value-hundredths - root.step-hundredths);
                    root.committed(root.value-hundredths / 100.0);
                }
                step-forward() => {
                    root.value-hundredths = Math.min(root.max-hundredths, root.value-hundredths + root.step-hundredths);
                    root.committed(root.value-hundredths / 100.0);
                }

                Text {
                    text: "\{root.value-hundredths / 100}\{root.unit}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }
            }
        }
    }
}

export component SliderRow {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-val: 0;
    in property <int> max-val: 100;
    in property <int> step: 1;
    in property <string> unit: "%";
    // When true, a value of 0 is displayed as "Off" instead of "0<unit>".
    in property <bool> zero-is-off: false;
    in property <string> tooltip-text;
    callback committed(int);

    // The track stretches to fill the row width; the drag math uses the live
    // track width. `track-min-width` keeps it usable in narrow windows. (A
    // native `Slider` widget collapses to ~0 width inside these rows, so the
    // track is drawn and dragged by hand. The outer layout must use stretch
    // alignment — `alignment: start` pins children to their preferred size and
    // disables `horizontal-stretch`.)
    private property <length> track-min-width: 160px;

    function set-value(v: int) {
        root.value = Math.min(root.max-val, Math.max(root.min-val, v));
        root.committed(root.value);
    }

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;
        fill: true;

        InputBox {
            horizontal-stretch: 1;
            hot: slider-focus.has-focus;
            hover: slider-touch.has-hover;

            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                track := Rectangle {
                    horizontal-stretch: 1;
                    min-width: root.track-min-width;
                    height: 28px;
                    border-radius: 3px;

                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.bg-track;
                        y: (parent.height - 6px) / 2;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: Theme.accent-fill;
                            y: (parent.height - 16px) / 2;
                            x: Math.max(0px, Math.min(parent.width - 16px, (root.value - root.min-val) * 1.0 / (root.max-val - root.min-val) * parent.width));
                        }
                    }

                    slider-focus := FocusScope {
                        accessible-role: slider;
                        accessible-label: root.label;
                        accessible-value: "\{root.value}\{root.unit}";
                        accessible-value-minimum: root.min-val * 1.0;
                        accessible-value-maximum: root.max-val * 1.0;
                        accessible-value-step: root.step * 1.0;
                        accessible-action-increment => {
                            root.set-value(root.value + root.step);
                        }
                        accessible-action-decrement => {
                            root.set-value(root.value - root.step);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                                root.set-value(root.value - root.step);
                                accept
                            } else if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                                root.set-value(root.value + root.step);
                                accept
                            } else if (event.text == Key.Home) {
                                root.set-value(root.min-val);
                                accept
                            } else if (event.text == Key.End) {
                                root.set-value(root.max-val);
                                accept
                            } else {
                                reject
                            }
                        }

                        slider-touch := TouchArea {
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                                    if (e.kind == PointerEventKind.down) {
                                        slider-focus.focus();
                                    }
                                    let span = root.max-val - root.min-val;
                                    let frac = slider-touch.mouse-x / track.width;
                                    let raw = root.min-val + Math.round(Math.min(1.0, Math.max(0.0, frac)) * span);
                                    root.set-value(Math.round(raw / root.step) * root.step);
                                }
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                Text {
                    text: root.zero-is-off && root.value == 0 ? @tr("Off") : "\{root.value}\{root.unit}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }
            }
        }
    }
}

export component DropRow {
    in property <string> label;
    in-out property <int> index;
    in property <[string]> options;
    in property <string> tooltip-text;
    callback committed(string);

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;

        InputBox {
            hover: drop-body.prev-hover || drop-body.next-hover;

            drop-body := StepperRowBody {
                leading-glyph: "‹";
                trailing-glyph: "›";
                leading-label: @tr("Previous option");
                trailing-label: @tr("Next option");
                glyph-offset: -2px;
                step-back() => {
                    root.index = root.index == 0 ? root.options.length - 1 : root.index - 1;
                    root.committed(root.options[root.index]);
                }
                step-forward() => {
                    root.index = Math.mod(root.index + 1, root.options.length);
                    root.committed(root.options[root.index]);
                }

                Text {
                    text: root.options[root.index];
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component ToggleRow {
    in property <string> label;
    in-out property <bool> value;
    in property <string> tooltip-text;
    callback committed(bool);

    function toggle() {
        root.value = !root.value;
        root.committed(root.value);
    }

    SettingsRow {
        label: root.label;
        tooltip-text: root.tooltip-text;
        fill: true;

        InputBox {
            horizontal-stretch: 1;
            bordered: false;

            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 4px;
                toggle-focus := FocusScope {
                    width: 44px;
                    height: 22px;
                    accessible-role: switch;
                    accessible-checkable: true;
                    accessible-checked: root.value;
                    accessible-label: root.label;
                    accessible-action-default => {
                        root.toggle();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            root.toggle();
                            accept
                        } else {
                            reject
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 11px;
                        border-width: toggle-focus.has-focus ? 1px : 0px;
                        border-color: Theme.accent-primary;
                        background: root.value ? Theme.accent-fill : Theme.bg-track;
                        animate background { duration: Theme.anim-fast; }
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: root.value ? Theme.accent-fg : white;
                            x: root.value ? 24px : 2px;
                            animate x { duration: Theme.anim-fast; }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                toggle-focus.focus();
                                root.toggle();
                            }
                        }
                    }
                }
            }
        }
    }
}
