import { Theme } from "Theme.slint";

export component StepperButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip-text;
    callback clicked;
    callback pressed-changed(bool);

    min-width: 24px;
    HorizontalLayout {
        cross-axis-alignment: center;
        Text {
            text: root.text;
            color: Theme.fg-primary;
            font-size: 22px;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-changed(true);
            } else if (e.kind == PointerEventKind.up) {
                root.pressed-changed(false);
            }
        }
        clicked => {
            root.clicked();
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component SettingsTab {
    in property <string> label;
    in property <string> tooltip-text;
    in property <bool> is-active: false;
    callback clicked;

    height: 40px;
    width: label-text.preferred-width + 20px;

    Rectangle {
        background: transparent;
        border-width: 0;
        Rectangle {
            y: parent.height - 2px;
            height: 2px;
            width: parent.width;
            background: root.is-active ? Theme.accent-primary : transparent;
            animate background { duration: Theme.anim-fast; }
        }

        label-text := Text {
            text: root.label;
            color: root.is-active ? Theme.fg-primary : Theme.fg-muted;
            font-size: Theme.font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: Theme.anim-fast; }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
        mouse-cursor: pointer;
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component TextRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 300px;
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                ti := TextInput {
                    text <=> root.value;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    accepted => {
                        root.committed(root.value);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component HotkeyRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);
    private property <bool> captured: false;
    private property <string> display-text: (ti.has-focus && !root.captured) ? "Press hotkey…" : root.value;

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: ti.has-focus ? Theme.accent-primary : Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                ti := TextInput {
                    text <=> root.display-text;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            ti.clear-focus();
                            accept
                        } else {
                            root.value = (event.modifiers.control ? "Ctrl+" : "")
                                + (event.modifiers.alt ? "Alt+" : "")
                                + (event.modifiers.shift ? "Shift+" : "")
                                + (event.modifiers.meta ? "Meta+" : "")
                                + event.text;
                            root.captured = true;
                            root.committed(root.value);
                            accept
                        }
                    }
                }
            }
            TouchArea {
                clicked => {
                    root.captured = false;
                    ti.focus();
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component IntRow {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-val: 0;
    in property <int> max-val: 99999;
    in property <int> step: 1;
    in property <string> tooltip-text;
    callback committed(int);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "−";
                    clicked => {
                        root.value = Math.max(root.min-val, root.value - root.step);
                        root.committed(root.value);
                    }
                }

                Text {
                    text: "\{root.value}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }

                StepperButton {
                    text: "+";
                    clicked => {
                        root.value = Math.min(root.max-val, root.value + root.step);
                        root.committed(root.value);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component FloatRow {
    in property <string> label;
    in-out property <int> value-hundredths;
    in property <int> min-hundredths: 0;
    in property <int> max-hundredths: 9999;
    in property <int> step-hundredths: 50;
    in property <string> tooltip-text;
    callback committed(float);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "−";
                    clicked => {
                        root.value-hundredths = Math.max(root.min-hundredths, root.value-hundredths - root.step-hundredths);
                        root.committed(root.value-hundredths / 100.0);
                    }
                }

                Text {
                    text: "\{root.value-hundredths / 100}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }

                StepperButton {
                    text: "+";
                    clicked => {
                        root.value-hundredths = Math.min(root.max-hundredths, root.value-hundredths + root.step-hundredths);
                        root.committed(root.value-hundredths / 100.0);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component DropRow {
    in property <string> label;
    in-out property <int> index;
    in property <[string]> options;
    in property <string> tooltip-text;
    callback committed(string);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "‹";
                    clicked => {
                        root.index = root.index == 0 ? root.options.length - 1 : root.index - 1;
                        root.committed(root.options[root.index]);
                    }
                }

                swatch-area := Rectangle {
                    Text {
                        text: root.options[root.index];
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        horizontal-alignment: center;
                    }
                }

                StepperButton {
                    text: "›";
                    clicked => {
                        root.index = Math.mod(root.index + 1, root.options.length);
                        root.committed(root.options[root.index]);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component ToggleRow {
    in property <string> label;
    in-out property <bool> value;
    in property <string> tooltip-text;
    callback committed(bool);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 5px;
            background: Theme.bg-input;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 4px;
                Rectangle {
                    width: 44px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.value ? Theme.accent-primary : #555;
                    animate background { duration: Theme.anim-fast; }
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: white;
                        x: root.value ? 24px : 2px;
                        animate x { duration: Theme.anim-fast; }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = !root.value;
                            root.committed(root.value);
                        }
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}
