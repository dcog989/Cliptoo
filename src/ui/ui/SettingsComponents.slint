import { Theme } from "Theme.slint";

// Accent-color palette swatch rendered in the settings accent picker popup.
export struct AccentSwatch {
    hex: string,
    color: color,
}

// Uppercase category heading that labels a group of options.
export component SectionHeader {
    in property <string> text;
    in property <length> top-margin: 14px;

    width: 100%;
    VerticalLayout {
        padding-top: root.top-margin;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: Theme.fg-secondary;
            font-size: Theme.font-size + 2px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: left;
        }
    }
}

export component StepperButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip-text;
    callback clicked;
    callback pressed-changed(bool);

    min-width: 24px;
    HorizontalLayout {
        cross-axis-alignment: center;
        Text {
            text: root.text;
            color: Theme.fg-primary;
            font-size: 22px;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-changed(true);
            } else if (e.kind == PointerEventKind.up) {
                root.pressed-changed(false);
            }
        }
        clicked => {
            root.clicked();
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component TextRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 300px;
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                ti := TextInput {
                    text <=> root.value;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    accepted => {
                        root.committed(root.value);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component HotkeyRow {
    in property <string> label;
    in-out property <string> value;
    in property <string> tooltip-text;
    callback committed(string);
    private property <bool> captured: false;
    private property <string> display-text: (ti.has-focus && !root.captured) ? "Press hotkey…" : root.value;

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: ti.has-focus ? Theme.accent-primary : Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                ti := TextInput {
                    text <=> root.display-text;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            ti.clear-focus();
                            accept
                        } else {
                            root.value = (event.modifiers.control ? "Ctrl+" : "")
                                + (event.modifiers.alt ? "Alt+" : "")
                                + (event.modifiers.shift ? "Shift+" : "")
                                + (event.modifiers.meta ? "Meta+" : "")
                                + event.text;
                            root.captured = true;
                            root.committed(root.value);
                            accept
                        }
                    }
                }
            }
            TouchArea {
                clicked => {
                    root.captured = false;
                    ti.focus();
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component IntRow {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-val: 0;
    in property <int> max-val: 99999;
    in property <int> step: 1;
    in property <string> tooltip-text;
    callback committed(int);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "−";
                    clicked => {
                        root.value = Math.max(root.min-val, root.value - root.step);
                        root.committed(root.value);
                    }
                }

                Text {
                    text: "\{root.value}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }

                StepperButton {
                    text: "+";
                    clicked => {
                        root.value = Math.min(root.max-val, root.value + root.step);
                        root.committed(root.value);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component FloatRow {
    in property <string> label;
    in-out property <int> value-hundredths;
    in property <int> min-hundredths: 0;
    in property <int> max-hundredths: 9999;
    in property <int> step-hundredths: 50;
    in property <string> tooltip-text;
    callback committed(float);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "−";
                    clicked => {
                        root.value-hundredths = Math.max(root.min-hundredths, root.value-hundredths - root.step-hundredths);
                        root.committed(root.value-hundredths / 100.0);
                    }
                }

                Text {
                    text: "\{root.value-hundredths / 100}";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }

                StepperButton {
                    text: "+";
                    clicked => {
                        root.value-hundredths = Math.min(root.max-hundredths, root.value-hundredths + root.step-hundredths);
                        root.committed(root.value-hundredths / 100.0);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component SliderRow {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-val: 0;
    in property <int> max-val: 100;
    in property <string> tooltip-text;
    callback committed(int);

    // Fixed track width, mirroring the hover-delay row: a native `Slider`
    // widget collapses to ~0 width inside these `alignment: start` rows, so
    // the track is drawn and dragged by hand instead.
    private property <length> track-width: 160px;

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                track := Rectangle {
                    width: root.track-width;
                    height: 6px;
                    border-radius: 3px;
                    background: #555;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.accent-primary;
                        y: -5px;
                        x: Math.max(0px, Math.min(parent.width - 16px, (root.value - root.min-val) * 1.0 / (root.max-val - root.min-val) * parent.width));
                    }
                }

                Text {
                    text: "\{root.value}%";
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                }
            }

            touch := TouchArea {
                width: root.track-width;
                height: 28px;
                x: 12px;
                y: 0px;
                Tooltip {
                    text: @markdown("\{root.tooltip-text}");
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                        let span = root.max-val - root.min-val;
                        let frac = touch.mouse-x / root.track-width;
                        root.value = root.min-val + Math.round(Math.min(1.0, Math.max(0.0, frac)) * span);
                        root.committed(root.value);
                    }
                }
                mouse-cursor: pointer;
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component DropRow {
    in property <string> label;
    in-out property <int> index;
    in property <[string]> options;
    in property <string> tooltip-text;
    callback committed(string);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.accent-muted;
            background: Theme.bg-input;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                cross-axis-alignment: center;
                StepperButton {
                    text: "‹";
                    clicked => {
                        root.index = root.index == 0 ? root.options.length - 1 : root.index - 1;
                        root.committed(root.options[root.index]);
                    }
                }

                swatch-area := Rectangle {
                    Text {
                        text: root.options[root.index];
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        horizontal-alignment: center;
                    }
                }

                StepperButton {
                    text: "›";
                    clicked => {
                        root.index = Math.mod(root.index + 1, root.options.length);
                        root.committed(root.options[root.index]);
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

export component ToggleRow {
    in property <string> label;
    in-out property <bool> value;
    in property <string> tooltip-text;
    callback committed(bool);

    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text {
                width: 180px;
                text: root.label;
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 5px;
            background: Theme.bg-input;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 4px;
                Rectangle {
                    width: 44px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.value ? Theme.accent-primary : #555;
                    animate background { duration: Theme.anim-fast; }
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: white;
                        x: root.value ? 24px : 2px;
                        animate x { duration: Theme.anim-fast; }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = !root.value;
                            root.committed(root.value);
                        }
                    }
                }
            }
        }
    }

    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}
