// Toolbar.slint — Bottom bar: search input + active-filter icon + hamburger menu.
//
// Layout:
//   |────────────────────────────────────────────────────────|
//   | [Search input field ...........     [filter] [≡]      |
//   |────────────────────────────────────────────────────────|
//
// [filter] icon of the currently selected clip-type filter; click to toggle filter grid
// [≡]      hamburger menu (settings, about, ...)
//
// Active filter keys: "all" | "bookmarked" | "text" | "link" | "file_path" |
//                     "file_image" | "color" | "code_snippet" | "folder" |
//                     "file_danger" | "file_dev" | "file_audio" | "file_video" |
//                     "file_archive" | "file_document" | "rtf" | "html" | "file"

import { Theme }       from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";
import { LineEdit }    from "std-widgets.slint";

export component Toolbar {
    callback filter-changed(string);
    callback toggle-filter-grid();
    callback menu-clicked();
    callback drag-started();
    callback drag-ended();

    in-out property <string> active-filter: "all";
    in-out property <string> search-text: "";
    callback search-changed(string);
    callback accepted();

    // Localized label of the active filter, shown in the filter icon tooltip.
    // Labels mirror FilterGrid.slint's cells via the shared ClipTypeMap.
    property <string> filter-label: ClipTypeMap.label-for(root.active-filter);
    // Tooltip text for the filter icon, e.g. "Filter: Text".
    property <string> filter-tooltip: @tr("Filter: {}", root.filter-label);

    out property <bool> search-focused: search-input.has-focus;

    height: Theme.toolbar-height;

    Rectangle {
        background: Theme.bg-header;
        height: 100%;
        width: 100%;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            // ── Drag handle [3] ────────────────────────────────────
            Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg-input;

                // Visual grip indicator: 2x3 dot grid
                VerticalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 3px;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }
                }

                property <bool> dragging: false;
                touch := TouchArea {
                    mouse-cursor: dragging ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move && touch.pressed && !dragging {
                            dragging = true;
                            root.drag-started();
                        }
                        if e.kind == PointerEventKind.up {
                            dragging = false;
                            root.drag-ended();
                        }
                        if e.kind == PointerEventKind.cancel {
                            dragging = false;
                            root.drag-ended();
                        }
                    }
                }
            }

            // ── Search field (stretches) ────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg-input;
                clip: true;

                search-input := LineEdit {
                    width: 100%;
                    height: 100%;
                    font-size: Theme.font-size;
                    text <=> root.search-text;
                    edited => {
                        root.search-changed(self.text);
                    }
                    accepted => {
                        root.accepted();
                    }
                }

                Text {
                    x: 12px;
                    width: parent.width - self.x;
                    height: 100%;
                    vertical-alignment: center;
                    text: @tr("Search…");
                    color: Theme.fg-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-size;
                    visible: root.search-text == "";
                    accessible-role: none;
                }
            }

            // ── Current filter icon [4] ────────────────────────────
            Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.active-filter == "all" ? Theme.bg-input : Theme.accent-primary;

                Image {
                    source: ClipTypeMap.icon-for(root.active-filter);
                    // "All" sits on a neutral bg-input button (not the accent),
                    // so it uses the neutral secondary foreground — accent-fg
                    // goes black when the accent is light.
                    colorize: root.active-filter == "all" ? Theme.fg-secondary : Theme.accent-fg;
                    width: 20px;
                    height: 20px;
                    x: 6px;
                    y: 6px;
                }

                TouchArea {
                    Tooltip {
                        text: @markdown("\{ root.filter-tooltip}");
                    }

                    clicked => {
                        root.toggle-filter-grid();
                    }
                    mouse-cursor: pointer;
                }
            }

            // ── Hamburger menu [5] (settings, about, ...) ─────────
            Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg-input;

                Image {
                    source: @image-url("icons/menu.svg");
                    colorize: Theme.fg-secondary;
                    width: 20px;
                    height: 20px;
                    x: 6px;
                    y: 6px;
                }

                TouchArea {
                    clicked => {
                        root.menu-clicked();
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
