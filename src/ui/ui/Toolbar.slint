// Toolbar.slint — Bottom bar: search input + active-filter icon + hamburger menu.
//
// Layout:
//   |────────────────────────────────────────────────────────|
//   | [Search input field ...........     [filter] [≡]      |
//   |────────────────────────────────────────────────────────|
//
// [filter] icon of the currently selected clip-type filter; click to toggle filter grid
// [≡]      hamburger menu (settings, about, ...)
//
// Active filter keys: "all" | "bookmarked" | "text" | "link" | "file_path" |
//                     "file_image" | "color" | "code_snippet" | "folder" |
//                     "file_danger" | "file_dev" | "file_audio" | "file_video" |
//                     "file_archive" | "file_document" | "rtf" | "file" | "file_text"

import { Theme } from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";
import { InputBox } from "InputBox.slint";

export component Toolbar {
    callback toggle-filter-grid();
    callback menu-clicked();

    in-out property <string> active-filter: "all";
    in-out property <string> search-text: "";
    callback search-changed(string);
    callback accepted();
    // Up/Down/PageUp/PageDown pressed in the search field. TextInput consumes
    // those keys for cursor movement, so the field forwards them to the clip
    // list itself. Home/End stay with the caret.
    callback search-nav-up();
    callback search-nav-down();
    callback search-nav-page-up();
    callback search-nav-page-down();
    // Emitted when the search field gains or loses focus. Lets the host dismiss
    // a manually-invoked (context-menu) preview when the user clicks into
    // search — clicking the field is a blur of the clip list.
    callback search-focus-changed(bool);

    // Localized label of the active filter, shown in the filter icon tooltip.
    // Labels mirror FilterGrid.slint's cells via the shared ClipTypeMap.
    property <string> filter-label: ClipTypeMap.label-for(root.active-filter);
    // Tooltip text for the filter icon, e.g. "Filter: Text".
    property <string> filter-tooltip: @tr("Filter: {}", root.filter-label);

    out property <bool> search-focused: search-input.has-focus;
    // Window-space top-right corner of the hamburger button, so its popup does
    // not have to re-derive the toolbar's padding.
    out property <length> menu-anchor-x: hamburger-button.absolute-position.x + hamburger-button.width;
    out property <length> menu-anchor-y: hamburger-button.absolute-position.y;

    // Report focus transitions on the search field. MainClipArea uses the
    // gain edge to dismiss a manually-invoked preview lingering over the
    // toolbar (hover previews dismiss themselves via hover-exited).
    changed search-focused => {
        root.search-focus-changed(root.search-focused);
    }

    height: Theme.toolbar-height;

    Rectangle {
        background: Theme.bg-header;
        height: 100%;
        width: 100%;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            // ── Drag handle [3] ────────────────────────────────────
            Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg-input;
                // Custom title bar: the frameless window is moved only by
                // dragging this grip, so expose it as the title bar region.
                accessible-role: window-title-bar;
                accessible-label: @tr("Move window");

                // Visual grip indicator: 2x3 dot grid
                VerticalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 3px;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }

                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fg-muted;
                        }
                    }
                }

                // Interactive window move (xdg-shell _move via the platform).
                // The nested TouchArea only supplies the grab cursor; a plain
                // click stays a click, a drag past the small threshold moves.
                WindowMoveArea {
                    TouchArea {
                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    }
                }
            }

            // ── Search field (stretches) ────────────────────────────
            InputBox {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 8px;
                clip: true;
                hot: search-input.has-focus;
                hover: search-touch.has-hover;

                // Enclosing TouchArea: TextInput swallows pointer moves, so a
                // sibling hover area never sees them.
                search-touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    // Plain TextInput: the std-widgets LineEdit draws its own
                    // focus underline, which fights the accent border above.
                    search-input := TextInput {
                        x: 12px;
                        width: parent.width - 20px;
                        height: 100%;
                        color: Theme.fg-primary;
                        font-family: Theme.font-family;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        // The placeholder below is hidden from assistive tech
                        // (accessible-role: none), so name the field explicitly and
                        // mark it as a search field.
                        input-type: InputType.search;
                        accessible-label: @tr("Search clips");
                        text <=> root.search-text;
                        edited => {
                            root.search-changed(self.text);
                        }
                        accepted => {
                            root.accepted();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow) {
                                root.search-nav-up();
                                accept
                            } else if (event.text == Key.DownArrow) {
                                root.search-nav-down();
                                accept
                            } else if (event.text == Key.PageUp) {
                                root.search-nav-page-up();
                                accept
                            } else if (event.text == Key.PageDown) {
                                root.search-nav-page-down();
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }

                Text {
                    x: 12px;
                    width: parent.width - self.x;
                    height: 100%;
                    vertical-alignment: center;
                    text: @tr("Search…");
                    color: Theme.fg-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-size;
                    visible: root.search-text == "";
                    accessible-role: none;
                }
            }

            // ── Filter icon [4] ────────────────────────────────────
            Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.active-filter == "all" ? Theme.bg-input : Theme.accent-fill;
                border-width: filter-focus.has-focus ? 1px : 0px;
                border-color: Theme.accent-primary;

                filter-focus := FocusScope {
                    accessible-role: button;
                    accessible-label: root.filter-tooltip;
                    accessible-action-default => {
                        root.toggle-filter-grid();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            root.toggle-filter-grid();
                            accept
                        } else {
                            reject
                        }
                    }

                    Image {
                        source: ClipTypeMap.icon-for(root.active-filter);
                        // "All" sits on a neutral bg-input button (not the accent),
                        // so it uses the neutral secondary foreground — accent-fg
                        // goes black when the accent is light.
                        colorize: root.active-filter == "all" ? Theme.fg-secondary : Theme.accent-fg;
                        width: 20px;
                        height: 20px;
                        x: 6px;
                        y: 6px;
                    }

                    TouchArea {
                        Tooltip {
                            text: @markdown("\{ root.filter-tooltip}");
                        }

                        clicked => {
                            filter-focus.focus();
                            root.toggle-filter-grid();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }

            // ── Hamburger menu [5] (settings, about, ...) ─────────
            hamburger-button := Rectangle {
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg-input;
                border-width: menu-focus.has-focus ? 1px : 0px;
                border-color: Theme.accent-primary;

                menu-focus := FocusScope {
                    accessible-role: button;
                    accessible-label: @tr("Main menu");
                    accessible-action-default => {
                        root.menu-clicked();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            root.menu-clicked();
                            accept
                        } else {
                            reject
                        }
                    }

                    Image {
                        source: @image-url("icons/menu.svg");
                        colorize: Theme.fg-secondary;
                        width: 20px;
                        height: 20px;
                        x: 6px;
                        y: 6px;
                    }

                    TouchArea {
                        clicked => {
                            menu-focus.focus();
                            root.menu-clicked();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}
