// ContextMenu.slint — Right-click action menu for clip list items.
// Rendered inside a PopupWindow declared in ContextMenuHost.
//
// This is the main actions view only. The "Format" and "Send To" items open
// their own PopupWindows (FormatMenu / the host's send menu) so every menu is
// sized from fully-visible content at open time — a shown popup cannot reliably
// re-grow when a hidden sub-view becomes visible.

import { Theme }       from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";
import { MenuRow }     from "MenuRow.slint";

export component ContextMenu {
    // Which clip this menu is acting on (set by ContextMenuHost before show()).
    in property <int> clip-id;
    in property <bool> clip-is-bookmarked: false;
    in property <string> clip-type: "text";
    in property <[string]> send-to-apps: [];

    callback preview();
    callback edit();
    callback paste-as(string);      // "rich" | "plain"
    callback delete();
    callback toggle-bookmark(int, bool);  // id, current is-bookmarked
    callback move-to-top();
    callback move-to-bottom();
    callback move-up-one();
    callback move-down-one();
    callback format-open();         // open the Format submenu popup
    callback send-to-open();        // open the Send To submenu popup

    // True when the clip type supports text transformations.
    property <bool> is-text-type: ClipTypeMap.is-text-type(root.clip-type);
    // True for rich-text (RTF/HTML) clips — the only types where choosing
    // between a rich and a plain paste is meaningful.
    property <bool> is-rich-type: root.clip-type == "rtf" || root.clip-type == "html";

    // Intrinsic content size, used by ContextMenuHost to size the popup. The
    // height is computed from the fixed row/separator counts because Slint
    // resolves the preferred size of conditional rows to 0; rows are 32px,
    // separators 9px, vertical padding 4px × 2.
    out property <length> menu-width: menu-root.preferred-width;
    out property <length> menu-height: root.main-menu-height();

    pure function main-menu-height() -> length {
        // Preview, Edit, Delete, 4×Move, Bookmark = 8 rows, plus the
        // conditional Format (text) and Paste Rich/Plain (rich) rows.
        // Separators: the two unconditional, plus one for the rich block.
        let rows = 8
            + (root.is-text-type ? 1 : 0)
            + (root.is-rich-type ? 2 : 0);
        let seps = 2
            + (root.is-rich-type ? 1 : 0);
        return rows * 32px + seps * 9px + 8px;
    }

    menu-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 4px;

        // ── Main view ─────────────────────────────────────────────────────────
        main-view := VerticalLayout {
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Preview");
                icon: @image-url("icons/eye.svg");
                clicked => {
                    root.preview();
                }
            }

            MenuRow {
                label: @tr("Edit");
                icon: @image-url("icons/pencil.svg");
                clicked => {
                    root.edit();
                }
            }

            if root.is-rich-type: MenuRow {
                is-separator: true;
            }
            if root.is-rich-type: MenuRow {
                label: @tr("Paste as Rich Text");
                icon: @image-url("icons/text-initial.svg");
                clicked => {
                    root.paste-as("rich");
                }
            }
            if root.is-rich-type: MenuRow {
                label: @tr("Paste as Plain Text");
                icon: @image-url("icons/text.svg");
                clicked => {
                    root.paste-as("plain");
                }
            }

            if root.is-text-type: MenuRow {
                label: @tr("Format");
                icon: @image-url("icons/pencil-line.svg");
                has-arrow: true;
                clicked => {
                    root.format-open();
                }
            }
            MenuRow {
                label: @tr("Delete");
                icon: @image-url("icons/trash-2.svg");
                is-danger: true;
                clicked => {
                    root.delete();
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: @tr("Move to Top");
                icon: @image-url("icons/arrow-up-to-line.svg");
                clicked => {
                    root.move-to-top();
                }
            }

            MenuRow {
                label: @tr("Move to Bottom");
                icon: @image-url("icons/arrow-down-to-line.svg");
                clicked => {
                    root.move-to-bottom();
                }
            }

            MenuRow {
                label: @tr("Move Up One");
                icon: @image-url("icons/chevron-up.svg");
                clicked => {
                    root.move-up-one();
                }
            }

            MenuRow {
                label: @tr("Move Down One");
                icon: @image-url("icons/chevron-down.svg");
                clicked => {
                    root.move-down-one();
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: root.clip-is-bookmarked ? @tr("Remove Bookmark") : @tr("Bookmark");
                icon: root.clip-is-bookmarked ? @image-url("icons/bookmark-x.svg") : @image-url("icons/bookmark-plus.svg");
                clicked => {
                    root.toggle-bookmark(root.clip-id, root.clip-is-bookmarked);
                }
            }

            if root.send-to-apps.length > 0: MenuRow {
                is-separator: true;
            }
            if root.send-to-apps.length > 0: MenuRow {
                label: @tr("Send To");
                icon: @image-url("icons/send.svg");
                has-arrow: true;
                clicked => {
                    root.send-to-open();
                }
            }
        }
    }
}
