// ContextMenu.slint — Right-click context menu for clip list items.
// Rendered inside a PopupWindow declared in AppWindow.
//
// Three views, toggled by `view`:
//   "main"    — primary actions
//   "format"  — text transformation sub-list
//   "send-to" — Send To app sub-list
//
// The caller (AppWindow) is responsible for positioning and closing the popup.

import { Theme }       from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";
import { MenuRow }     from "MenuRow.slint";

export component ContextMenu {
    // Which clip this menu is acting on (set by AppWindow before show()).
    in property <int> clip-id;
    in property <bool> clip-is-bookmarked: false;
    in property <string> clip-type: "text";
    in property <[string]> send-to-apps: [];

    // Internal view state. AppWindow resets this to "main" before each show().
    in-out property <string> view: "main";  // "main" | "format" | "send-to"

    callback preview();
    callback edit();
    callback format(string);        // transform key
    callback delete();
    callback toggle-bookmark(int, bool);  // id, current is-bookmarked
    callback move-to-top();
    callback move-to-bottom();
    callback move-up-one();
    callback move-down-one();
    callback send-to(string);       // app name

    // True when the clip type supports text transformations.
    property <bool> is-text-type: ClipTypeMap.is-text-type(root.clip-type);

    // Intrinsic content size, used by ContextMenuHost to size the popup. The
    // three view layouts are always instantiated (visibility-toggled) so they
    // keep content-based preferred sizes; if-conditional layouts resolve to 0.
    out property <length> menu-width:
        Math.max(main-view.preferred-width, Math.max(format-view.preferred-width, send-view.preferred-width));
    out property <length> menu-height:
        root.view == "format" ? format-view.preferred-height : root.view == "send-to" ? send-view.preferred-height : main-view.preferred-height;

    menu-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 4px;

        // ── Main view ─────────────────────────────────────────────────────────
        main-view := VerticalLayout {
            visible: root.view == "main";
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Preview");
                icon: @image-url("icons/eye.svg");
                clicked => {
                    root.preview();
                }
            }

            MenuRow {
                label: @tr("Edit");
                icon: @image-url("icons/pencil.svg");
                clicked => {
                    root.edit();
                }
            }

            if root.is-text-type: MenuRow {
                label: @tr("Format");
                icon: @image-url("icons/text-align-start.svg");
                has-arrow: true;
                clicked => {
                    root.view = "format";
                }
            }
            MenuRow {
                label: @tr("Delete");
                icon: @image-url("icons/trash-2.svg");
                is-danger: true;
                clicked => {
                    root.delete();
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: @tr("Move to Top");
                icon: @image-url("icons/arrow-up-to-line.svg");
                clicked => {
                    root.move-to-top();
                }
            }

            MenuRow {
                label: @tr("Move to Bottom");
                icon: @image-url("icons/arrow-down-to-line.svg");
                clicked => {
                    root.move-to-bottom();
                }
            }

            MenuRow {
                label: @tr("Move Up One");
                icon: @image-url("icons/chevron-up.svg");
                clicked => {
                    root.move-up-one();
                }
            }

            MenuRow {
                label: @tr("Move Down One");
                icon: @image-url("icons/chevron-down.svg");
                clicked => {
                    root.move-down-one();
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: root.clip-is-bookmarked ? @tr("Remove Bookmark") : @tr("Bookmark");
                icon: root.clip-is-bookmarked ? @image-url("icons/bookmark-x.svg") : @image-url("icons/bookmark-plus.svg");
                clicked => {
                    root.toggle-bookmark(root.clip-id, root.clip-is-bookmarked);
                }
            }

            if root.send-to-apps.length > 0: MenuRow {
                is-separator: true;
            }
            if root.send-to-apps.length > 0: MenuRow {
                label: @tr("Send To");
                icon: @image-url("icons/send.svg");
                has-arrow: true;
                clicked => {
                    root.view = "send-to";
                }
            }
        }

        // ── Format sub-view ───────────────────────────────────────────────────
        format-view := VerticalLayout {
            visible: root.view == "format";
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Back");
                icon: @image-url("icons/arrow-left.svg");
                clicked => {
                    root.view = "main";
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: @tr("UPPER CASE");
                icon: @image-url("icons/case-upper.svg");
                clicked => {
                    root.format("upper");
                }
            }

            MenuRow {
                label: @tr("lower case");
                icon: @image-url("icons/case-lower.svg");
                clicked => {
                    root.format("lower");
                }
            }

            MenuRow {
                label: @tr("Capitalize Words");
                icon: @image-url("icons/case-sensitive.svg");
                clicked => {
                    root.format("capitalize");
                }
            }

            MenuRow {
                label: @tr("Sentence case");
                icon: @image-url("icons/case-sensitive.svg");
                clicked => {
                    root.format("sentence");
                }
            }

            MenuRow {
                label: @tr("iNVERT cASE");
                icon: @image-url("icons/case-sensitive.svg");
                clicked => {
                    root.format("invert");
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: @tr("kebab-case");
                icon: @image-url("icons/text.svg");
                clicked => {
                    root.format("kebab");
                }
            }

            MenuRow {
                label: @tr("snake_case");
                icon: @image-url("icons/text.svg");
                clicked => {
                    root.format("snake");
                }
            }

            MenuRow {
                label: @tr("camelCase");
                icon: @image-url("icons/text.svg");
                clicked => {
                    root.format("camel");
                }
            }

            MenuRow {
                label: @tr("De-slug");
                icon: @image-url("icons/text.svg");
                clicked => {
                    root.format("deslug");
                }
            }

            MenuRow {
                is-separator: true;
            }

            MenuRow {
                label: @tr("Trim Whitespace");
                icon: @image-url("icons/scissors.svg");
                clicked => {
                    root.format("trim");
                }
            }

            MenuRow {
                label: @tr("Remove Line Breaks");
                icon: @image-url("icons/text-wrap.svg");
                clicked => {
                    root.format("remove_lf");
                }
            }

            MenuRow {
                label: @tr("Normalize LF");
                icon: @image-url("icons/text-wrap.svg");
                clicked => {
                    root.format("lf1");
                }
            }

            MenuRow {
                label: @tr("Add Timestamp");
                icon: @image-url("icons/clock.svg");
                clicked => {
                    root.format("timestamp");
                }
            }
        }

        // ── Send To sub-view ──────────────────────────────────────────────────
        send-view := VerticalLayout {
            visible: root.view == "send-to";
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Back");
                icon: @image-url("icons/arrow-left.svg");
                clicked => {
                    root.view = "main";
                }
            }

            MenuRow {
                is-separator: true;
            }

            for app-name in root.send-to-apps: MenuRow {
                label: app-name;
                clicked => {
                    root.send-to(app-name);
                }
            }
        }
    }
}
