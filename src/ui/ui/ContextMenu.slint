// ContextMenu.slint — Right-click action menu for clip list items.
// Rendered inside a PopupWindow declared in ContextMenuHost.
//
// This is the main actions view only. The "Format" and "Send To" items open
// their own PopupWindows (FormatMenu / the host's send menu) so every menu is
// sized from fully-visible content at open time — a shown popup cannot reliably
// re-grow when a hidden sub-view becomes visible.

import { Theme } from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";
import { MenuRow, MenuSeparator } from "MenuRow.slint";

export component ContextMenu {
    // Which clip this menu is acting on (set by ContextMenuHost before show()).
    in property <int> clip-id;
    in property <bool> clip-is-bookmarked: false;
    in property <string> clip-type: "text";
    in property <[string]> send-to-apps: [];
    // True when the right-click landed inside a multi-selection: Delete then
    // applies to every selected clip.
    in property <bool> multi-selection: false;

    callback preview();
    callback edit();
    callback decode-qr();           // image clips only: show decoded QR payloads
    callback paste();               // default paste for plain text clips
    callback paste-as(string);      // "rich" | "plain"
    callback delete();
    callback delete-selection();    // multi-selection only
    callback merge-selection();     // multi-selection only
    callback toggle-bookmark(int, bool);  // id, current is-bookmarked
    callback move-to-top();
    callback move-to-bottom();
    callback move-up-one();
    callback move-down-one();
    callback format-open();         // open the Format submenu popup
    callback send-to-open();        // open the Send To submenu popup

    // True when the clip type supports text transformations.
    property <bool> is-text-type: ClipTypeMap.is-text-type(root.clip-type);
    // True for rich-text (RTF/HTML) clips, which can paste either as raw markup
    // or as stripped plain text.
    property <bool> is-rich-type: root.clip-type == "rtf" || root.clip-type == "html";
    // True for clips with a file paste rendition (`text/uri-list`).
    property <bool> is-file-type: ClipTypeMap.is-file-type(root.clip-type);
    // Only image clips can hold a QR code.
    property <bool> show-qr: root.clip-type == "file_image";
    // Plain text clips get an explicit plain paste row. Colour clips paste as
    // text too but are not in is-text-type, which also gates the Format menu.
    property <bool> show-paste: (root.is-text-type || root.clip-type == "color") && !root.is-rich-type;
    // Rich clips offer both renditions; file clips only the text path.
    property <bool> show-rich-paste: root.is-rich-type;
    property <bool> show-plain-paste: root.is-rich-type || root.is-file-type;
    property <bool> has-paste-block: root.show-paste || root.show-rich-paste || root.show-plain-paste;

    // Keyboard selection: index of the highlighted row, -1 until the first
    // arrow key. Separators are not counted; row-count is the actionable count.
    in-out property <int> selected: -1;
    // Delete is irreversible, so the first activation arms the row
    // ("Confirm Delete!!") and the second one runs it — same two-step guard as
    // Cancel in the editor.
    in-out property <bool> delete-armed: false;
    property <int> paste-count: (root.show-paste ? 1 : 0)
        + (root.show-rich-paste ? 1 : 0)
        + (root.show-plain-paste ? 1 : 0);
    property <int> send-to-row: root.send-to-apps.length > 0 ? 1 : 0;
    property <int> row-count: 8 + root.paste-count + (root.is-text-type ? 1 : 0) + root.send-to-row + (root.show-qr ? 1 : 0) + (root.multi-selection ? 1 : 0);

    // Row indices, in menu order. Conditional rows share an index with the row
    // that follows them when hidden, so activation always guards on the same
    // boolean that decided the row was rendered.
    property <int> idx-paste: 2 + (root.show-qr ? 1 : 0);
    property <int> idx-rich: root.idx-paste + (root.show-paste ? 1 : 0);
    property <int> idx-plain: root.idx-rich + (root.show-rich-paste ? 1 : 0);
    property <int> idx-format: root.idx-paste + root.paste-count;
    property <int> idx-delete: root.idx-format + (root.is-text-type ? 1 : 0);
    // Merge sits right after Delete; the move rows shift down when it is shown.
    property <int> idx-merge: root.idx-delete + 1;
    property <int> idx-move-top: root.idx-delete + (root.multi-selection ? 2 : 1);
    property <int> idx-bookmark: root.row-count - 1 - root.send-to-row;

    // Wrap around so Down at the last row lands on the first.
    public function move-selection(delta: int) {
        root.delete-armed = false;
        let next = root.selected + delta;
        if (next < 0) {
            root.selected = root.row-count - 1;
        } else if (next >= root.row-count) {
            root.selected = 0;
        } else {
            root.selected = next;
        }
    }

    public function select-first() {
        root.delete-armed = false;
        root.selected = 0;
    }

    public function select-last() {
        root.delete-armed = false;
        root.selected = root.row-count - 1;
    }

    // First call arms, second call deletes.
    function request-delete() {
        if (root.delete-armed) {
            if (root.multi-selection) {
                root.delete-selection();
            } else {
                root.delete();
            }
        } else {
            root.delete-armed = true;
        }
    }

    // Enter: run the highlighted row's action.
    public function activate-selected() {
        let i = root.selected;
        if (i == 0) {
            root.preview();
        } else if (i == 1) {
            root.edit();
        } else if (root.show-qr && i == 2) {
            root.decode-qr();
        } else if (root.show-paste && i == root.idx-paste) {
            root.paste();
        } else if (root.show-rich-paste && i == root.idx-rich) {
            root.paste-as("rich");
        } else if (root.show-plain-paste && i == root.idx-plain) {
            root.paste-as("plain");
        } else if (root.is-text-type && i == root.idx-format) {
            root.format-open();
        } else if (i == root.idx-delete) {
            root.request-delete();
        } else if (root.multi-selection && i == root.idx-merge) {
            root.merge-selection();
        } else if (i == root.idx-move-top) {
            root.move-to-top();
        } else if (i == root.idx-move-top + 1) {
            root.move-to-bottom();
        } else if (i == root.idx-move-top + 2) {
            root.move-up-one();
        } else if (i == root.idx-move-top + 3) {
            root.move-down-one();
        } else if (i == root.idx-bookmark) {
            root.toggle-bookmark(root.clip-id, root.clip-is-bookmarked);
        } else if (root.send-to-row == 1 && i == root.idx-bookmark + 1) {
            root.send-to-open();
        }
    }

    // Intrinsic content size, used by ContextMenuHost to size the popup.
    out property <length> menu-width: menu-root.preferred-width;
    out property <length> menu-height: root.main-menu-height();

    pure function main-menu-height() -> length {
        // Row and separator counts are computed rather than measured because
        // Slint resolves the preferred size of conditional rows to 0; rows use
        // the shared menu metrics so this stays in step with MenuRow.
        // Separators: the three unconditional (above Delete, above Move to
        // Top, above Bookmark), plus one each for the paste block and Send To.
        let seps = 3
            + (root.has-paste-block ? 1 : 0)
            + root.send-to-row;
        return root.row-count * Theme.menu-row-height + seps * Theme.menu-separator-height + Theme.menu-padding * 2;
    }

    menu-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 4px;

        // ── Main view ─────────────────────────────────────────────────────────
        main-view := VerticalLayout {
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Preview");
                icon: @image-url("icons/eye.svg");
                selected: root.selected == 0;
                clicked => {
                    root.preview();
                }
            }

            MenuRow {
                label: @tr("Edit");
                icon: @image-url("icons/pencil.svg");
                selected: root.selected == 1;
                clicked => {
                    root.edit();
                }
            }

            if root.show-qr: MenuRow {
                label: @tr("Decode QR");
                icon: @image-url("icons/file-image.svg");
                selected: root.selected == 2;
                clicked => {
                    root.decode-qr();
                }
            }

            if root.has-paste-block: MenuSeparator { }
            if root.show-paste: MenuRow {
                label: @tr("Paste as Plain Text");
                icon: @image-url("icons/text.svg");
                selected: root.selected == root.idx-paste;
                clicked => {
                    root.paste();
                }
            }
            if root.show-rich-paste: MenuRow {
                label: @tr("Paste as Rich Text");
                icon: @image-url("icons/text-initial.svg");
                selected: root.selected == root.idx-rich;
                clicked => {
                    root.paste-as("rich");
                }
            }
            if root.show-plain-paste: MenuRow {
                label: @tr("Paste as Plain Text");
                icon: @image-url("icons/text.svg");
                selected: root.selected == root.idx-plain;
                clicked => {
                    root.paste-as("plain");
                }
            }
            if root.is-text-type: MenuRow {
                label: @tr("Format");
                icon: @image-url("icons/pencil-line.svg");
                has-arrow: true;
                selected: root.selected == root.idx-format;
                clicked => {
                    root.format-open();
                }
            }
            MenuSeparator { }

            MenuRow {
                label: root.delete-armed
                    ? @tr("Confirm Delete!!")
                    : root.multi-selection
                    ? @tr("Delete Selection")
                    : @tr("Delete");
                icon: @image-url("icons/trash-2.svg");
                is-danger: true;
                armed: root.delete-armed;
                selected: root.selected == root.idx-delete;
                clicked => {
                    root.request-delete();
                }
            }

            if root.multi-selection: MenuRow {
                label: @tr("Merge Selected");
                icon: @image-url("icons/merge.svg");
                selected: root.selected == root.idx-merge;
                clicked => {
                    root.merge-selection();
                }
            }

            MenuSeparator { }

            MenuRow {
                label: @tr("Move to Top");
                icon: @image-url("icons/arrow-up-to-line.svg");
                selected: root.selected == root.idx-move-top;
                clicked => {
                    root.move-to-top();
                }
            }

            MenuRow {
                label: @tr("Move to Bottom");
                icon: @image-url("icons/arrow-down-to-line.svg");
                selected: root.selected == root.idx-move-top + 1;
                clicked => {
                    root.move-to-bottom();
                }
            }

            MenuRow {
                label: @tr("Move Up One");
                icon: @image-url("icons/chevron-up.svg");
                selected: root.selected == root.idx-move-top + 2;
                clicked => {
                    root.move-up-one();
                }
            }

            MenuRow {
                label: @tr("Move Down One");
                icon: @image-url("icons/chevron-down.svg");
                selected: root.selected == root.idx-move-top + 3;
                clicked => {
                    root.move-down-one();
                }
            }

            MenuSeparator { }

            MenuRow {
                label: root.clip-is-bookmarked ? @tr("Remove Bookmark") : @tr("Bookmark");
                icon: root.clip-is-bookmarked ? @image-url("icons/bookmark-x.svg") : @image-url("icons/bookmark-plus.svg");
                selected: root.selected == root.idx-bookmark;
                clicked => {
                    root.toggle-bookmark(root.clip-id, root.clip-is-bookmarked);
                }
            }

            if root.send-to-apps.length > 0: MenuSeparator { }
            if root.send-to-apps.length > 0: MenuRow {
                label: @tr("Send To");
                icon: @image-url("icons/send.svg");
                has-arrow: true;
                selected: root.selected == root.idx-bookmark + 1;
                clicked => {
                    root.send-to-open();
                }
            }
        }
    }
}
