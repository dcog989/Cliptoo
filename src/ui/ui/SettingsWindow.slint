// SettingsWindow.slint — Single-window settings interface (shell).
// The header, the settings page, and the database page live in separate
// components; this file owns the window, the cross-page state, and the toast
// overlay. Persisted values live in the SettingsValues global.

import { Theme } from "Theme.slint";
import { SettingsHeader } from "SettingsHeader.slint";
import { SettingsPage } from "SettingsPage.slint";
import { ShortcutsPage } from "ShortcutsPage.slint";
import { DatabasePage } from "DatabasePage.slint";
import { ToastHost } from "ToastNotification.slint";

export component SettingsWindow inherits Window {
    title: @tr("Cliptoo Settings");
    // Resizable via the WM frame; the size is persisted in Settings
    // (settings_window_width/height) and restored here on open. The height
    // defaults to the main window's height until the user resizes it.
    in-out property <length> stored-width: 560px;
    in-out property <length> stored-height: 600px;
    // Height the window was opened at, used to tell a real user resize from
    // WM-reported geometry. Rust sets it before show().
    in-out property <length> opened-height: 600px;
    preferred-width: root.stored-width;
    preferred-height: root.stored-height;
    min-width: 400px;
    min-height: 400px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in-out property <bool> on-database-page:   false;
    in-out property <bool> on-shortcuts-page:  false;
    in-out property <bool> toast-visible:   false;
    in-out property <string> toast-message:   "";
    in-out property <string> toast-severity:  "info";

    callback settings-closing();
    callback setting-changed(string, string);
    callback maintenance-action(string);
    callback clear-accent-color();
    callback accent-picker();
    callback font-picker();
    callback database-page-shown();

    forward-focus: settings-focus;
    // Keyboard focus scope. Its `key-pressed` handles ESC to close the window;
    // the whole window content lives *inside* the scope so key events from any
    // focused child (e.g. a text field) bubble up to it. A sibling scope
    // only sees keys the focused widget rejected.
    settings-focus := FocusScope {
        // Focused programmatically on open; not a Tab stop of its own, so Tab
        // goes straight to the first control.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.settings-closing();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // ── Header: page title + page navigation ─────────────────────────
            header := SettingsHeader {
                on-database-page <=> root.on-database-page;
                on-shortcuts-page <=> root.on-shortcuts-page;
                database-page-shown() => {
                    root.database-page-shown();
                }
            }

            // ── Content: settings / shortcuts / database page overlay ─────────
            Rectangle {
                width: 100%;
                vertical-stretch: 1;
                clip: true;

                // Settings page — grouped option list. The three pages overlay
                // each other (absolute x/y) so they never stack; only one is
                // visible at a time, but all stay instantiated so state
                // survives page switches.
                settings-page := SettingsPage {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    visible: !root.on-database-page && !root.on-shortcuts-page;

                    setting-changed(k, v) => {
                        root.setting-changed(k, v);
                    }
                    clear-accent-color() => {
                        root.clear-accent-color();
                    }
                    accent-picker() => {
                        root.accent-picker();
                    }
                    font-picker() => {
                        root.font-picker();
                    }
                }

                // Shortcuts page — editable global hotkeys and the cheat sheet.
                shortcuts-page := ShortcutsPage {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    visible: root.on-shortcuts-page;

                    setting-changed(k, v) => {
                        root.setting-changed(k, v);
                    }
                }

                // Database page — retention limits, maintenance buttons, stats.
                database-page := DatabasePage {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    visible: root.on-database-page;

                    setting-changed(k, v) => {
                        root.setting-changed(k, v);
                    }
                    maintenance-action(key) => {
                        root.maintenance-action(key);
                    }
                }
            }
        }
    }

    // ── Toast notification overlay ─────────────────────────────────────
    ToastHost {
        bottom-offset: 16px;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
    }
}
