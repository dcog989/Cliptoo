// SettingsWindow.slint — Tabbed settings interface.
// Tabs: General | Visuals | External Apps | Data

import { Theme } from "Theme.slint";
import {
    SettingsTab,
    TextRow,
    HotkeyRow,
    IntRow,
    FloatRow,
    DropRow,
    ToggleRow,
    StepperButton,
} from "SettingsComponents.slint";
import { ToastNotification } from "ToastNotification.slint";

export component SettingsWindow inherits Window {
    title: "Cliptoo Settings";
    width: 560px;
    height: 520px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in-out property <int> active-tab:             0;  // 0=General 1=Visuals 2=External Apps 3=Data
    in-out property <bool> toast-visible:   false;
    in-out property <string> toast-message:   "";
    in-out property <string> toast-severity:  "info";

    // General
    in-out property <string> s-hotkey:               "Ctrl+Alt+Q";
    in-out property <bool> s-start-with-system:    true;
    in-out property <int> s-log-level-idx:        1;  // Debug/Info/Warn/Error

    // Visuals
    in-out property <int> s-theme-idx:            0;  // System/Light/Dark
    in-out property <int> s-accent-hue:           250;
    in-out property <int> s-chroma-idx:           2;  // Neon/Vibrant/Mellow/Muted/Ditchwater
    in-out property <string> s-font-family:          "Inter";
    in-out property <int> s-font-size-hundredths: 1300;  // 13.00 pt
    in-out property <int> s-preview-font-size-hundredths: 1200;
    in-out property <int> s-row-padding-idx:      1;  // Compact/Standard/Luxury
    in-out property <int> hover-delay:            400;
    in-out property <int> s-image-preview-size:   300;
    in-out property <bool> s-paste-as-plain-text:  false;

    // External Apps
    in-out property <string> s-diff-tool-path:       "";

    // Data
    in-out property <int> s-max-clips:            10000;
    in-out property <int> s-max-age-days:         90;

    callback settings-closing();
    callback setting-changed(string, string);
    callback maintenance-action(string);
    callback hue-step(string);
    callback font-picker();
    callback open-log();

    forward-focus: settings-focus;
    settings-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.settings-closing();
                root.hide();
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Tab bar
        Rectangle {
            height: 40px;
            background: Theme.bg-header;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 4px;
                alignment: start;
                for tab[i] in [
                    { label: "General", tip: "General settings: hotkey, startup, and logging" },
                    { label: "Visuals", tip: "Appearance: theme, colors, fonts, and layout" },
                    { label: "External Apps", tip: "External tools used by Cliptoo" },
                    { label: "Data", tip: "Clipboard history: limits and maintenance" },
                ]: SettingsTab {
                    label: tab.label;
                    tooltip-text: tab.tip;
                    is-active: root.active-tab == i;
                    clicked => {
                        root.active-tab = i;
                    }
                }
            }
        }

        // Tab content
        VerticalLayout {
            vertical-stretch: 1;
            padding: 20px;
            spacing: 0;

            // ── General ───────────────────────────────────────────────────────
            if root.active-tab == 0: VerticalLayout {
                spacing: 12px;
                HotkeyRow {
                    label: "Launch hotkey";
                    tooltip-text: "Global hotkey to toggle the Cliptoo window";
                    value <=> root.s-hotkey;
                    committed(v) => {
                        root.setting-changed("hotkey", v);
                    }
                }

                ToggleRow {
                    label: "Start with system";
                    tooltip-text: "Launch Cliptoo automatically when you log in";
                    value <=> root.s-start-with-system;
                    committed(v) => {
                        root.setting-changed("start_with_system", v ? "true" : "false");
                    }
                }

                DropRow {
                    label: "Log level";
                    tooltip-text: "Verbosity of messages written to the log file";
                    index <=> root.s-log-level-idx;
                    options: ["Debug", "Info", "Warn", "Error"];
                    committed(v) => {
                        root.setting-changed("logging_level", v);
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 32px;
                    Text {
                        width: 180px;
                        text: "Log file";
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Open latest log";
                        color: Theme.accent-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            Tooltip {
                                text: @markdown("Open the most recent log file in your default viewer");
                            }
                            clicked => {
                                root.open-log();
                            }
                        }
                    }
                }
            }

            // ── Visuals ───────────────────────────────────────────────────────
            if root.active-tab == 1: VerticalLayout {
                spacing: 12px;
                DropRow {
                    label: "Theme";
                    index <=> root.s-theme-idx;
                    options: ["System", "Light", "Dark"];
                    committed(v) => {
                        root.setting-changed("theme", v);
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 32px;
                    Text {
                        width: 180px;
                        text: "Accent hue (0–360)";
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.accent-muted;
                        background: Theme.bg-input;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            cross-axis-alignment: center;
                            StepperButton {
                                text: "−";
                                tooltip-text: "Decrease accent hue";
                                pressed-changed(held) => {
                                    root.hue-step(held ? "minus" : "stop");
                                }
                                clicked => {
                                    root.s-accent-hue = Math.max(0, root.s-accent-hue - 1);
                                    root.setting-changed("accent_hue", "\{root.s-accent-hue}");
                                }
                            }

                            Text {
                                text: "\{root.s-accent-hue}";
                                color: Theme.fg-primary;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }

                            StepperButton {
                                text: "+";
                                tooltip-text: "Increase accent hue";
                                pressed-changed(held) => {
                                    root.hue-step(held ? "plus" : "stop");
                                }
                                clicked => {
                                    root.s-accent-hue = Math.min(360, root.s-accent-hue + 1);
                                    root.setting-changed("accent_hue", "\{root.s-accent-hue}");
                                }
                            }

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.accent-muted;
                                background: hsv(root.s-accent-hue, 1.0, 1.0);
                            }
                        }
                    }
                }

                DropRow {
                    label: "Chroma level";
                    tooltip-text: "Color saturation of the accent color";
                    index <=> root.s-chroma-idx;
                    options: ["Neon", "Vibrant", "Mellow", "Muted", "Ditchwater"];
                    committed(v) => {
                        root.setting-changed("accent_chroma_level", v);
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 32px;
                    Text {
                        width: 180px;
                        text: "Font family";
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.accent-muted;
                        background: Theme.bg-input;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            TextInput {
                                text <=> root.s-font-family;
                                color: Theme.fg-primary;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                                accepted => {
                                    root.setting-changed("font_family", root.s-font-family);
                                }
                            }
                        }
                        Tooltip {
                            text: @markdown("Font family used for the clip list");
                        }
                    }

                    StepperButton {
                        text: "…";
                        tooltip-text: "Pick a font from the system font dialog";
                        clicked => {
                            root.font-picker();
                        }
                    }
                }

                FloatRow {
                    label: "Font size (pt)";
                    tooltip-text: "Base interface font size in points";
                    value-hundredths <=> root.s-font-size-hundredths;
                    min-hundredths: 800;
                    max-hundredths: 2400;
                    step-hundredths: 50;
                    committed(v) => {
                        root.setting-changed("font_size", "\{v}");
                    }
                }

                FloatRow {
                    label: "Preview font size (pt)";
                    tooltip-text: "Font size used for code and color previews";
                    value-hundredths <=> root.s-preview-font-size-hundredths;
                    min-hundredths: 800;
                    max-hundredths: 2400;
                    step-hundredths: 50;
                    committed(v) => {
                        root.setting-changed("preview_font_size", "\{v}");
                    }
                }

                DropRow {
                    label: "Row padding";
                    tooltip-text: "Vertical padding of items in the clip list";
                    index <=> root.s-row-padding-idx;
                    options: ["Compact", "Standard", "Luxury"];
                    committed(v) => {
                        root.setting-changed("clip_item_padding", v);
                    }
                }
                // Hover delay slider
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 32px;
                    Text {
                        width: 180px;
                        text: "Preview hover delay";
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.accent-muted;
                        background: Theme.bg-input;
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            track := Rectangle {
                                width: 140px;
                                height: 6px;
                                border-radius: 3px;
                                background: #555;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Theme.accent-primary;
                                    y: -5px;
                                    x: Math.max(0px, Math.min(parent.width - 16px, (root.hover-delay * 1.0) / 2000.0 * parent.width));
                                }
                            }

                            Text {
                                text: root.hover-delay == 0 ? "Off" : "\{root.hover-delay} ms";
                                color: Theme.fg-primary;
                                font-size: Theme.font-size;
                            }
                        }

                        touch := TouchArea {
                            width: 140px;
                            height: 28px;
                            x: 12px;
                            y: 0px;
                            Tooltip {
                                text: @markdown("Delay before the image hover preview appears");
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                                    let raw = Math.round(touch.mouse-x / 140px * 2000 / 50) * 50;
                                    root.hover-delay = Math.min(2000, Math.max(0, raw));
                                    root.setting-changed("hover_preview_delay", "\{root.hover-delay}");
                                }
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                IntRow {
                    label: "Image preview size (px)";
                    tooltip-text: "Maximum width/height of hover preview images";
                    value <=> root.s-image-preview-size;
                    min-val: 100;
                    max-val: 800;
                    step: 50;
                    committed(v) => {
                        root.setting-changed("hover_image_preview_size", "\{v}");
                    }
                }

                ToggleRow {
                    label: "Paste as plain text";
                    tooltip-text: "Strip formatting when pasting text from Cliptoo";
                    value <=> root.s-paste-as-plain-text;
                    committed(v) => {
                        root.setting-changed("paste_as_plain_text", v ? "true" : "false");
                    }
                }
            }

            // ── External Apps ─────────────────────────────────────────────────
            if root.active-tab == 2: VerticalLayout {
                spacing: 12px;
                TextRow {
                    label: "Diff tool path";
                    tooltip-text: "Command used to compare two text clips";
                    value <=> root.s-diff-tool-path;
                    committed(v) => {
                        root.setting-changed("compare_tool_path", v);
                    }
                }

                Text {
                    text: "Send To apps and Blacklist are managed via JSON settings file.";
                    color: Theme.fg-muted;
                    font-size: Theme.font-size;
                    wrap: word-wrap;
                }
            }

            // ── Data ──────────────────────────────────────────────────────────
            if root.active-tab == 3: VerticalLayout {
                spacing: 12px;
                IntRow {
                    label: "Max clips";
                    tooltip-text: "Maximum number of clips kept in history";
                    value <=> root.s-max-clips;
                    min-val: 100;
                    max-val: 100000;
                    step: 100;
                    committed(v) => {
                        root.setting-changed("max_clips", "\{v}");
                    }
                }

                IntRow {
                    label: "Max age (days)";
                    tooltip-text: "Automatically remove clips older than this many days";
                    value <=> root.s-max-age-days;
                    min-val: 1;
                    max-val: 3650;
                    step: 5;
                    committed(v) => {
                        root.setting-changed("max_age_days", "\{v}");
                    }
                }

                GridLayout {
                    spacing: 8px;
                    for action[idx] in [
                        { key: "clear-history", label: "Clear History", tip: "Delete all clips from the clipboard history" },
                        { key: "clear-caches", label: "Clear Caches", tip: "Clear cached previews, thumbnails, and favicons" },
                        { key: "deadhead", label: "Deadhead", tip: "Compact the database file, freeing unused space" },
                        { key: "reclassify", label: "Reclassify All", tip: "Re-run content detection on every clip" },
                        { key: "export", label: "Export JSON", tip: "Save all clips to a JSON file" },
                        { key: "import", label: "Import JSON", tip: "Load clips from a JSON file" },
                    ]: Rectangle {
                        row: Math.floor(idx / 3);
                        col: Math.mod(idx, 3);
                        height: 30px;
                        border-radius: 6px;
                        background: action.key == "clear-history" ? #c0392b.mix(Theme.bg-primary, 0.15) : Theme.bg-input;
                        Text {
                            text: action.label;
                            color: action.key == "clear-history" ? white : Theme.fg-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-size;
                        }

                        TouchArea {
                            Tooltip {
                                text: @markdown("\{action.tip}");
                            }
                            clicked => {
                                root.maintenance-action(action.key);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }

    // ── Toast notification overlay ─────────────────────────────────────
    ToastNotification {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
        dismissed => {
            root.toast-visible = false;
        }
    }
}
