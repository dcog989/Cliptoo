// SettingsWindow.slint — Single-window settings interface (shell).
// The header, the settings page, and the database page live in separate
// components; this file owns the window, the cross-page state, the accent
// swatch popup, and the toast overlay.

import { Theme } from "Theme.slint";
import { AccentSwatch } from "SettingsComponents.slint";
import { SettingsHeader } from "SettingsHeader.slint";
import { SettingsPage } from "SettingsPage.slint";
import { DatabasePage } from "DatabasePage.slint";
import { ToastNotification } from "ToastNotification.slint";

export component SettingsWindow inherits Window {
    title: @tr("Cliptoo Settings");
    // Resizable via the WM frame; the size is persisted in Settings
    // (settings_window_width/height) and restored here on open.
    in-out property <length> stored-width: 560px;
    in-out property <length> stored-height: 540px;
    preferred-width: root.stored-width;
    preferred-height: root.stored-height;
    min-width: 400px;
    min-height: 320px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in-out property <bool> on-database-page:   false;
    in-out property <bool> toast-visible:   false;
    in-out property <string> toast-message:   "";
    in-out property <string> toast-severity:  "info";
    // Instant filter query from the header search box. Matched against each
    // option's keywords by Rust (Slint strings have no substring matching);
    // the match result drives the per-row *-visible properties below.
    in-out property <string> settings-filter: "";

    // General
    in-out property <string> s-hotkey:               "Ctrl+Alt+Q";
    in-out property <bool> s-start-with-system:    true;
    in-out property <bool> s-always-close-to-tray: true;
    in-out property <int> s-quick-paste-mod-idx: 0;  // Right Alt/Left Alt/Control
    in-out property <int> s-log-level-idx:        1;  // Debug/Info/Warn/Error

    // Visuals
    in-out property <int> s-theme-idx:            0;  // System/Light/Dark
    in-out property <color> s-accent-color:       #7C6EE6;
    // 24 swatches evenly spaced across 0–360° hue; built from Rust at startup.
    in-out property <[AccentSwatch]> accent-swatches: [];
    in-out property <string> s-font-family:          "Inter";
    in-out property <int> s-font-size-hundredths: 1300;  // 13.00 pt
    in-out property <int> s-preview-font-size-hundredths: 1200;
    in-out property <int> s-row-padding-idx:      1;  // Compact/Standard/Luxury
    in-out property <int> hover-delay:            400;
    in-out property <int> s-image-preview-size:   300;
    in-out property <bool> s-paste-as-plain-text:  false;

    // External Apps
    in-out property <string> s-diff-tool-path:       "";

    // Data
    in-out property <int> s-max-clips:            10000;
    in-out property <int> s-max-age-days:         90;
    // Read-only statistics, refreshed from Rust each time the Database page opens.
    in-out property <string> s-total-clips: "";
    in-out property <string> s-db-created:  "";
    in-out property <string> s-db-size:     "";
    in-out property <string> s-copies:      "";
    in-out property <string> s-pastes:      "";

    // Per-row filter visibility, set by Rust from `settings-filter`.
    // General
    in-out property <bool> row-hotkey-visible: true;
    in-out property <bool> row-startup-visible: true;
    in-out property <bool> row-tray-visible: true;
    in-out property <bool> row-quickpaste-visible: true;
    in-out property <bool> row-plaintext-visible: true;
    in-out property <bool> row-loglevel-visible: true;
    in-out property <bool> row-logfile-visible: true;
    // Appearance
    in-out property <bool> row-theme-visible: true;
    in-out property <bool> row-accent-visible: true;
    in-out property <bool> row-font-visible: true;
    in-out property <bool> row-clip-font-size-visible: true;
    in-out property <bool> row-preview-font-size-visible: true;
    in-out property <bool> row-padding-visible: true;
    in-out property <bool> row-hover-delay-visible: true;
    in-out property <bool> row-image-preview-size-visible: true;
    // External Apps
    in-out property <bool> row-diff-tool-visible: true;
    in-out property <bool> row-external-note-visible: true;

    callback settings-closing();
    callback setting-changed(string, string);
    callback maintenance-action(string);
    callback clear-accent-color();
    callback font-picker();
    callback database-page-shown();
    callback open-log();
    callback filter-changed(string);

    public function focus-search() {
        header.focus-search();
    }

    forward-focus: settings-focus;
    settings-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.settings-closing();
                root.hide();
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // ── Header: filter search + Database navigation ──────────────────
        header := SettingsHeader {
            on-database-page <=> root.on-database-page;
            settings-filter <=> root.settings-filter;
            filter-changed(q) => {
                root.filter-changed(q);
            }
            database-page-shown() => {
                root.database-page-shown();
            }
        }

        // ── Content: settings page / database page overlay ───────────────
        Rectangle {
            width: 100%;
            vertical-stretch: 1;
            clip: true;

            // Settings page — grouped, filterable option list. The two pages
            // overlay each other (absolute x/y) so they never stack; only one
            // is visible at a time, but both stay instantiated so filter state
            // survives page switches. Rows are conditionally instantiated
            // (`if`), so filtered-out options take no layout space.
            settings-page := SettingsPage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                visible: !root.on-database-page;

                s-hotkey <=> root.s-hotkey;
                s-start-with-system <=> root.s-start-with-system;
                s-always-close-to-tray <=> root.s-always-close-to-tray;
                s-quick-paste-mod-idx <=> root.s-quick-paste-mod-idx;
                s-log-level-idx <=> root.s-log-level-idx;
                s-theme-idx <=> root.s-theme-idx;
                s-accent-color <=> root.s-accent-color;
                s-font-family <=> root.s-font-family;
                s-font-size-hundredths <=> root.s-font-size-hundredths;
                s-preview-font-size-hundredths <=> root.s-preview-font-size-hundredths;
                s-row-padding-idx <=> root.s-row-padding-idx;
                hover-delay <=> root.hover-delay;
                s-image-preview-size <=> root.s-image-preview-size;
                s-paste-as-plain-text <=> root.s-paste-as-plain-text;
                s-diff-tool-path <=> root.s-diff-tool-path;

                row-hotkey-visible: root.row-hotkey-visible;
                row-startup-visible: root.row-startup-visible;
                row-tray-visible: root.row-tray-visible;
                row-quickpaste-visible: root.row-quickpaste-visible;
                row-plaintext-visible: root.row-plaintext-visible;
                row-loglevel-visible: root.row-loglevel-visible;
                row-logfile-visible: root.row-logfile-visible;
                row-theme-visible: root.row-theme-visible;
                row-accent-visible: root.row-accent-visible;
                row-font-visible: root.row-font-visible;
                row-clip-font-size-visible: root.row-clip-font-size-visible;
                row-preview-font-size-visible: root.row-preview-font-size-visible;
                row-padding-visible: root.row-padding-visible;
                row-hover-delay-visible: root.row-hover-delay-visible;
                row-image-preview-size-visible: root.row-image-preview-size-visible;
                row-diff-tool-visible: root.row-diff-tool-visible;
                row-external-note-visible: root.row-external-note-visible;

                setting-changed(k, v) => {
                    root.setting-changed(k, v);
                }
                clear-accent-color() => {
                    root.clear-accent-color();
                }
                font-picker() => {
                    root.font-picker();
                }
                open-log() => {
                    root.open-log();
                }
                accent-picker-requested() => {
                    accent_popup.show();
                }
            }

            // Database page — retention limits, maintenance buttons, stats.
            database-page := DatabasePage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                visible: root.on-database-page;

                s-max-clips <=> root.s-max-clips;
                s-max-age-days <=> root.s-max-age-days;
                s-total-clips: root.s-total-clips;
                s-db-created: root.s-db-created;
                s-db-size: root.s-db-size;
                s-copies: root.s-copies;
                s-pastes: root.s-pastes;

                setting-changed(k, v) => {
                    root.setting-changed(k, v);
                }
                maintenance-action(key) => {
                    root.maintenance-action(key);
                }
            }
        }
    }

    // ── Accent swatch popup ─────────────────────────────────────────────
    // Opens near the accent row in the Appearance section (top-of-scroll
    // position). Closes on outside click (default close-policy) or after a
    // swatch selection.
    accent_popup := PopupWindow {
        x: 30px;
        y: 380px;
        Rectangle {
            border-radius: 8px;
            background: Theme.bg-header;
            border-width: 1px;
            border-color: Theme.border-subtle;
            GridLayout {
                padding: 10px;
                spacing: 6px;
                for swatch[idx] in root.accent-swatches: Rectangle {
                    row: Math.floor(idx / 8);
                    col: Math.mod(idx, 8);
                    width: 34px;
                    height: 34px;
                    border-radius: 6px;
                    background: swatch.color;
                    border-width: root.s-accent-color == swatch.color ? 2px : 1px;
                    border-color: root.s-accent-color == swatch.color ? Theme.fg-primary : Theme.border-subtle;

                    // Check mark on the selected swatch.
                    if root.s-accent-color == swatch.color: Image {
                        source: @image-url("icons/check-check.svg");
                        colorize: white;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.s-accent-color = swatch.color;
                            root.setting-changed("accent_color", swatch.hex);
                            accent_popup.close();
                        }
                    }
                }
            }
        }
    }

    // ── Toast notification overlay ─────────────────────────────────────
    ToastNotification {
        // Bounded width is required: an absolute instance has no layout to
        // stretch it, so without an explicit width it collapses (and long
        // messages would otherwise never wrap).
        width: Math.min(320px, root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
        dismissed => {
            root.toast-visible = false;
        }
    }
}
