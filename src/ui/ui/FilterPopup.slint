// FilterPopup.slint — Clip-type filter grid popup, anchored above the filter
// icon in the toolbar.

import { FilterGrid } from "FilterGrid.slint";
import { Theme }      from "Theme.slint";

export component FilterPopup {
    in-out property <string> active-filter: "all";
    // Anchoring dims provided by AppWindow.
    in property <length> window-width: 0px;
    in property <length> window-height: 0px;
    in property <length> toolbar-height: Theme.toolbar-height;
    in property <length> right-margin: 6px;

    // Read-only for AppWindow: reflects whether the popup is currently open.
    out property <bool> popup-open: popup.is-open;
    // Armed by show() just before popup.show(); the popup's focus-timer
    // consumes it once the key-handling scope has focus. Gives that scope
    // focus on every open so it receives keys (ESC to close).
    in-out property <bool> focus-armed: false;

    callback filter-chosen(string);

    // Called by AppWindow from the toolbar filter-icon click.
    public function show() {
        root.focus-armed = true;
        popup.show();
    }

    // Closes the popup. Called from AppWindow's close-all-popups when the
    // window blurs so the grid can't linger as its own top-level window after
    // the main window hides.
    public function close-all() {
        popup.close();
    }

    // Opens above the filter icon, right-aligned so its right edge nearly
    // touches the app window's right edge. Y is clamped to the window's top
    // edge so a very short window cannot push the popup off screen (Y would
    // otherwise go negative below ~220px window height).
    popup := PopupWindow {
        x: root.window-width - grid.grid-width - root.right-margin;
        y: Math.max(0px, root.window-height - root.toolbar-height - grid.grid-height);

        // Key handling scope: receives the keys the popup's focused window
        // delivers, so ESC closes the grid. The focus-timer below gives it
        // focus as soon as the popup is shown.
        esc-scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.close-all();
                    return accept;
                }
                reject
            }

            grid := FilterGrid {
                active-filter: root.active-filter;
                filter-chosen(f) => {
                    root.filter-chosen(f);
                    popup.close();
                }
            }
        }

        focus-timer := Timer {
            interval: 1ms;
            running: root.focus-armed;
            triggered() => {
                esc-scope.focus();
                root.focus-armed = false;
            }
        }
    }
}
