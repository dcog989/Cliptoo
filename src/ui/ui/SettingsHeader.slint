// SettingsHeader.slint — Top bar of the settings window.
// Page title ("Settings"; "Shortcuts" or "Database" on a sub-page, preceded by
// a Back button), plus the shortcut and Database icons that switch pages.

import { Theme } from "Theme.slint";

export component SettingsHeader {
    in-out property <bool> on-database-page: false;
    in-out property <bool> on-shortcuts-page: false;

    callback database-page-shown();

    // Tooltip text for the header icons (Tooltip.text is styled-text, so @tr
    // is bound here and interpolated through @markdown at the use site).
    private property <string> tip-database: @tr("Database: retention, maintenance, and statistics");
    private property <string> tip-shortcuts: @tr("Shortcuts: hotkeys and keyboard shortcuts");
    private property <string> tip-back: @tr("Back to settings");
    private property <bool> on-sub-page: root.on-database-page || root.on-shortcuts-page;
    private property <string> sub-page-title: root.on-database-page ? @tr("Database") : @tr("Shortcuts");

    function back() {
        root.on-database-page = false;
        root.on-shortcuts-page = false;
    }

    function toggle-shortcuts() {
        root.on-shortcuts-page = !root.on-shortcuts-page;
        if root.on-shortcuts-page {
            root.on-database-page = false;
        }
    }

    function toggle-database() {
        root.on-database-page = !root.on-database-page;
        if root.on-database-page {
            root.on-shortcuts-page = false;
            root.database-page-shown();
        }
    }

    height: 48px;

    Rectangle {
        background: Theme.bg-header;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;

            // Page title. On the settings page it is just "Settings"; a sub-page
            // adds a Back button before its own title.
            if !root.on-sub-page: Text {
                text: @tr("Settings");
                color: Theme.fg-primary;
                font-size: Theme.font-size + 1px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.on-sub-page: HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                cross-axis-alignment: center;

                // Back to settings
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: back-touch.has-hover || back-focus.has-focus ? Theme.bg-row-hover : Theme.bg-input;
                    border-width: 1px;
                    border-color: back-focus.has-focus ? Theme.accent-primary : back-touch.has-hover ? Theme.border-subtle : transparent;
                    animate background { duration: Theme.anim-fast; }
                    animate border-color { duration: Theme.anim-fast; }

                    back-focus := FocusScope {
                        accessible-role: button;
                        accessible-label: root.tip-back;
                        accessible-action-default => {
                            root.back();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.back();
                                accept
                            } else {
                                reject
                            }
                        }

                        Image {
                            source: @image-url("icons/arrow-left.svg");
                            colorize: Theme.fg-secondary;
                            width: 18px;
                            height: 18px;
                            x: (parent.width - 18px) / 2;
                            y: (parent.height - 18px) / 2;
                        }

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                back-focus.focus();
                                root.back();
                            }
                        }
                    }

                    Tooltip {
                        text: @markdown("\{root.tip-back}");
                    }
                }

                Text {
                    text: root.sub-page-title;
                    color: Theme.fg-primary;
                    font-size: Theme.font-size + 1px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // Shortcuts icon — opens the Shortcuts page, closes it again when
            // already there. Mutually exclusive with the Database page.
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                property <bool> hot: shortcuts-touch.has-hover && !root.on-shortcuts-page;
                background: root.on-shortcuts-page ? Theme.accent-fill : hot || shortcuts-focus.has-focus ? Theme.bg-row-hover : Theme.bg-input;
                border-width: 1px;
                border-color: shortcuts-focus.has-focus ? Theme.accent-primary : hot ? Theme.border-subtle : transparent;
                animate background { duration: Theme.anim-fast; }
                animate border-color { duration: Theme.anim-fast; }

                shortcuts-focus := FocusScope {
                    accessible-role: button;
                    accessible-checkable: true;
                    accessible-checked: root.on-shortcuts-page;
                    accessible-label: root.tip-shortcuts;
                    accessible-action-default => {
                        root.toggle-shortcuts();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            root.toggle-shortcuts();
                            accept
                        } else {
                            reject
                        }
                    }

                    Image {
                        source: @image-url("icons/keyboard.svg");
                        colorize: root.on-shortcuts-page ? Theme.accent-fg : Theme.fg-secondary;
                        width: 20px;
                        height: 20px;
                        x: 6px;
                        y: 6px;
                    }

                    shortcuts-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            shortcuts-focus.focus();
                            root.toggle-shortcuts();
                        }
                    }
                }

                Tooltip {
                    text: @markdown("\{root.tip-shortcuts}");
                }
            }

            // Database icon — opens the Database page on the settings page,
            // acts as a toggle back from the Database page itself.
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                property <bool> hot: database-touch.has-hover && !root.on-database-page;
                background: root.on-database-page ? Theme.accent-fill : hot || database-focus.has-focus ? Theme.bg-row-hover : Theme.bg-input;
                border-width: 1px;
                border-color: database-focus.has-focus ? Theme.accent-primary : hot ? Theme.border-subtle : transparent;
                animate background { duration: Theme.anim-fast; }
                animate border-color { duration: Theme.anim-fast; }

                database-focus := FocusScope {
                    accessible-role: button;
                    accessible-checkable: true;
                    accessible-checked: root.on-database-page;
                    accessible-label: root.tip-database;
                    accessible-action-default => {
                        root.toggle-database();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            root.toggle-database();
                            accept
                        } else {
                            reject
                        }
                    }

                    Image {
                        source: @image-url("icons/database.svg");
                        colorize: root.on-database-page ? Theme.accent-fg : Theme.fg-secondary;
                        width: 20px;
                        height: 20px;
                        x: 6px;
                        y: 6px;
                    }

                    database-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            database-focus.focus();
                            root.toggle-database();
                        }
                    }
                }

                Tooltip {
                    text: @markdown("\{root.tip-database}");
                }
            }
        }
    }
}
