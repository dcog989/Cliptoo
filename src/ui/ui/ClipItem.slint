// ClipItem.slint — Individual row in the clip list.
//
// Layout:
//   [1]                   clip content + [bookmark]              [3]
//
// Column 1: thumbnail / type icon (18×18, 4px margins = 26px column)
// Column 2: leading-whitespace indicator + content snippet + bookmark icon
// Column 3: multiline indicator (18×18, 4px margins = 26px column)

import { Theme } from "Theme.slint";
import { ClipData } from "ClipData.slint";
import { ClipTypeMap } from "ClipTypes.slint";

export component ClipItem {
    in property <ClipData> clip-data;
    in property <bool> is-selected:        false;
    in property <bool> is-alt-row:         false;
    in property <int> row-index:          0;
    in property <bool> quick-paste-active: false;
    in property <int> quick-paste-slots: 9;
    in property <bool> is-searching:       false;
    // True while a menu/child window is open. Ends the hover session without
    // dismissing: the popup handler already hid the preview, and a delayed
    // hover request or exit must not race a menu "Preview" action.
    in property <bool> popup-open:         false;

    // A popup takes the pointer, so the row would otherwise keep its hover
    // latch armed and fire a stale exit (and a dismiss) the instant the popup
    // closes — after a menu "Preview" request has already started.
    changed popup-open => {
        if (root.popup-open) {
            root.preview-triggered = false;
        }
    }

    callback activated(bool, bool);  // ctrl, shift held on the click
    callback right-clicked(float, float);
    callback hovered(float, float);  // mouse-x, mouse-y in logical px relative to this row
    callback hover-exited;

    // True after the preview timer fires; reset when the cursor leaves the row.
    // Prevents the Timer from re-firing every 300 ms while the hover continues.
    property <bool> preview-triggered: false;

    // Modifiers captured on mouse-down; `clicked` carries no event argument.
    property <bool> click-ctrl: false;
    property <bool> click-shift: false;

    // Base body-text colour, before the deadhead/match overrides below. When
    // clip-type color coding is on, each type uses its own colour; plain text
    // keeps the list base colour. Hover bumps saturation and raises value in
    // dark mode / lowers it in light mode, adding emphasis without washing out
    // the hue.
    private property <color> body-base-color:
        Theme.color-code-clip-types ? ClipTypeMap.color-for(clip-data.clip-type) : Theme.fg-clip-list;
    private property <color> body-hover-color:
        hsv(
            root.body-base-color.to-hsv().hue,
            min(1.0, root.body-base-color.to-hsv().saturation * 1.5),
            Theme.dark
        ? min(1.0, root.body-base-color.to-hsv().value * 1.3)
        : root.body-base-color.to-hsv().value / 1.3,
        );
    private property <brush> body-color:
        touch.has-hover ? root.body-hover-color : root.body-base-color;

    height: Theme.row-height;

    // Row surface geometry: inset from the list edges so the highlight reads as
    // a row, not an app-wide bar.
    private property <length> highlight-inset: 8px;
    private property <length> highlight-radius: 4px;

    Rectangle {
        height: 100%;
        width: 100%;
        accessible-role: list-item;
        accessible-label: clip-data.preview-content;
        // Type plus the state that is otherwise only shown with an icon or
        // strikethrough: bookmarked, multiline, and a file path that no longer
        // exists on disk.
        accessible-description: ClipTypeMap.label-for(clip-data.clip-type)
            + (clip-data.is-bookmarked ? @tr(", bookmarked") : "")
            + (clip-data.is-multiline ? @tr(", multiline") : "")
            + (clip-data.is-deadhead ? @tr(", file missing") : "");
        accessible-item-index: root.row-index;
        accessible-item-selectable: true;
        accessible-item-selected: root.is-selected;
        accessible-action-default => { root.activated(false, false); }

        // Keyboard selection gets the accent-tinted selection surface plus a
        // dim accent border; pointer hover adds only a surface tint, so it
        // never reads as the row Enter will activate.
        Rectangle {
            x: root.highlight-inset;
            y: 1px;
            width: parent.width - root.highlight-inset - root.highlight-inset;
            height: parent.height - 2px;
            border-radius: root.highlight-radius;
            border-width: is-selected ? 1px : 0px;
            border-color: Theme.border-accent;
            background: is-selected
                ? Theme.bg-row-selected
                : touch.has-hover
                ? Theme.bg-row-hover
                : is-alt-row
                ? Theme.bg-row-alt
                : Theme.bg-primary;

            animate background { duration: Theme.anim-fast; }
        }

        HorizontalLayout {
            padding-left: 10px;
            // Mirrors the left icon's 14px gap from the row edge, so the
            // multiline icon does not sit against the highlight's right edge.
            padding-right: 10px;
            spacing: 6px;

            // ── Column 1: type icon ──────────────────────────────────────
            Rectangle {
                width: 26px;
                Rectangle {
                    x: 4px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;

                    // Quick-paste numbered overlay (digits 1–9)
                    if root.quick-paste-active && root.row-index < root.quick-paste-slots: Rectangle {
                        border-radius: 10px;
                        background: Theme.accent-fill;
                        width: 100%;
                        height: 100%;
                        Text {
                            text: "\{root.row-index + 1}";
                            color: Theme.accent-fg;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if !root.quick-paste-active: Rectangle {
                        width: 100%;
                        height: 100%;

                        // Color swatch — background bound to the parsed clip colour
                        // (populated in thumbnail_cache::convert via ColorParser).
                        if clip-data.clip-type == "color": Rectangle {
                            border-radius: 3px;
                            width: 100%;
                            height: 100%;
                            background: clip-data.clip-color;
                        }

                        // Image thumbnail (covers the cell); the generic image
                        // icon stands in while no thumbnail is cached (e.g. a
                        // multi-image selection, or generation still running).
                        if clip-data.clip-type == "file_image" && clip-data.thumbnail-image.width != 0: Rectangle {
                            border-radius: 3px;
                            clip: true;
                            width: 100%;
                            height: 100%;
                            Image {
                                source: clip-data.thumbnail-image;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }
                        }
                        if clip-data.clip-type == "file_image" && clip-data.thumbnail-image.width == 0: Image {
                            source: ClipTypeMap.icon-for("file_image");
                            colorize: touch.has-hover ? Theme.fg-clip-list : Theme.fg-muted;
                            width: 100%;
                            height: 100%;
                        }

                        // Favicon thumbnail for link clips (replaces link icon when cached)
                        if clip-data.clip-type == "link" && clip-data.favicon-image.width != 0: Rectangle {
                            border-radius: 3px;
                            clip: true;
                            width: 100%;
                            height: 100%;
                            Image {
                                source: clip-data.favicon-image;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }
                        // Generic link icon fallback (shown when no favicon cached)
                        if clip-data.clip-type == "link" && clip-data.favicon-image.width == 0: Image {
                            source: @image-url("icons/link.svg");
                            colorize: touch.has-hover ? Theme.fg-clip-list : Theme.fg-muted;
                            width: 100%;
                            height: 100%;
                        }

                        // SVG source thumbnail (rasterised at ingest) — shown in
                        // place of the generic type icon for text/code clips.
                        if clip-data.clip-type != "color" && clip-data.clip-type != "file_image" && clip-data.clip-type != "link" && clip-data.thumbnail-image.width != 0: Rectangle {
                            border-radius: 3px;
                            clip: true;
                            width: 100%;
                            height: 100%;
                            Image {
                                source: clip-data.thumbnail-image;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }

                        // Type icon for every other ClipType. The icon mapping
                        // lives in ClipTypeMap.icon-for (single source of truth);
                        // unknown/future ClipTypes degrade to the file icon there.
                        if clip-data.clip-type != "color" && clip-data.clip-type != "file_image" && clip-data.clip-type != "link" && clip-data.thumbnail-image.width == 0: Image {
                            source: ClipTypeMap.icon-for(clip-data.clip-type);
                            colorize: touch.has-hover ? Theme.fg-clip-list : Theme.fg-muted;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            // ── Column 2: leading-whitespace + content snippet + bookmark ─────────
            text-col := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // Text geometry shared by the plain, strikethrough and
                // highlighted-span paths, so all three reserve the same slots.
                property <length> text-x: clip-data.has-leading-whitespace ? 22px : 0px;
                property <length> text-width: text-col.width - text-col.text-x - (clip-data.is-bookmarked ? 22px : 0px);

                // Leading whitespace indicator
                if clip-data.has-leading-whitespace: Image {
                    x: 0px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/space.svg");
                    colorize: touch.has-hover ? Theme.fg-clip-list : Theme.fg-muted;
                }

                // Plain text (not searching, or no match-context available)
                // Width leaves room for bookmark icon when bookmarked.
                // Declared unconditionally (hidden, not conditional) so the
                // hover-preview gate below can compare its preferred width
                // against its laid-out width to detect elision.
                preview-text := Text {
                    visible: !root.is-searching || clip-data.match-context == "";
                    x: text-col.text-x;
                    width: text-col.text-width;
                    height: 100%;
                    text: clip-data.preview-content;
                    font-family: Theme.font-family;
                    overflow: elide;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: clip-data.is-deadhead ? Theme.fg-muted : root.body-color;
                    font-size: Theme.clip-list-font-size;
                }

                // Strikethrough overlay for deadhead file clips
                if clip-data.is-deadhead && (!root.is-searching || clip-data.match-context == ""): Rectangle {
                    x: text-col.text-x;
                    width: text-col.text-width;
                    y: (parent.height / 2) - 0.5px;
                    height: 1px;
                    background: Theme.fg-muted;
                    opacity: 0.6;
                }

                // Highlighted spans (searching with FTS5 match-context)
                // Wrapped in a clipped Rectangle so overflowing spans are cut
                // at the row's reserved width: with `overflow: clip` the span
                // Text's min-width stays at its full intrinsic width, so the
                // layout cannot squeeze it and would otherwise bleed past the
                // bookmark icon's reserved zone and overlap the icon.
                if root.is-searching && clip-data.match-context != "": Rectangle {
                    x: text-col.text-x;
                    width: text-col.text-width;
                    height: 100%;
                    clip: true;
                    HorizontalLayout {
                        height: 100%;
                        alignment: start;
                        spacing: 0px;
                        for span in clip-data.match-spans: Text {
                            text: span.text;
                            font-family: Theme.font-family;
                            // `clip` (not `elide`): eliding each span independently
                            // collapses squeezed spans to a "…" glyph — which, for a
                            // highlighted match, renders a highlighted "…". The row
                            // container clips the overflow once at the right edge.
                            overflow: clip;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            color: span.is-highlight ? Theme.match-highlight : root.body-color;
                            font-weight: span.is-highlight ? 700 : 400;
                            font-size: Theme.clip-list-font-size;
                        }
                    }
                }

                // Bookmark icon — printed at the right end of column 2, right
                // after the clip text. Always the bookmark colour, so it reads
                // as a bookmark regardless of the clip's type colour.
                if clip-data.is-bookmarked: Image {
                    source: @image-url("icons/bookmark.svg");
                    colorize: Theme.fg-bookmarked;
                    x: text-col.width - 18px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                }
            }

            // ── Column 3: multiline indicator ────────────────────────────────
            Rectangle {
                width: 26px;
                height: 100%;
                opacity: clip-data.is-multiline ? 1.0 : 0.0;
                Image {
                    source: @image-url("icons/text-wrap.svg");
                    colorize: touch.has-hover ? Theme.fg-clip-list : Theme.fg-muted;
                    x: 4px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    opacity: 0.7;
                }
            }
        }

        // Interaction
        touch := TouchArea {
            clicked => {
                root.activated(root.click-ctrl, root.click-shift);
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    if e.button == PointerEventButton.right {
                        root.right-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
                    } else if e.button == PointerEventButton.left {
                        root.click-ctrl = e.modifiers.control;
                        root.click-shift = e.modifiers.shift;
                    }
                }
            }
            mouse-cursor: pointer;
        }

        // A single-line plain-text-like clip whose row already shows the whole
        // string gets no hover preview: the preview would only repeat the row.
        // Elided text, truncated content (the row only has a 200-byte preview,
        // however well it fits), multiline content, search-highlight rows and
        // richer clip types keep theirs. `preferred-width` stays the full
        // one-line text width even with `overflow: elide`, so comparing it to
        // the laid-out width detects elision.
        private property <bool> preview-offered:
            clip-data.is-multiline
            || !ClipTypeMap.is-plain-text-like(clip-data.clip-type)
            || (root.is-searching && clip-data.match-context != "")
            || clip-data.preview-truncated
            || preview-text.preferred-width > preview-text.width;

        // Fires once, after hover-preview-delay. The latch prevents re-firing
        // on subsequent ticks while the cursor stays on the row. A popup menu
        // owns the pointer, so no hover preview is requested over it.
        Timer {
            interval: Theme.hover-preview-delay;
            running: touch.has-hover && !root.preview-triggered && !root.popup-open && preview-offered && Theme.hover-preview-delay > 0ms;
            triggered => {
                root.preview-triggered = true;
                root.hovered(touch.mouse-x / 1px, touch.mouse-y / 1px);
            }
        }

        // Dismiss as soon as the cursor leaves. Runs at 16 ms so the tooltip
        // disappears on the next frame after hover ends. Only active while the
        // preview is showing (latch is set) and the cursor is gone.
        // Note: the latch (preview-triggered = false) disarms `running` on the
        // same tick the timer fires, so this fires exactly once per hover exit.
        // Re-arming would only occur if has-hover rose again before the next
        // evaluation — impossible here because PreviewTooltip has no TouchArea.
        Timer {
            interval: 16ms;
            running: !touch.has-hover && root.preview-triggered;
            triggered => {
                root.preview-triggered = false;
                root.hover-exited();
            }
        }
    }
}
