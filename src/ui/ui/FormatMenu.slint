// FormatMenu.slint — The "Format" submenu popup for text clips.
// A separate PopupWindow (hosted by ContextMenuHost) so each menu is sized
// from fully-visible content at open time, avoiding the reactive re-sizing of
// a shown popup when its content is toggled between sub-views.

import { Theme } from "Theme.slint";
import { MenuRow, MenuSeparator } from "MenuRow.slint";

export component FormatMenu {
    callback back();
    callback format(string);        // transform key

    // Keyboard selection: index of the highlighted row, -1 until the first
    // arrow key. Back is 0; the transform rows follow in `transform-keys` order.
    in-out property <int> selected: -1;
    property <[string]> transform-keys: [
        "upper",
        "lower",
        "capitalize",
        "sentence",
        "invert",
        "kebab",
        "snake",
        "camel",
        "deslug",
        "trim",
        "remove_lf",
        "lf1",
        "timestamp",
    ];
    // Separators are not counted.
    property <int> row-count: 1 + root.transform-keys.length;

    // Wrap around so Down at the last row lands on the first.
    public function move-selection(delta: int) {
        let next = root.selected + delta;
        if (next < 0) {
            root.selected = root.row-count - 1;
        } else if (next >= root.row-count) {
            root.selected = 0;
        } else {
            root.selected = next;
        }
    }

    public function select-first() {
        root.selected = 0;
    }

    public function select-last() {
        root.selected = root.row-count - 1;
    }

    // Enter: run the highlighted row's action.
    public function activate-selected() {
        if (root.selected == 0) {
            root.back();
        } else if (root.selected > 0 && root.selected <= root.transform-keys.length) {
            root.format(root.transform-keys[root.selected - 1]);
        }
    }

    // Intrinsic popup size used by ContextMenuHost. All rows are unconditional
    // so the height is a fixed count; the width comes from the widest label.
    out property <length> menu-width: menu-root.preferred-width;
    out property <length> menu-height: menu-root.preferred-height;

    menu-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            alignment: start;
            padding: 4px;
            spacing: 0px;

            MenuRow {
                label: @tr("Back");
                icon: @image-url("icons/arrow-left.svg");
                selected: root.selected == 0;
                clicked => {
                    root.back();
                }
            }

            MenuSeparator { }

            MenuRow {
                label: @tr("UPPER CASE");
                icon: @image-url("icons/case-upper.svg");
                selected: root.selected == 1;
                clicked => {
                    root.format("upper");
                }
            }

            MenuRow {
                label: @tr("lower case");
                icon: @image-url("icons/case-lower.svg");
                selected: root.selected == 2;
                clicked => {
                    root.format("lower");
                }
            }

            MenuRow {
                label: @tr("Capitalize Words");
                icon: @image-url("icons/case-sensitive.svg");
                selected: root.selected == 3;
                clicked => {
                    root.format("capitalize");
                }
            }

            MenuRow {
                label: @tr("Sentence case");
                icon: @image-url("icons/case-sensitive.svg");
                selected: root.selected == 4;
                clicked => {
                    root.format("sentence");
                }
            }

            MenuRow {
                label: @tr("iNVERT cASE");
                icon: @image-url("icons/case-sensitive.svg");
                selected: root.selected == 5;
                clicked => {
                    root.format("invert");
                }
            }

            MenuSeparator { }

            MenuRow {
                label: @tr("kebab-case");
                icon: @image-url("icons/text.svg");
                selected: root.selected == 6;
                clicked => {
                    root.format("kebab");
                }
            }

            MenuRow {
                label: @tr("snake_case");
                icon: @image-url("icons/text.svg");
                selected: root.selected == 7;
                clicked => {
                    root.format("snake");
                }
            }

            MenuRow {
                label: @tr("camelCase");
                icon: @image-url("icons/text.svg");
                selected: root.selected == 8;
                clicked => {
                    root.format("camel");
                }
            }

            MenuRow {
                label: @tr("De-slug");
                icon: @image-url("icons/text.svg");
                selected: root.selected == 9;
                clicked => {
                    root.format("deslug");
                }
            }

            MenuSeparator { }

            MenuRow {
                label: @tr("Trim Whitespace");
                icon: @image-url("icons/scissors.svg");
                selected: root.selected == 10;
                clicked => {
                    root.format("trim");
                }
            }

            MenuRow {
                label: @tr("Remove Line Breaks");
                icon: @image-url("icons/text-wrap.svg");
                selected: root.selected == 11;
                clicked => {
                    root.format("remove_lf");
                }
            }

            MenuRow {
                label: @tr("Normalize LF");
                icon: @image-url("icons/text-wrap.svg");
                selected: root.selected == 12;
                clicked => {
                    root.format("lf1");
                }
            }

            MenuRow {
                label: @tr("Add Timestamp");
                icon: @image-url("icons/clock.svg");
                selected: root.selected == 13;
                clicked => {
                    root.format("timestamp");
                }
            }
        }
    }
}
