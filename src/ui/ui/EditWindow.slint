// EditWindow.slint — Modal clip editor.
// Opens on right-click → "Edit / Tags". See product spec §3.4.
// Window size is persisted in Settings (editor_window_width/height).
// Position is computed relative to the main AppWindow on open.
// Supports syntax-highlighted view mode for code_snippet clips.

import { Theme } from "Theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ToastNotification } from "ToastNotification.slint";

export component EditWindow inherits Window {
    title: @tr("Edit Clip");
    width: 520px;
    height: 420px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in property <int> clip-id: 0;
    in-out property <string> edit-content: "";
    in property <string> initial-tags: "";
    in property <string> clip-type: "text";
    in property <string> meta-info: "";   // "1.4 KB · 320 chars" etc.
    in property <bool> editing: true;
    // True once the user edits content or tags after opening. Drives the
    // two-step Cancel button: the first click re-arms it as "Discard?" so
    // unsaved edits are not lost silently.
    in-out property <bool> dirty: false;
    // Armed by the first Cancel/close while `dirty`; while set, the Cancel
    // button reads "Discard?" and the next click actually closes.
    in-out property <bool> confirm-cancel: false;

    // Error feedback for a failed save; driven from Rust so the window stays
    // open with an explanatory message instead of closing silently.
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-message: "";
    in-out property <string> toast-severity: "info";

    callback save-clicked(int, string, string);   // id, content, tags
    callback cancel-clicked;
    callback toggle-mode;

    // ESC and the Cancel button share the two-step discard guard: the first
    // press/click arms "Discard?" when there are unsaved edits, the second
    // actually cancels.
    public function request-cancel() {
        if (root.dirty && !root.confirm-cancel) {
            root.confirm-cancel = true;
        } else {
            root.cancel-clicked();
        }
    }

    // Keyboard focus scope: ESC closes through the same guard as Cancel. The
    // whole content lives inside so a focused TextInput's rejected keys bubble
    // up to it, mirroring the About/Settings windows.
    forward-focus: editor-focus;
    editor-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.request-cancel();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // Metadata bar + toggle button
        HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.meta-info;
                    color: Theme.fg-muted;
                    font-size: Theme.font-size - 1px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Toggle between highlighted view and edit mode
            Rectangle {
                    visible: root.clip-type == "code_snippet" || root.clip-type == "file_dev";
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: root.editing ? Theme.accent-primary : Theme.bg-input;
                    TouchArea {
                        clicked => {
                            root.toggle-mode();
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: root.editing ? "</>" : "✎";
                        color: root.editing ? Theme.accent-fg : Theme.fg-primary;
                        font-size: Theme.font-size - 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Content editor — dual mode
        Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.border-radius;
                border-width: 1px;
                border-color: root.editing ? Theme.border-subtle : transparent;
                background: root.editing ? Theme.bg-input : transparent;
                clip: true;

                // Edit mode: plain text input. Wrapped in a ScrollView so a long
            // document scrolls instead of growing the layout and pushing the
            // tags row and action buttons out of the window (a bare TextInput's
            // minimum height is the full height of its content).
            edit-scroll := ScrollView {
                    visible: root.editing;
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, content-edit.preferred-height);

                    content-edit := TextInput {
                        text <=> root.edit-content;
                        font-family: Theme.font-family;
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        single-line: false;
                        wrap: word-wrap;
                        page-height: edit-scroll.visible-height;
                        edited => {
                            root.dirty = true;
                            root.confirm-cancel = false;
                        }
                    }
                }

                // View mode: monospace read-only text
            preview-scroll := ScrollView {
                    visible: !root.editing;
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    Text {
                        width: parent.width - 16px;
                        text: root.edit-content;
                        color: Theme.fg-primary;
                        font-family: "monospace";
                        font-size: Theme.font-size;
                        wrap: no-wrap;
                    }
                }
            }

            // Tags input
        HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: @tr("Tags:");
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    border-radius: Theme.border-radius;
                    border-width: 1px;
                    border-color: tags-edit.has-focus ? Theme.accent-primary : Theme.border-accent;
                    background: Theme.bg-input;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        tags-edit := TextInput {
                        // One-way initialisation: binding breaks on first user edit, which
                        // is the desired behaviour. Rust must NOT mutate initial-tags after
                        // the window opens, or the field will re-sync and discard user input.
                        text: root.initial-tags;
                            color: Theme.fg-primary;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            edited => {
                                root.dirty = true;
                                root.confirm-cancel = false;
                            }
                        }
                    }
                }
            }

            // Action buttons
        HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Cancel — two-step when there are unsaved edits: the first click
            // re-arms the button as "Discard?" so edits are not lost silently,
            // the second actually closes.
            Rectangle {
                    width: 80px;
                    height: 30px;
                    border-radius: 6px;
                    background: root.confirm-cancel ? Theme.error-base : Theme.bg-input;
                    Text {
                        text: root.confirm-cancel ? @tr("Discard?") : @tr("Cancel");
                        color: root.confirm-cancel ? Theme.error-fg : Theme.fg-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.font-size;
                    }

                    TouchArea {
                        clicked => {
                            root.request-cancel();
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Save
            Rectangle {
                    width: 80px;
                    height: 30px;
                    border-radius: 6px;
                    background: Theme.accent-primary;
                    Text {
                        text: @tr("Save");
                        color: Theme.accent-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.font-size;
                    }

                    TouchArea {
                        clicked => {
                            root.save-clicked(
                            root.clip-id,
                            content-edit.text,
                            tags-edit.text);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Error toast for a failed save; floats above the action buttons so it is
    // visible while the window stays open.
    ToastNotification {
        width: Math.min(320px, root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.height - 70px - self.height;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
        dismissed => {
            root.toast-visible = false;
        }
    }
}
