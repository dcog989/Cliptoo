// EditWindow.slint — Modal clip editor.
// Opens on right-click → "Edit / Tags". See product spec §3.4.
// Window size is persisted in Settings (editor_window_width/height).
// Position is computed relative to the main AppWindow on open.
// Supports syntax-highlighted view mode for code_snippet clips.

import { Theme } from "Theme.slint";
import { InputBox } from "InputBox.slint";
import { ScrollView } from "std-widgets.slint";
import { ToastHost } from "ToastNotification.slint";

export component EditWindow inherits Window {
    title: @tr("Edit Clip");
    preferred-width: 520px;
    preferred-height: 420px;
    min-width: 360px;
    min-height: 300px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in property <int> clip-id: 0;
    in-out property <string> edit-content: "";
    // Two-way: Rust writes the clip's tags before every open, and the user's
    // edits write back. A one-way init would be broken by the first edit and
    // then leak the previous clip's tags into the next one.
    in-out property <string> initial-tags: "";
    in property <string> clip-type: "text";
    in property <string> meta-info: "";   // "1.4 KB · 320 chars" etc.
    in property <bool> editing: true;
    // True once the user edits content or tags after opening. Drives the
    // two-step Cancel button: the first click re-arms it as "Discard?" so
    // unsaved edits are not lost silently.
    in-out property <bool> dirty: false;
    // Armed by the first Cancel/close while `dirty`; while set, the Cancel
    // button reads "Discard?" and the next click actually closes.
    in-out property <bool> confirm-cancel: false;

    // Error feedback for a failed save; driven from Rust so the window stays
    // open with an explanatory message instead of closing silently.
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-message: "";
    in-out property <string> toast-severity: "info";

    callback save-clicked(int, string, string);   // id, content, tags
    callback cancel-clicked;
    callback toggle-mode;

    // ESC and the Cancel button share the two-step discard guard: the first
    // press/click arms "Discard?" when there are unsaved edits, the second
    // actually cancels.
    public function request-cancel() {
        if (root.dirty && !root.confirm-cancel) {
            root.confirm-cancel = true;
        } else {
            root.cancel-clicked();
        }
    }

    function save() {
        root.save-clicked(
            root.clip-id,
            content-edit.text,
            tags-edit.text);
    }

    // Keyboard focus scope: ESC closes through the same guard as Cancel. The
    // whole content lives inside so a focused TextInput's rejected keys bubble
    // up to it, mirroring the About/Settings windows.
    forward-focus: editor-focus;
    editor-focus := FocusScope {
        // Focused programmatically on open; an invisible Tab stop adds nothing.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.request-cancel();
                accept
            } else if (event.modifiers.control
                && (event.text.to-lowercase() == "s" || event.text == Key.Return)) {
                // Save from anywhere in the editor: the Save button is a click
                // target, so the keyboard needs its own path.
                root.save();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // Metadata bar + toggle button
        HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.meta-info;
                    color: Theme.fg-muted;
                    font-size: Theme.font-size - 1px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Toggle between highlighted view and edit mode
            Rectangle {
                    visible: root.clip-type == "code_snippet" || root.clip-type == "file_dev";
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    border-width: toggle-focus.has-focus ? 1px : 0px;
                    border-color: Theme.accent-primary;
                    background: root.editing ? Theme.accent-fill : Theme.bg-input;
                    accessible-role: button;
                    accessible-label: @tr("Toggle code preview");
                    accessible-action-default => {
                        root.toggle-mode();
                    }

                    toggle-focus := FocusScope {
                        visible: root.clip-type == "code_snippet" || root.clip-type == "file_dev";
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.toggle-mode();
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            toggle-focus.focus();
                            root.toggle-mode();
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: root.editing ? "</>" : "✎";
                        color: root.editing ? Theme.accent-fg : Theme.fg-primary;
                        font-size: Theme.font-size - 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Content editor — dual mode
        InputBox {
                vertical-stretch: 1;
                border-radius: Theme.border-radius;
                bordered: root.editing;
                background: root.editing ? Theme.bg-input : transparent;
                clip: true;
                hot: content-edit.has-focus;

                // Edit mode: plain text input. Wrapped in a ScrollView so a long
                // document scrolls instead of growing the layout and pushing the
                // tags row and action buttons out of the window (a bare TextInput's
                // minimum height is the full height of its content).
                VerticalLayout {
                    padding: 8px;
                    visible: root.editing;

                    edit-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, content-edit.preferred-height);

                        content-edit := TextInput {
                            text <=> root.edit-content;
                            font-family: Theme.font-family;
                            color: Theme.fg-primary;
                            font-size: Theme.font-size;
                            single-line: false;
                            wrap: word-wrap;
                            page-height: edit-scroll.visible-height;
                            accessible-label: @tr("Clip content");
                            edited => {
                                root.dirty = true;
                                root.confirm-cancel = false;
                            }
                        }
                    }
                }

                // View mode: monospace read-only text
                VerticalLayout {
                    visible: !root.editing;

                    preview-scroll := ScrollView {
                        vertical-stretch: 1;
                        Text {
                            width: parent.width - 16px;
                            text: root.edit-content;
                            color: Theme.fg-primary;
                            font-family: "monospace";
                            font-size: Theme.font-size;
                            wrap: no-wrap;
                        }
                    }
                }
            }

            // Tags input
        HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: @tr("Tags:");
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                InputBox {
                    horizontal-stretch: 1;
                    height: 32px;
                    border-radius: Theme.border-radius;
                    clip: true;
                    hot: tags-edit.has-focus;
                    hover: tags-touch.has-hover;
                    tags-touch := TouchArea {
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            tags-edit := TextInput {
                            // Two-way: Rust seeds it before each open; user edits write back.
                            // Rust must NOT mutate initial-tags while the window is open.
                            text <=> root.initial-tags;
                                color: Theme.fg-primary;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                                accessible-label: @tr("Tags");
                                edited => {
                                    root.dirty = true;
                                    root.confirm-cancel = false;
                                }
                                accepted => {
                                    root.save-clicked(
                                        root.clip-id,
                                        content-edit.text,
                                        tags-edit.text);
                                }
                            }
                        }
                    }
                }
            }

            // Action buttons
        HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Cancel — two-step when there are unsaved edits: the first click
            // re-arms the button as "Discard?" so edits are not lost silently,
            // the second actually closes.
            Rectangle {
                    width: 80px;
                    height: 30px;
                    border-radius: 6px;
                    border-width: cancel-focus.has-focus ? 1px : 0px;
                    border-color: Theme.accent-primary;
                    background: root.confirm-cancel ? Theme.danger-bg : Theme.bg-input;
                    accessible-role: button;
                    accessible-label: root.confirm-cancel ? @tr("Discard") : @tr("Cancel");
                    accessible-action-default => {
                        root.request-cancel();
                    }

                    cancel-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.request-cancel();
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    Text {
                        text: root.confirm-cancel ? @tr("Discard?") : @tr("Cancel");
                        color: root.confirm-cancel ? Theme.danger-on-bg : Theme.fg-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.font-size;
                    }

                    TouchArea {
                        clicked => {
                            cancel-focus.focus();
                            root.request-cancel();
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Save
            Rectangle {
                    width: 80px;
                    height: 30px;
                    border-radius: 6px;
                    // Accent ring on an accent fill is invisible; the save
                    // button uses the primary foreground for its focus ring.
                    border-width: save-focus.has-focus ? 1px : 0px;
                    border-color: Theme.fg-primary;
                    background: Theme.accent-fill;
                    accessible-role: button;
                    accessible-label: @tr("Save");
                    accessible-action-default => {
                        root.save();
                    }

                    save-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.save();
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    Text {
                        text: @tr("Save");
                        color: Theme.accent-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.font-size;
                    }

                    TouchArea {
                        clicked => {
                            save-focus.focus();
                            root.save();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Error toast for a failed save; floats above the action buttons so it is
    // visible while the window stays open.
    ToastHost {
        bottom-offset: 70px;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
    }
}
