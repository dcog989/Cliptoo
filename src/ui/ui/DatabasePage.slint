// DatabasePage.slint — Settings > Database page: retention limits,
// maintenance buttons, and read-only statistics.

import { Theme } from "Theme.slint";
import { SettingsValues } from "SettingsValues.slint";
import { IntRow, SectionHeader } from "SettingsComponents.slint";
import { ScrollView } from "std-widgets.slint";

export component DatabasePage inherits ScrollView {
    callback setting-changed(string, string);
    callback maintenance-action(string);

    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 24px;
        spacing: 6px;
        alignment: start;

        SectionHeader {
            text: @tr("Retention");
            top-margin: 0px;
        }

        IntRow {
            label: @tr("Max clips");
            tooltip-text: @tr("Maximum number of non-bookmarked clips kept in history, 0 = keep all (the list shows up to 1000)");
            value <=> SettingsValues.s-max-clips;
            min-val: 0;
            max-val: 1000;
            step: 100;
            committed(v) => {
                root.setting-changed("max_clips", "\{v}");
            }
        }

        IntRow {
            label: @tr("Max age (days)");
            tooltip-text: @tr("Automatically remove clips older than this many days. 0 = keep forever");
            value <=> SettingsValues.s-max-age-days;
            min-val: 0;
            max-val: 3650;
            step: 5;
            committed(v) => {
                root.setting-changed("max_age_days", "\{v}");
            }
        }

        SectionHeader {
            text: @tr("Maintenance");
        }

        GridLayout {
            spacing: 8px;
            for action[idx] in [
                {
                    key: "clear-history",
                    label: @tr("Clear History"),
                    tip: @tr("Delete all clips from the clipboard history")
                },
                {
                    key: "clear-caches",
                    label: @tr("Clear Caches"),
                    tip: @tr("Clear cached previews, thumbnails, and favicons")
                },
                {
                    key: "deadhead",
                    label: @tr("Deadhead"),
                    tip: @tr("Remove clips referencing files that no longer exist on disk")
                },
                {
                    key: "reclassify",
                    label: @tr("Reclassify All"),
                    tip: @tr("Re-run content detection on every clip")
                },
                {
                    key: "compact",
                    label: @tr("Compact Database"),
                    tip: @tr("Rebuild the database file to reclaim space freed by deleted clips")
                },
                {
                    key: "export",
                    label: @tr("Export All Clips"),
                    tip: @tr("Save all clips to a JSON file")
                },
                {
                    key: "export-bookmarks",
                    label: @tr("Export Bookmarks"),
                    tip: @tr("Save only bookmarked clips to a JSON file")
                },
                {
                    key: "import",
                    label: @tr("Import Backup"),
                    tip: @tr("Load clips from a JSON backup file")
                },
            ]: Rectangle {
                row: Math.floor(idx / 2);
                col: Math.mod(idx, 2);
                height: 30px;
                border-radius: 6px;
                // Hover lift matches MenuRow: an accent-tinted surface with an
                // accent outline; the destructive action keeps its danger fill
                // and takes the pale danger outline instead.
                property <bool> hot: action-touch.has-hover;
                property <bool> danger: action.key == "clear-history";
                border-width: 1px;
                border-color: hot
                    ? (danger ? Theme.danger-on-bg : Theme.accent-primary)
                    : transparent;
                background: danger
                    ? Theme.danger-bg
                    : hot
                    ? Theme.bg-row-hover
                    : Theme.bg-input;
                animate background { duration: Theme.anim-fast; }
                animate border-color { duration: Theme.anim-fast; }

                Text {
                    text: action.label;
                    color: danger ? Theme.danger-on-bg : Theme.fg-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.font-size;
                }

                action-touch := TouchArea {
                    Tooltip {
                        text: @markdown("\{action.tip}");
                    }

                    clicked => {
                        root.maintenance-action(action.key);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        SectionHeader {
            text: @tr("Statistics");
        }

        // Stats rows sit flush (single line spacing) as one block.
        VerticalLayout {
            spacing: 0;

            HorizontalLayout {
                height: 32px;
                spacing: 12px;
                alignment: start;
                Text {
                    width: 180px;
                    text: @tr("Database created");
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                Text {
                    text: SettingsValues.s-db-created;
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 12px;
                alignment: start;
                Text {
                    width: 180px;
                    text: @tr("Database size");
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                Text {
                    text: SettingsValues.s-db-size;
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 12px;
                alignment: start;
                Text {
                    width: 180px;
                    text: @tr("Total clips");
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                Text {
                    text: SettingsValues.s-total-clips;
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 12px;
                alignment: start;
                Text {
                    width: 180px;
                    text: @tr("Unique clips ever / Pastes");
                    color: Theme.fg-primary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("{} / {}", SettingsValues.s-copies, SettingsValues.s-pastes);
                    color: Theme.fg-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
            }
        }
    }
}
