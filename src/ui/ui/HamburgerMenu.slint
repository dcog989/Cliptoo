// HamburgerMenu.slint — Popup menu content for hamburger icon.
// Rendered inside a PopupWindow declared in AppWindow.
// Window management (hide/minimise) does not belong here; ESC already hides
// the window.

import { Theme } from "Theme.slint";
import { MenuRow } from "MenuRow.slint";

export component HamburgerMenu {
    callback menu-settings();
    callback menu-about();

    // Keyboard selection: index of the highlighted row, -1 until the first
    // arrow key.
    in-out property <int> selected: -1;
    property <int> row-count: 2;

    // Wrap around so Down at the last row lands on the first.
    public function move-selection(delta: int) {
        let next = root.selected + delta;
        if (next < 0) {
            root.selected = root.row-count - 1;
        } else if (next >= root.row-count) {
            root.selected = 0;
        } else {
            root.selected = next;
        }
    }

    public function select-first() {
        root.selected = 0;
    }

    public function select-last() {
        root.selected = root.row-count - 1;
    }

    // Enter: run the highlighted row's action.
    public function activate-selected() {
        if (root.selected == 0) {
            root.menu-about();
        } else if (root.selected == 1) {
            root.menu-settings();
        }
    }

    // Intrinsic popup height, used by AppWindow to place the popup just
    // above the hamburger button.
    out property <length> menu-height: menu-root.height;
    // Intrinsic content width; AppWindow sizes the PopupWindow to this so the
    // popup is content-driven yet has an explicit width (Qt backend).
    out property <length> menu-width: menu-root.preferred-width;

    menu-root := Rectangle {
        border-radius: Theme.border-radius;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;

        VerticalLayout {
            padding: Theme.menu-padding;
            spacing: 2px;

            MenuRow {
                label: @tr("About");
                icon: @image-url("icons/info.svg");
                selected: root.selected == 0;
                clicked => {
                    root.menu-about();
                }
            }

            MenuRow {
                label: @tr("Settings");
                icon: @image-url("icons/settings.svg");
                shortcut: "Ctrl+,";
                selected: root.selected == 1;
                clicked => {
                    root.menu-settings();
                }
            }
        }
    }
}
