// HamburgerMenu.slint — Popup menu content for hamburger icon.
// Rendered inside a PopupWindow declared in AppWindow.

import { Theme } from "Theme.slint";

export component HamburgerMenu {
    callback menu-settings();
    callback menu-about();
    callback menu-close-to-tray();

    // Intrinsic popup height, used by AppWindow to place the popup just
    // above the hamburger button.
    out property <length> menu-height: menu-root.height;
    // Intrinsic content width; AppWindow sizes the PopupWindow to this so the
    // popup is content-driven yet has an explicit width (Qt backend).
    out property <length> menu-width: menu-root.preferred-width;

    menu-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Rectangle {
                height: 36px;
                border-radius: 6px;
                border-width: 1px;
                border-color: touch-about.has-hover || touch-about.pressed ? Theme.accent-primary : transparent;
                background: touch-about.pressed ? Theme.bg-row-selected : touch-about.has-hover ? Theme.bg-row-hover : transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/info.svg");
                        colorize: Theme.fg-secondary;
                    }

                    Text {
                        text: @tr("About");
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                }

                touch-about := TouchArea {
                    clicked => {
                        root.menu-about();
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 36px;
                border-radius: 6px;
                border-width: 1px;
                border-color: touch-settings.has-hover || touch-settings.pressed ? Theme.accent-primary : transparent;
                background: touch-settings.pressed ? Theme.bg-row-selected : touch-settings.has-hover ? Theme.bg-row-hover : transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/settings.svg");
                        colorize: Theme.fg-secondary;
                    }

                    Text {
                        text: @tr("Settings");
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                }

                touch-settings := TouchArea {
                    clicked => {
                        root.menu-settings();
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 36px;
                border-radius: 6px;
                border-width: 1px;
                border-color: touch-close.has-hover || touch-close.pressed ? Theme.accent-primary : transparent;
                background: touch-close.pressed ? Theme.bg-row-selected : touch-close.has-hover ? Theme.bg-row-hover : transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/minimize-2.svg");
                        colorize: Theme.fg-secondary;
                    }

                    Text {
                        text: @tr("Close to Tray");
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                }

                touch-close := TouchArea {
                    clicked => {
                        root.menu-close-to-tray();
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
