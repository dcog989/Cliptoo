// ClipList.slint — Virtualized list of clip items.
// Binds to VecModel<ClipData> from Rust. Only visible rows are rendered (O(1)).
// selected-index is in-out so the key handler can mutate it directly without Rust
// roundtrips. Rust re-points it whenever the model is replaced: the same clip
// stays selected when it is still in the view, otherwise the first row is.
//
// Keyboard navigation is driven entirely by the parent (AppWindow) via the
// public nav-* functions below. ClipList holds no FocusScope of its own.

import { ClipItem } from "ClipItem.slint";
import { Theme } from "Theme.slint";
import { ClipData } from "ClipData.slint";
import { ScrollBar } from "ScrollBar.slint";
import { ListView } from "std-widgets.slint";

export component ClipList {
    in property <[ClipData]> clips;
    in property <bool> quick-paste-active: false;
    in property <int> quick-paste-slots: 9;
    in property <bool> is-searching: false;
    in-out property <int> selected-index: 0;
    // Mirrors the window's popup state so rows end their hover session while a
    // menu owns the pointer (see ClipItem.popup-open).
    in property <bool> popup-open: false;
    // True while the current view has older rows the model has not appended
    // yet. Cleared by Rust when a page comes back short (end of the view).
    in property <bool> has-more: false;

    callback item-activated(int);
    callback item-right-clicked(int, float, float, bool, string);
    callback request-preview(int, float, float);  // id, x, y in logical px
    callback dismiss-preview;
    callback load-more;              // viewport neared the end of the loaded rows

    // Collapses the selection to one cursor row (nav, click).
    function set-cursor(idx: int) {
        root.selected-index = idx;
    }

    function click-row(idx: int) {
        root.set-cursor(idx);
        root.item-activated(root.clips[idx].id);
    }

    public function ensure-visible() {
        let top = root.selected-index * Theme.row-height;
        let bottom = top + Theme.row-height;
        if (top < -list-view.content-y) {
            list-view.content-y = -top;
        } else if (bottom > -list-view.content-y + list-view.visible-height) {
            list-view.content-y = -bottom + list-view.visible-height;
        }
    }

    public function nav-up() {
        if (root.clips.length > 0) {
            root.set-cursor(max(0, root.selected-index - 1));
            root.ensure-visible();
        }
    }

    public function nav-down() {
        if (root.clips.length > 0) {
            root.set-cursor(min(root.clips.length - 1, root.selected-index + 1));
            root.ensure-visible();
        }
    }

    public function nav-home() {
        if (root.clips.length > 0) {
            root.set-cursor(0);
        }
        list-view.content-y = 0px;
    }

    // Scroll only, no cursor move: search jumps the list back to the first
    // row as the query changes, without re-pointing the selection.
    public function scroll-to-top() {
        list-view.content-y = 0px;
    }

    public function nav-end() {
        if (root.clips.length > 0) {
            root.set-cursor(root.clips.length - 1);
            // Scroll so the last row's *bottom* is at the viewport bottom.
            list-view.content-y = -(root.clips.length * Theme.row-height - list-view.visible-height);
        }
    }

    public function nav-page-up() {
        if (root.clips.length > 0) {
            root.set-cursor(max(0, root.selected-index - root.page-rows));
            root.ensure-visible();
        }
    }

    public function nav-page-down() {
        if (root.clips.length > 0) {
            root.set-cursor(min(root.clips.length - 1, root.selected-index + root.page-rows));
            root.ensure-visible();
        }
    }

    public function activate() {
        if (root.clips.length > 0) {
            root.item-activated(root.clips[root.selected-index].id);
        }
    }

    // Window-space Y of the selected row, for anchoring the context menu when
    // it is opened from the keyboard.
    public function selected-row-y() -> float {
        return (root.list-padding / 1px)
            + (root.selected-index * Theme.row-height / 1px)
            + (list-view.content-y / 1px);
    }

    // Scrollbar strip width. The std-widgets scrollbar is disabled below (its
    // track clicks don't register on Plasma) and replaced by the ScrollBar
    // overlay on the right edge.
    private property <length> scrollbar-width: 10px;
    // Gap above the first row so its highlight (inset from the row edges in
    // ClipItem) clears the window edge too.
    private property <length> list-padding: 8px;
    // Rows per visible page for nav-page-up/down.
    private property <int> page-rows: max(1.0, round(list-view.visible-height / Theme.row-height));

    // Paging: ask for the next page once the viewport is within a few rows of
    // the loaded end. Fires on the scroll transition, and an appended page
    // pushes that end out of the threshold, so each page loads once.
    private property <length> scroll-bottom: -list-view.content-y + list-view.visible-height;
    private property <length> load-more-threshold: 3 * Theme.row-height;
    changed scroll-bottom => {
        if (root.has-more
            && list-view.content-height > list-view.visible-height
            && root.scroll-bottom > list-view.content-height - root.load-more-threshold) {
            root.load-more();
        }
    }

    list-view := ListView {
        y: root.list-padding;
        height: root.height - root.list-padding;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        accessible-role: list;
        accessible-label: @tr("Clip history");
        accessible-item-count: root.clips.length;
        for clip[idx] in root.clips: ClipItem {
            clip-data: clip;
            is-selected: idx == root.selected-index;
            row-index: idx;
            is-alt-row: mod(idx, 2) == 1;
            quick-paste-active: root.quick-paste-active;
            quick-paste-slots: root.quick-paste-slots;
            is-searching: root.is-searching;
            popup-open: root.popup-open;

            activated => {
                root.click-row(idx);
            }
            right-clicked(x, y) => {
                // Right-click moves the selection to the row under the pointer
                // so the menu acts on (and highlights) that clip.
                root.set-cursor(idx);
                root.item-right-clicked(clip.id, x, idx * Theme.row-height / 1px + list-view.content-y / 1px + root.list-padding / 1px + y, clip.is-bookmarked, clip.clip-type);
            }
            hovered(mx, my) => {
                root.request-preview(clip.id, mx, idx * Theme.row-height / 1px + list-view.content-y / 1px + root.list-padding / 1px + my);
            }
            hover-exited => {
                root.dismiss-preview();
            }
        }
    }

    // Empty state (no clips, or a search/filter that matched nothing): dimmed
    // logo and label centred over the otherwise blank list area.
    if root.clips.length == 0: VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 16px;
        opacity: 0.8;

        Image {
            source: @image-url("../assets/cliptoo.svg");
            width: 96px;
            height: 96px;
        }

        Text {
            text: @tr("No Results");
            color: Theme.fg-primary;
            font-size: 32px;
            horizontal-alignment: center;
        }
    }

    scrollbar := ScrollBar {
        x: root.width - root.scrollbar-width;
        y: root.list-padding;
        width: root.scrollbar-width;
        height: root.height - root.list-padding;
        content-height: list-view.content-height;
        visible-height: list-view.visible-height;
        position: -list-view.content-y;
        position-changed(p) => {
            list-view.content-y = -p;
        }
    }
}
