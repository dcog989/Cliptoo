// PreviewTooltip.slint — content for the hover preview, sized to fit and
// hosted by PreviewWindow (a separate always-on-top tooltip surface) so the
// preview is not clipped to the main window.
import { Theme }      from "Theme.slint";
import { ScrollView } from "std-widgets.slint";

export component PreviewTooltip inherits Rectangle {
    in property <string> preview-clip-type: "text";
    in property <string> preview-text: "";
    in property <color> preview-color: #888888;
    in property <image> preview-image;
    in property <image> preview-favicon;
    in property <string> preview-web-title: "";
    in property <string> preview-file-info: "";

    // On-screen box for the image preview, from the preview-size setting.
    private property <length> image-box: Theme.preview-size;

    // Cap on the content height; taller content is hard-clipped and signalled
    // by the bottom fade-out gradient below. Image previews add room for the
    // caption row below the image; every other type caps at the setting.
    private property <length> max-content-height: root.preview-clip-type == "file_image" ? root.image-box + 56px : Theme.preview-size;

    // The preview-size setting drives the popup width for every clip type.
    width: root.preview-clip-type == "file_image" ? root.image-box + 24px : Theme.preview-size;
    height: Math.min(content-layout.preferred-height, root.max-content-height);
    clip: true;
    border-radius: Theme.border-radius;
    background: Theme.bg-header;
    border-width: 1px;
    border-color: Theme.border-subtle;

    content-layout := VerticalLayout {
        padding: 12px;

        // ── Color preview ─────────────────────────────────────────────────
        if root.preview-clip-type == "color": VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 60px;
                border-radius: 6px;
                background: root.preview-color;
            }

            Text {
                text: root.preview-text;
                font-family: Theme.font-family;
                color: Theme.fg-primary;
                font-size: Theme.preview-font-size;
                horizontal-alignment: center;
            }
        }

        // ── Image preview ─────────────────────────────────────────────────
        if root.preview-clip-type == "file_image": VerticalLayout {
            spacing: 8px;
            Image {
                source: root.preview-image;
                height: root.image-box;
                image-fit: contain;
            }

            Text {
                text: root.preview-text;
                font-family: Theme.font-family;
                color: Theme.fg-secondary;
                font-size: Theme.preview-font-size - 1px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // ── Web link preview ──────────────────────────────────────────────
        if root.preview-clip-type == "link": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Image {
                    source: root.preview-favicon;
                    width: 16px;
                    height: 16px;
                }

                Text {
                    text: root.preview-web-title == "" ? root.preview-text : root.preview-web-title;
                    font-family: Theme.font-family;
                    color: Theme.fg-primary;
                    font-size: Theme.preview-font-size;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: root.preview-text;
                font-family: Theme.font-family;
                color: Theme.accent-primary;
                font-size: Theme.preview-font-size - 1px;
                overflow: elide;
            }
        }

        // ── Code snippet preview ─────────────────────────────────────────
        if root.preview-clip-type == "code_snippet": VerticalLayout {
            spacing: 4px;
            ScrollView {
                height: 240px;
                Text {
                    width: parent.width - 24px;
                    text: root.preview-text;
                    color: Theme.fg-primary;
                    font-size: Theme.preview-font-size;
                    font-family: "monospace";
                    wrap: no-wrap;
                }
            }
        }

        // ── File / folder preview ────────────────────────────────────────
        if root.preview-clip-type == "folder" || root.preview-clip-type == "file_generic" || root.preview-clip-type == "file_dev": VerticalLayout {
            spacing: 4px;
            Text {
                text: root.preview-text;
                font-family: Theme.font-family;
                color: Theme.fg-primary;
                font-size: Theme.preview-font-size;
                overflow: elide;
            }

            Text {
                text: root.preview-file-info;
                color: Theme.fg-secondary;
                font-size: Theme.preview-font-size - 1px;
            }
        }

        // ── Text preview (default) ───────────────────────────────────────
        // Falls through for: text, rtf, html, file_audio, file_video,
        // file_archive, file_document, file_text, file_danger,
        // file_generic, and any future unknown types.
        // These show plain text since the favicon/title pipeline doesn't
        // run for them. If that changes, add an explicit branch above.
        //
        // Content beyond the height cap is hard-clipped (root height cap); the
        // gradient below signals truncation. Tracked as a future polish item.
        if root.preview-clip-type != "color" && root.preview-clip-type != "file_image" && root.preview-clip-type != "link" && root.preview-clip-type != "code_snippet" && root.preview-clip-type != "folder" && root.preview-clip-type != "file_generic" && root.preview-clip-type != "file_dev":
        Text {
            // parent.width is the content box; subtract padding (2 × 12px) for
            // the wrap budget.
            width: parent.width - 24px;
            text: root.preview-text;
            font-family: Theme.font-family;
            color: Theme.fg-primary;
            font-size: Theme.preview-font-size;
            wrap: word-wrap;
        }
    }

    // Gradient fade at the bottom to signal truncation when content exceeds
    // the height cap. Visible only for the text branch (code_snippet has its
    // own ScrollView; color/image are fixed height).
    if root.preview-clip-type != "code_snippet" && root.preview-clip-type != "color" && root.preview-clip-type != "file_image" && content-layout.preferred-height > root.max-content-height: Rectangle {
        x: 0;
        y: root.height - 32px;
        width: 100%;
        height: 32px;
        background: @linear-gradient(180deg, transparent 0%, Theme.bg-header 100%);
    }
}
