// ToastNotification.slint — temporary overlay toast for info/warn/error feedback.
//
// Usage:
//   Set `visible`, `message`, and `severity` from Rust.
//   Info and warning toasts auto-dismiss after `display-duration`; an error
//   stays until the user dismisses it, because it reports something that needs
//   attention. `action-label` adds a single action (e.g. Undo).
//
// Severity values: "info" | "warn" | "error"   (anything else → info styling)

import { Theme } from "Theme.slint";

export component ToastNotification {
    in property <string> message:          "";
    in property <string> severity:         "info";
    // display-duration in milliseconds; the internal timer uses this.
    in property <duration> display-duration: 6000ms;
    // Optional single action, e.g. "Undo". An empty label hides the button.
    in property <string> action-label:     "";

    // The parent sets this to show the toast.
    in-out property <bool> active: false;

    callback dismissed;
    callback action-clicked;

    // The mix factor weights the colour it is called on, so 0.85 keeps the
    // warning a strong amber fill (15% page) that the white `warn-fg` text can
    // clear in both modes. A small factor leaves white text on a pale tint.
    property <color> bg-color:
        severity == "error" ? Theme.danger-bg : severity == "warn" ? Theme.warn-base.mix(Theme.bg-primary, 0.85) : Theme.accent-fill.mix(Theme.bg-primary, 0.25);

    property <color> border-color:
        severity == "error" ? Theme.danger-bg : severity == "warn" ? Theme.warn-base : Theme.accent-fill;

    property <color> text-color:
        severity == "error" ? Theme.danger-on-bg : severity == "warn" ? Theme.warn-fg : Theme.fg-primary;

    function dismiss() {
        root.active = false;
        root.dismissed();
    }

    // Auto-dismiss timer: fires once after display-duration, then resets.
    // Errors stay until dismissed: they need attention and must not vanish
    // while the user is reading them.
    Timer {
        interval: root.display-duration;
        running: root.active && root.severity != "error";
        triggered => {
            root.dismiss();
        }
    }

    // The root is always present (toggled via `visible`) so an absolutely
    // positioned instance keeps its content-derived size; a conditional `if`
    // root collapses the whole component to 0x0.
    Rectangle {
        visible: root.active;
        // Anchored to bottom-center of the window by the parent (x/y set at
        // the use site).
        min-width: 120px;
        max-width: 400px;

        border-radius: Theme.border-radius;
        background: bg-color;
        border-width: 1px;
        border-color: border-color;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;

        animate opacity { duration: Theme.anim-fast; }

        content-layout := HorizontalLayout {
            width: 100%;
            padding: 8px;
            spacing: 8px;
            // Default `stretch`: only then do stretch factors grow the message
            // and push the action button to the right edge.

            // Severity indicator bar
            Rectangle {
                width: 3px;
                height: 100%;
                background: border-color;
                border-radius: 2px;
            }

            Text {
                // Empty while hidden, so assistive tech never sees a stale
                // message from the previous toast.
                text: root.active ? root.message : "";
                horizontal-stretch: 1;
                color: text-color;
                font-size: Theme.font-size;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: center;
                // Announce feedback (delete confirmation, save errors) instead
                // of leaving it visible-only. Errors interrupt; the rest wait.
                accessible-live-region: root.severity == "error"
                    ? AccessibleLiveness.assertive
                    : AccessibleLiveness.polite;
            }

            // Single action (Undo). A toast with an action stays for its full
            // display-duration so the action is usable.
            if root.action-label != "": Rectangle {
                width: action-text.preferred-width + 12px;
                height: 24px;
                border-radius: 4px;
                background: transparent;
                border-width: 1px;
                border-color: text-color;

                action-text := Text {
                    text: root.action-label;
                    color: text-color;
                    font-size: Theme.font-size;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action-clicked();
                        root.dismiss();
                    }
                }
            }

            // Errors never auto-dismiss, so give them an explicit close path.
            if root.severity == "error" && root.action-label == "": Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;

                Text {
                    text: "×";
                    color: text-color;
                    font-size: Theme.font-size + 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: @tr("Dismiss");
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

// Shared toast placement for every window: centered horizontally, `bottom-offset`
// above the window's bottom edge. Consumers only supply the message/severity.
export component ToastHost {
    in property <length> bottom-offset: 16px;
    in property <string> message;
    in property <string> severity: "info";
    in property <string> action-label: "";
    in property <duration> display-duration: 8000ms;
    in-out property <bool> active: false;

    callback action-clicked;

    width: 100%;
    height: 100%;

    toast := ToastNotification {
        width: Math.min(360px, root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.height - root.bottom-offset - self.height;
        message: root.message;
        severity: root.severity;
        action-label: root.action-label;
        display-duration: root.display-duration;
        active <=> root.active;
        action-clicked => {
            root.action-clicked();
        }
    }
}
