// ContextMenuHost.slint — Right-click context menu for clip list items,
// together with its positioning state.
//
// AppWindow calls `open-at` from the ClipList right-click callback. The main
// menu is one PopupWindow; Format and Send To open their own flyout popups to
// the right, so the main menu never resizes or repaints. The flyouts are nested
// inside the main popup so they close with it.

import { ContextMenu } from "ContextMenu.slint";
import { FormatMenu } from "FormatMenu.slint";
import { MenuRow } from "MenuRow.slint";
import { Theme } from "Theme.slint";

export component ContextMenuHost {
    // Populated by Rust from settings.send_to_apps, and rebuilt when that
    // setting changes.
    in property <[string]> send-to-apps: [];
    in property <length> window-width: 0px;
    in property <length> window-height: 0px;
    // Set by AppWindow just before open-at: true when the right-click landed
    // inside the multi-selection.
    in property <bool> multi-selection: false;

    // Read-only for AppWindow: reflects whether the main menu is open.
    out property <bool> popup-open: main-popup.is-open;

    callback preview-requested(int, float, float);  // id, x, y in logical px
    callback edit-clip(int);
    callback decode-qr(int);
    callback transform-clip(int, string);
    callback paste-clip(int);              // default paste for plain text clips
    callback paste-as(int, string);        // id, mode ("rich" | "plain")
    callback toggle-bookmark(int, bool);   // id, current is-bookmarked
    callback move-to-top(int);
    callback move-to-bottom(int);
    callback move-up-one(int);
    callback move-down-one(int);
    callback send-to-clip(int, string);    // id, app name
    callback delete-clip(int);
    callback delete-selection();           // multi-selection: delete every selected clip
    callback merge-selection();            // multi-selection: merge into one clip
    // Set by close-all; handled inside the main popup, where the nested
    // flyouts are in scope.
    in-out property <bool> close-flyouts-requested: false;

    property <int> ctx-clip-id: 0;
    property <bool> ctx-clip-is-bookmarked: false;
    property <string> ctx-clip-type: "text";
    // Raw right-click position. The popup's x/y bindings clamp these.
    property <length> ctx-menu-x: 0px;
    property <length> ctx-menu-anchor-y: 0px;
    // Main menu geometry mirrored out of the popup; the flyouts position
    // themselves from it.
    property <length> main-w: 0px;
    property <length> format-row-y: 0px;
    property <length> send-row-y: 0px;
    // Armed by each show function just before its popup.show(); that popup's
    // focus-timer consumes its own flag once its key-handling scope has focus.
    in-out property <bool> main-focus-armed: false;
    in-out property <bool> format-focus-armed: false;
    in-out property <bool> send-focus-armed: false;
    // Keyboard selection in the Send To flyout.
    property <int> send-selected: -1;

    public function open-at(id: int, x: float, y: float, bookmarked: bool, clip-type: string) {
        root.ctx-clip-id = id;
        root.ctx-clip-is-bookmarked = bookmarked;
        root.ctx-clip-type = clip-type;
        root.ctx-menu-x = x * 1px;
        root.ctx-menu-anchor-y = y * 1px;
        root.close-flyouts-requested = false;
        root.main-focus-armed = true;
        main-popup.show();
    }

    // Closes the menu and any open flyout. Called from AppWindow on blur.
    public function close-all() {
        root.close-flyouts-requested = true;
        main-popup.close();
        root.close-flyouts-requested = false;
    }

    function send-row-count() -> int {
        return root.send-to-apps.length;
    }

    function send-move-selection(delta: int) {
        if (root.send-row-count() == 0) {
            return;
        }
        let next = root.send-selected + delta;
        if (next < 0) {
            root.send-selected = root.send-row-count() - 1;
        } else if (next >= root.send-row-count()) {
            root.send-selected = 0;
        } else {
            root.send-selected = next;
        }
    }

    function send-activate-selected() {
        if (root.send-selected >= 0 && root.send-selected < root.send-row-count()) {
            root.send-to-clip(root.ctx-clip-id, root.send-to-apps[root.send-selected]);
            root.close-all();
        }
    }

    main-popup := PopupWindow {
        // Inside clicks must not dismiss: Delete arms on the first one and
        // needs the second. Outside clicks and ESC still close.
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: Math.max(0px, Math.min(root.ctx-menu-x, root.window-width - (main-menu.menu-width + 4px)));
        y: Math.max(0px, Math.min(root.ctx-menu-anchor-y, root.window-height - main-menu.menu-height));
        width: main-menu.menu-width;
        height: main-menu.menu-height;

        // Mirror of the host flag: `changed` only accepts a property of this
        // element. Runs synchronously, before the host closes this popup.
        property <bool> close-requested: root.close-flyouts-requested;
        changed close-requested => {
            if (self.close-requested) {
                format-flyout.close();
                send-flyout.close();
                root.close-flyouts-requested = false;
            }
        }

        esc-scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.close-all();
                    return accept;
                }
                if (e.text == Key.RightArrow) {
                    if (main-menu.open-selected-submenu()) {
                        return accept;
                    }
                    return reject;
                }
                if (e.text == Key.UpArrow) {
                    main-menu.move-selection(-1);
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    main-menu.move-selection(1);
                    return accept;
                }
                if (e.text == Key.Home) {
                    main-menu.select-first();
                    return accept;
                }
                if (e.text == Key.End) {
                    main-menu.select-last();
                    return accept;
                }
                if (e.text == Key.Return) {
                    main-menu.activate-selected();
                    return accept;
                }
                reject
            }

            // Solid fill for the area under the menu; rounded so it cannot
            // poke out past the menu's corners.
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Theme.border-radius;
                background: Theme.bg-header;
            }

            main-menu := ContextMenu {
                width: 100%;
                height: 100%;
                clip-id: root.ctx-clip-id;
                clip-is-bookmarked: root.ctx-clip-is-bookmarked;
                clip-type: root.ctx-clip-type;
                send-to-apps: root.send-to-apps;
                multi-selection: root.multi-selection;

                preview => {
                    // Anchor at the clip's row, not the menu: the menu is
                    // clamped upward near the window bottom and would open the
                    // preview away from the row that is being previewed.
                    root.preview-requested(root.ctx-clip-id, root.ctx-menu-x / 1px, root.ctx-menu-anchor-y / 1px);
                    root.close-all();
                }
                edit => {
                    root.edit-clip(root.ctx-clip-id);
                    root.close-all();
                }
                decode-qr => {
                    root.decode-qr(root.ctx-clip-id);
                    root.close-all();
                }
                paste() => {
                    root.paste-clip(root.ctx-clip-id);
                    root.close-all();
                }
                paste-as(mode) => {
                    root.paste-as(root.ctx-clip-id, mode);
                    root.close-all();
                }
                toggle-bookmark(id, current) => {
                    root.toggle-bookmark(id, current);
                    root.close-all();
                }
                move-to-top => {
                    root.move-to-top(root.ctx-clip-id);
                    root.close-all();
                }
                move-to-bottom => {
                    root.move-to-bottom(root.ctx-clip-id);
                    root.close-all();
                }
                move-up-one => {
                    root.move-up-one(root.ctx-clip-id);
                    root.close-all();
                }
                move-down-one => {
                    root.move-down-one(root.ctx-clip-id);
                    root.close-all();
                }
                delete => {
                    root.delete-clip(root.ctx-clip-id);
                    root.close-all();
                }
                delete-selection => {
                    root.delete-selection();
                    root.close-all();
                }
                merge-selection => {
                    root.merge-selection();
                    root.close-all();
                }
                submenu-requested(which) => {
                    if (which == "format") {
                        if (!format-flyout.is-open) {
                            send-flyout.close();
                            root.format-focus-armed = true;
                            format-flyout.show();
                        }
                    } else if (which == "send") {
                        if (!send-flyout.is-open) {
                            format-flyout.close();
                            root.send-focus-armed = true;
                            send-flyout.show();
                        }
                    } else if (format-flyout.is-open || send-flyout.is-open) {
                        format-flyout.close();
                        send-flyout.close();
                        root.main-focus-armed = true;
                    }
                }
            }
        }

        // ── Format flyout ───────────────────────────────────────────────────
        format-flyout := PopupWindow {
            close-policy: PopupClosePolicy.close-on-click-outside;
            x: root.main-w;
            y: root.format-row-y;
            width: fmt-menu.menu-width;
            height: fmt-menu.menu-height;

            fmt-esc-scope := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.close-all();
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        fmt-menu.move-selection(-1);
                        return accept;
                    }
                    if (e.text == Key.DownArrow) {
                        fmt-menu.move-selection(1);
                        return accept;
                    }
                    if (e.text == Key.Home) {
                        fmt-menu.select-first();
                        return accept;
                    }
                    if (e.text == Key.End) {
                        fmt-menu.select-last();
                        return accept;
                    }
                    if (e.text == Key.LeftArrow) {
                        format-flyout.close();
                        root.main-focus-armed = true;
                        return accept;
                    }
                    if (e.text == Key.Return) {
                        fmt-menu.activate-selected();
                        return accept;
                    }
                    reject
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.border-radius;
                    background: Theme.bg-header;
                }

                fmt-menu := FormatMenu {
                    width: 100%;
                    height: 100%;

                    format(key) => {
                        root.transform-clip(root.ctx-clip-id, key);
                        root.close-all();
                    }
                }
            }

            format-focus-timer := Timer {
                interval: 1ms;
                running: root.format-focus-armed;
                triggered() => {
                    fmt-esc-scope.focus();
                    fmt-menu.selected = -1;
                    root.format-focus-armed = false;
                }
            }
        }

        // ── Send To flyout ──────────────────────────────────────────────────
        send-flyout := PopupWindow {
            close-policy: PopupClosePolicy.close-on-click-outside;
            x: root.main-w;
            y: root.send-row-y;
            width: send-menu-root.preferred-width;
            height: send-menu-root.preferred-height;

            send-esc-scope := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.close-all();
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        root.send-move-selection(-1);
                        return accept;
                    }
                    if (e.text == Key.DownArrow) {
                        root.send-move-selection(1);
                        return accept;
                    }
                    if (e.text == Key.Home) {
                        root.send-selected = 0;
                        return accept;
                    }
                    if (e.text == Key.End) {
                        root.send-selected = root.send-row-count() - 1;
                        return accept;
                    }
                    if (e.text == Key.LeftArrow) {
                        send-flyout.close();
                        root.main-focus-armed = true;
                        return accept;
                    }
                    if (e.text == Key.Return) {
                        root.send-activate-selected();
                        return accept;
                    }
                    reject
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.border-radius;
                    background: Theme.bg-header;
                }

                send-menu-root := Rectangle {
                    border-radius: Theme.border-radius;
                    background: Theme.bg-header;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-offset-y: 4px;

                    VerticalLayout {
                        alignment: start;
                        padding: 4px;
                        spacing: 0px;

                        for app-name[idx] in root.send-to-apps: MenuRow {
                            label: app-name;
                            selected: root.send-selected == idx;
                            clicked => {
                                root.send-to-clip(root.ctx-clip-id, app-name);
                                root.close-all();
                            }
                        }
                    }
                }
            }

            send-focus-timer := Timer {
                interval: 1ms;
                running: root.send-focus-armed;
                triggered() => {
                    send-esc-scope.focus();
                    root.send-selected = -1;
                    root.send-focus-armed = false;
                }
            }
        }

        focus-timer := Timer {
            interval: 1ms;
            running: root.main-focus-armed;
            triggered() => {
                esc-scope.focus();
                // Mirror the geometry the flyouts position themselves from.
                root.main-w = main-menu.menu-width;
                root.format-row-y = main-menu.format-anchor-y;
                root.send-row-y = main-menu.send-anchor-y;
                root.main-focus-armed = false;
            }
        }
    }
}
