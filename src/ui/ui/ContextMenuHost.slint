// ContextMenuHost.slint — Right-click context menu popup for clip list items,
// together with all of its positioning state.
//
// AppWindow calls `open-at` (from the ClipList right-click callback); the menu
// emits callbacks that AppWindow bridges to Rust.

import { ContextMenu } from "ContextMenu.slint";
import { Theme }       from "Theme.slint";

export component ContextMenuHost {
    // Populated by Rust from settings.send_to_apps before each show().
    in property <[string]> send-to-apps: [];
    in property <length> window-width: 0px;
    in property <length> window-height: 0px;

    // Read-only for AppWindow: reflects whether the popup is currently open.
    out property <bool> popup-open: popup.is-open;

    callback preview-requested(int, float, float);  // id, x, y in logical px
    callback edit-clip(int);
    callback transform-clip(int, string);
    callback paste-as(int, string);  // id, mode ("rich" | "plain")
    callback toggle-bookmark(int, bool);  // id, current is-bookmarked
    callback move-to-top(int);
    callback move-to-bottom(int);
    callback move-up-one(int);
    callback move-down-one(int);
    callback send-to-clip(int, string);   // id, app name
    callback delete-clip(int);

    property <int> ctx-clip-id: 0;
    property <bool> ctx-clip-is-bookmarked: false;
    property <string> ctx-clip-type: "text";
    // Which sub-view the context menu shows ("main" | "format" | "send-to").
    // Owned here because Slint forbids touching elements inside a PopupWindow
    // from the enclosing component; two-way bound to ContextMenu.view below.
    // Reset to "main" before each show() so the menu never reopens on a sub-view.
    in-out property <string> ctx-menu-view: "main";
    // Raw right-click position. The popup's x/y bindings clamp these against
    // the current menu size, so the popup re-clamps reactively as the view
    // switches to "format"/"send-to".
    property <length> ctx-menu-x: 0px;
    property <length> ctx-menu-anchor-y: 0px;

    // Called by AppWindow from the ClipList right-click callback before the
    // popup opens.
    public function open-at(id: int, x: float, y: float, bookmarked: bool, clip-type: string) {
        root.ctx-clip-id = id;
        root.ctx-clip-is-bookmarked = bookmarked;
        root.ctx-clip-type = clip-type;
        root.ctx-menu-view = "main";
        root.ctx-menu-x = x * 1px;
        root.ctx-menu-anchor-y = y * 1px;
        popup.show();
    }

    popup := PopupWindow {
        x: Math.min(root.ctx-menu-x, root.window-width - (ctx-menu.menu-width + 4px));
        y: Math.max(0px, Math.min(root.ctx-menu-anchor-y, root.window-height - ctx-menu.menu-height));
        // Explicit size for the Qt backend — PopupWindow won't render without it.
        // Sized to the menu's content; grows/shrinks as the sub-view switches.
        width: ctx-menu.menu-width;
        height: ctx-menu.menu-height;
        // Solid fill so any extra space below the menu content is not transparent.
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg-header;
        }

        ctx-menu := ContextMenu {
            width: 100%;
            height: 100%;
            clip-id: root.ctx-clip-id;
            clip-is-bookmarked: root.ctx-clip-is-bookmarked;
            clip-type: root.ctx-clip-type;
            send-to-apps: root.send-to-apps;
            view <=> root.ctx-menu-view;

            preview => {
                root.preview-requested(root.ctx-clip-id, popup.x / 1px, popup.y / 1px);
                popup.close();
            }
            edit => {
                root.edit-clip(root.ctx-clip-id);
                popup.close();
            }
            paste-as(mode) => {
                root.paste-as(root.ctx-clip-id, mode);
                popup.close();
            }
            format(key) => {
                root.transform-clip(root.ctx-clip-id, key);
                popup.close();
            }
            toggle-bookmark(id, current) => {
                root.toggle-bookmark(id, current);
                popup.close();
            }
            move-to-top => {
                root.move-to-top(root.ctx-clip-id);
                popup.close();
            }
            move-to-bottom => {
                root.move-to-bottom(root.ctx-clip-id);
                popup.close();
            }
            move-up-one => {
                root.move-up-one(root.ctx-clip-id);
                popup.close();
            }
            move-down-one => {
                root.move-down-one(root.ctx-clip-id);
                popup.close();
            }
            send-to(app-name) => {
                root.send-to-clip(root.ctx-clip-id, app-name);
                popup.close();
            }
            delete => {
                root.delete-clip(root.ctx-clip-id);
                popup.close();
            }
        }
    }
}
