import { Theme } from "Theme.slint";

export struct FilterItem {
    key: string,
    label: string,
}

export component FilterGrid {
    in property <string> active-filter: "all";

    callback filter-chosen(string);

    property <[FilterItem]> items: [
        { key: "all", label: @tr("All") },
        { key: "text", label: @tr("Text") },
        { key: "file_image", label: @tr("Image") },
        { key: "bookmarked", label: @tr("Bookmarked") },
        { key: "link", label: @tr("Link") },
        { key: "code_snippet", label: @tr("Code") },
        { key: "color", label: @tr("Color") },
        { key: "folder", label: @tr("Folder") },
        { key: "file_audio", label: @tr("Audio") },
        { key: "file_video", label: @tr("Video") },
        { key: "file_archive", label: @tr("Archive") },
        { key: "file_document", label: @tr("Document") },
        { key: "file_database", label: @tr("Database") },
        { key: "file_font", label: @tr("Font") },
        { key: "rtf", label: @tr("Rich Text") },
        { key: "file", label: @tr("File") },
    ];

    property <length> grid-spacing: 4px;
    property <length> grid-padding: 8px;
    property <length> cell-size: 36px;

    Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;

        GridLayout {
            padding: root.grid-padding;
            spacing: root.grid-spacing;

            for item[idx] in root.items: Rectangle {
                row: Math.floor(idx / 4);
                col: Math.mod(idx, 4);
                width: root.cell-size;
                height: root.cell-size;
                border-radius: 5px;
                background: root.active-filter == item.key ? Theme.accent-muted : transparent;

                animate background { duration: Theme.anim-fast; }

                Image {
                    x: (root.cell-size - 24px) / 2;
                    y: (root.cell-size - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    source: item.key == "all" ? @image-url("icons/check-check.svg") : item.key == "text" ? @image-url("icons/text-align-start.svg") : item.key == "file_image" ? @image-url("icons/file-image.svg") : item.key == "bookmarked" ? @image-url("icons/bookmark.svg") : item.key == "link" ? @image-url("icons/link.svg") : item.key == "code_snippet" ? @image-url("icons/code.svg") : item.key == "color" ? @image-url("icons/palette.svg") : item.key == "folder" ? @image-url("icons/folder.svg") : item.key == "file_audio" ? @image-url("icons/audio-lines.svg") : item.key == "file_video" ? @image-url("icons/film.svg") : item.key == "file_archive" ? @image-url("icons/file-archive.svg") : item.key == "file_document" ? @image-url("icons/file-text.svg") : item.key == "file_database" ? @image-url("icons/database.svg") : item.key == "file_font" ? @image-url("icons/type-outline.svg") : item.key == "rtf" ? @image-url("icons/file-type.svg") : @image-url("icons/file.svg");
                    colorize: root.active-filter == item.key ? Theme.fg-secondary : Theme.fg-muted;
                    animate colorize { duration: Theme.anim-fast; }
                }

                cell-touch := TouchArea {
                    mouse-cursor: pointer;
                    Tooltip {
                        text: @markdown("\{item.label}");
                    }

                    clicked => {
                        root.filter-chosen(item.key);
                    }
                }
            }
        }
    }
}
