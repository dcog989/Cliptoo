import { Theme } from "Theme.slint";
import { ClipTypeMap } from "ClipTypes.slint";

export component FilterGrid {
    in property <string> active-filter: "all";
    // Keyboard selection: index into ClipTypeMap.filter-keys, -1 until an arrow
    // key is pressed. Also exposed so the popup can drive it.
    in-out property <int> selected: -1;
    // Cells per row; shared with the popup's arrow-key delta.
    in property <int> columns: 5;

    callback filter-chosen(string);

    // Wrap around so Left/Down at the last cell lands on the first.
    public function move-selection(delta: int) {
        let count = ClipTypeMap.filter-keys.length;
        if (count > 0) {
            let next = root.selected + delta;
            if (next < 0) {
                root.selected = count - 1;
            } else if (next >= count) {
                root.selected = 0;
            } else {
                root.selected = next;
            }
        }
    }

    public function activate-selected() {
        if (root.selected >= 0 && root.selected < ClipTypeMap.filter-keys.length) {
            root.filter-chosen(ClipTypeMap.filter-keys[root.selected]);
        }
    }

    // Intrinsic grid extent, used by FilterPopup for popup anchor math.
    out property <length> grid-width: grid-root.preferred-width;
    out property <length> grid-height: grid-root.preferred-height;

    property <length> grid-spacing: 4px;
    property <length> grid-padding: 8px;
    property <length> cell-size: 36px;

    grid-root := Rectangle {
        border-radius: 8px;
        background: Theme.bg-header;
        border-width: 1px;
        border-color: Theme.border-subtle;

        GridLayout {
            padding: root.grid-padding;
            spacing: root.grid-spacing;

            for key[idx] in ClipTypeMap.filter-keys: Rectangle {
                row: Math.floor(idx / root.columns);
                col: Math.mod(idx, root.columns);
                width: root.cell-size;
                height: root.cell-size;
                border-radius: 5px;
                border-width: root.selected == idx ? 1px : 0px;
                border-color: Theme.accent-primary;
                background: root.active-filter == key ? Theme.accent-fill : cell-touch.has-hover ? Theme.bg-row-hover : transparent;

                // A single-choice filter, so expose each cell as a radio button
                // that assistive tech can toggle without a pointer.
                accessible-role: radio-button;
                accessible-checkable: true;
                accessible-checked: root.active-filter == key;
                accessible-label: ClipTypeMap.label-for(key);
                accessible-action-default => {
                    root.filter-chosen(key);
                }

                animate background { duration: Theme.anim-fast; }

                Image {
                    x: (root.cell-size - 24px) / 2;
                    y: (root.cell-size - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    source: ClipTypeMap.icon-for(key);
                    // The active cell is a solid accent shape, so it takes the
                    // contrast foreground. A hovered cell gets the neutral hover
                    // surface, where `fg-muted` is too dim, so its icon lifts to
                    // `fg-clip-list`; when color coding is on the clip type's tint
                    // stands in. The bookmark cell always keeps the bookmark
                    // colour, like the bookmark icon on a row.
                    colorize: root.active-filter == key
                        ? Theme.accent-fg
                        : key == "bookmarked"
                        ? Theme.fg-bookmarked
                        : (Theme.color-code-clip-types && ClipTypeMap.has-color-for(key)
                        ? ClipTypeMap.color-for(key)
                        : cell-touch.has-hover
                        ? Theme.fg-clip-list
                        : Theme.fg-muted);
                    animate colorize { duration: Theme.anim-fast; }
                }

                cell-touch := TouchArea {
                    mouse-cursor: pointer;
                    Tooltip {
                        text: @markdown("\{ClipTypeMap.label-for(key)}");
                    }

                    clicked => {
                        root.filter-chosen(key);
                    }
                }
            }
        }
    }
}
