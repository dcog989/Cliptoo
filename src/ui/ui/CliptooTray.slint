export component CliptooTray inherits SystemTrayIcon {
    // A tray icon must be monochrome and symbolic, not the full-colour app
    // logo. Plasma does not recolour StatusNotifier icons, so a mid-tone grey
    // stays visible on both light and dark panels.
    icon: @image-url("../assets/cliptoo-symbolic.svg");
    tooltip: @tr("Cliptoo — Clipboard Manager");
    title: "Cliptoo";

    callback toggle-window();
    callback quit-app();

    clicked => {
        toggle-window();
    }

    Menu {
        MenuItem {
            title: @tr("Show / Hide");
            activated => {
                toggle-window();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit");
            activated => {
                quit-app();
            }
        }
    }
}
