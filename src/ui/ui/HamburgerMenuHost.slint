// HamburgerMenuHost.slint — Popup menu for the hamburger icon (About,
// Settings, Close to Tray), positioned just above the hamburger button.

import { HamburgerMenu } from "HamburgerMenu.slint";

export component HamburgerMenuHost {
    // Window-space top-right corner of the hamburger button, from Toolbar.
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <length> menu-gap: 6px;

    // Transient guard: AppWindow sets this around close() so the focus-poll /
    // focus-lost chains don't close-to-tray while the popup is closing.
    in-out property <bool> popup-just-closed: false;
    // Read-only for AppWindow: reflects whether the popup is currently open.
    out property <bool> popup-open: popup.is-open;
    // Armed by show() just before popup.show(); the popup's focus-timer
    // consumes it once the key-handling scope has focus. Gives that scope
    // focus on every open so it receives keys (ESC to close).
    in-out property <bool> focus-armed: false;

    callback menu-settings();
    callback menu-about();
    callback menu-close-to-tray();

    // Called by AppWindow from the toolbar hamburger click.
    public function show() {
        root.focus-armed = true;
        popup.show();
    }

    // Closes the popup. Called from AppWindow's close-all-popups when the
    // window blurs so the menu can't linger as its own top-level window after
    // the main window hides.
    public function close-all() {
        popup.close();
    }

    // Keeps the guard armed for a moment after the popup closes. The popup's
    // close moves keyboard focus back to the main window asynchronously, so
    // clearing the flag in the same callback (as before) meant no observer ever
    // saw it true and the guard in MainClipArea did nothing.
    close-guard-timer := Timer {
        interval: 250ms;
        running: root.popup-just-closed;
        triggered => {
            root.popup-just-closed = false;
        }
    }

    // Content-driven but explicit width/height — the Qt backend won't render a
    // PopupWindow without explicit sizes.
    popup := PopupWindow {
        x: root.anchor-x - self.width;
        // Bottom edge sits menu-gap above the button's top edge.
        y: root.anchor-y - hamburger.menu-height - root.menu-gap;
        width: hamburger.menu-width;
        height: hamburger.menu-height;

        // Key handling scope: receives the keys the popup's focused window
        // delivers, so ESC closes the menu. The focus-timer below gives it
        // focus as soon as the popup is shown.
        esc-scope := FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.close-all();
                    return accept;
                }
                if (e.text == Key.UpArrow) {
                    hamburger.move-selection(-1);
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    hamburger.move-selection(1);
                    return accept;
                }
                if (e.text == Key.Home) {
                    hamburger.select-first();
                    return accept;
                }
                if (e.text == Key.End) {
                    hamburger.select-last();
                    return accept;
                }
                if (e.text == Key.Return) {
                    hamburger.activate-selected();
                    return accept;
                }
                reject
            }

            hamburger := HamburgerMenu {
                menu-settings => {
                    root.menu-settings();
                    root.popup-just-closed = true;
                    popup.close();
                }
                menu-about => {
                    root.menu-about();
                    root.popup-just-closed = true;
                    popup.close();
                }
                menu-close-to-tray => {
                    root.menu-close-to-tray();
                    root.popup-just-closed = true;
                    popup.close();
                }
            }
        }

        focus-timer := Timer {
            interval: 1ms;
            running: root.focus-armed;
            triggered() => {
                esc-scope.focus();
                hamburger.selected = -1;
                root.focus-armed = false;
            }
        }
    }
}
