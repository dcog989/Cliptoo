// AppWindow.slint — Root component.
// Imports all sub-components and manages global UI state. The clip list +
// keyboard handling live in MainClipArea; popups, the preview overlay, and
// resize handles are delegated to child host components.

import { MainClipArea }   from "MainClipArea.slint";
import { ContextMenuHost }  from "ContextMenuHost.slint";
import { HamburgerMenuHost } from "HamburgerMenuHost.slint";
import { FilterPopup }      from "FilterPopup.slint";
import { PreviewOverlay }   from "PreviewOverlay.slint";
import { ResizeHandles }    from "ResizeHandles.slint";
import { Theme }           from "Theme.slint";
import { ClipData }        from "ClipData.slint";
import { EditWindow }      from "EditWindow.slint";
import { SettingsWindow }  from "SettingsWindow.slint";
import { AboutWindow }     from "AboutWindow.slint";
import { ToastNotification } from "ToastNotification.slint";
import { CliptooTray }     from "CliptooTray.slint";
export {
    Theme,
    SettingsWindow,
    EditWindow,
    AboutWindow,
    CliptooTray,
}

// ── Main window ───────────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "Cliptoo";
    no-frame: true;

    // Window size — persisted across restarts, overridden from Rust at startup.
    // One-way binding: width/height follow stored-*.
    // Rust reads window().size() on close to persist user resize.
    in-out property <length> stored-width: 460px;
    in-out property <length> stored-height: 600px;
    width: stored-width;
    height: stored-height;

    // ── Callbacks (bridged to Rust) ───────────────────────────────────────────
    callback search-changed(string);
    callback search-backspace();
    callback search-word-backspace();

    callback filter-changed(string);   // "all" | "bookmarked" | "text" | "link" | "file_path" | "file_image" | "color" | "code_snippet" | "folder" | "file_danger" | "file_dev" | "file_audio" | "file_video" | "file_archive" | "file_document" | "rtf" | "file" | "file_text"
    callback item-activated(int);      // paste item with given id
    callback request-preview(int, float, float);  // id, x, y
    callback dismiss-preview();
    callback close-window();           // ESC pressed
    callback blur-closed();            // window lost focus
    callback focus-regained();         // window regained OS focus (e.g. Alt+Tab back in)
    callback drag-started();               // window drag started
    callback drag-ended();                 // window drag ended (pointer released)
    callback resize-start();               // window resize started (pointer down)
    callback resize-delta(float, float);   // window resize delta from press point
    callback resize-ended();               // window resize ended (pointer up)
    // ── Hamburger menu callbacks ─────────────────────────────
    callback menu-settings();
    callback menu-about();
    callback menu-close-to-tray();
    // Phase-5 callbacks
    callback transform-clip(int, string);       // id, transform key
    callback send-to-clip(int, string);         // id, app_path (or name)
    callback compare-set-left(int);             // remember id as compare-left
    callback compare-right(int);               // diff compare-left vs id
    callback maintenance-action(string);        // "clear-history" | "clear-caches" | "deadhead" | "reclassify"
    callback delete-clip(int);                 // delete clip by id
    callback toggle-bookmark(int, bool);        // id, current is-bookmarked (Slint passes current state; Rust flips it)
    callback move-to-top(int);                 // bump clip timestamp to top
    callback move-to-bottom(int);              // send clip to bottom
    callback move-up-one(int);                 // swap with clip above
    callback move-down-one(int);               // swap with clip below
    callback edit-clip(int);                   // open edit window for clip
    callback paste-as(int, string);            // paste clip as "rich" | "plain" text

    // ── Properties set from Rust ──────────────────────────────────────────────
    // Theme tokens are set directly via ui.global::<Theme>() in Rust.
    // Components reference Theme.* and pick up the runtime values automatically.
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;
    in property <[ClipData]> clips: [];
    in property <bool> is-searching: false;
    // Set from Rust on every show/hide of the main window. Gates the
    // focus-poll timer in MainClipArea so it never runs while hidden.
    in-out property <bool> window-visible: false;
    // Modifier key ("Right Alt" | "Left Alt" | "Control") that shows the
    // quick-paste overlay; set from Rust at startup and on settings change.
    in property <string> quick-paste-mod: "Right Alt";
    // The encoded KeyEvent.text produced by that modifier key (Alt=U+0012,
    // AltGr/right-alt=U+0013, Control=U+0011), used to track the held state.
    property <string> quick-paste-mod-text:
        root.quick-paste-mod == "Right Alt" ? "\u{0013}" : root.quick-paste-mod == "Left Alt" ? "\u{0012}" : "\u{0011}";
    in-out property <bool> popup-just-closed: false;
    // ── Toast notification ───────────────────────────────────────────
    in-out property <bool> toast-visible:   false;
    in-out property <string> toast-message:   "";
    in-out property <string> toast-severity:  "info";
    // Guards blur-closed against focus-lost while any PopupWindow or the
    // SettingsWindow is open. Derived from the popups' actual is-open state so
    // it can never get stuck true; Rust sets settings-open while the settings
    // window is visible. popup-opening is set by the popup-open handlers so the
    // guard is already true the moment a host popup's show() runs.
    property <bool> popup-open: root.popup-opening || ctx-menu-host.popup-open || hamburger-host.popup-open || filter-popup.popup-open || root.settings-open || root.about-open || root.edit-open;
    property <bool> popup-opening: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> about-open: false;
    in-out property <bool> edit-open: false;

    in property <length> min-window-width: 320px;
    in property <length> min-window-height: 240px;
    property <length> toolbar-height: Theme.toolbar-height;
    in-out property <string> active-filter: "all";
    in-out property <int> selected-index: 0;  // reset by Rust on search/filter change
    // search-text is owned jointly: Slint appends printable chars, Rust handles
    // Backspace (via search-backspace callback) and resets on filter/search change.
    in-out property <string> search-text: "";

    // ── Context menu state ────────────────────────────────────────────────────
    // Populated by Rust from settings.send_to_apps before each show().
    in property <[string]> ctx-send-to-apps: [];

    // ── Preview shadow properties (set from Rust, bound to PreviewOverlay) ─────
    in property <bool> preview-visible: false;
    in property <image> preview-image;
    in property <image> preview-favicon;
    in property <string> preview-clip-type: "text";
    in property <string> preview-text: "";
    in property <color> preview-color: #888888;
    in property <string> preview-web-title: "";
    in property <string> preview-file-info: "";
    in property <float> preview-popup-x: 0.0;
    in property <float> preview-popup-y: 0.0;

    // Re-anchors keyboard focus to the clip area's focus-scope. forward-focus
    // only applies the *first* time the window is activated (Slint focus docs);
    // once search-input is clicked it keeps focus permanently, silencing the
    // focus-lost/blur-closed path and the focus-poll fallback (gated on
    // !toolbar.search-focused). Called from Rust on every show().
    public function reset-focus() {
        main-clip-area.reset-focus();
    }
    // Scrolls the clip list back to the top and selects the first row.
    // Called from Rust on every show() so the list never opens scrolled to
    // wherever it was left last time.
    public function reset-scroll() {
        main-clip-area.reset-scroll();
    }

    // ── Layout ────────────────────────────────────────────────────────────────
    //
    //  ┌────────────────────────────────────────────────────────┐
    //  │[1] clip list (infinite scroll, fills space)         [2]│
    //  ├────────────────────────────────────────────────────────┤
    //  │[3] [search field ............................] [4] [5] │  ← Toolbar
    //  └────────────────────────────────────────────────────────┘
    //  1 = clip type icon and conditional icon for clips with leading white space
    //  2 = multi-line clip icon and / or bookmarked icon
    //  3 = grab / drag icon
    //  4 = current filter icon, click to popup filter list
    //  5 = hamburger menu reveals list of icons for Settings, About, etc.

    // Clip list + toolbar + all keyboard handling. Clipping Rectangle rounds
    // the window corners on the no-frame window.
    main-clip-area := MainClipArea {
        clips: root.clips;
        is-searching: root.is-searching;
        window-visible: root.window-visible;
        quick-paste-mod-text: root.quick-paste-mod-text;
        popup-open: root.popup-open;
        popup-just-closed <=> root.popup-just-closed;
        preview-hovered: preview-overlay.hovered;
        selected-index <=> root.selected-index;
        search-text <=> root.search-text;
        active-filter <=> root.active-filter;

        search-changed(s) => {
            root.search-changed(s);
        }
        search-backspace() => {
            root.search-backspace();
        }
        search-word-backspace() => {
            root.search-word-backspace();
        }
        filter-changed(f) => {
            root.filter-changed(f);
        }
        item-activated(id) => {
            root.item-activated(id);
        }
        request-preview(id, x, y) => {
            root.request-preview(id, x, y);
        }
        dismiss-preview() => {
            root.dismiss-preview();
        }
        close-window() => {
            root.close-window();
        }
        blur-closed() => {
            root.blur-closed();
        }
        focus-regained() => {
            root.focus-regained();
        }
        drag-started() => {
            root.drag-started();
        }
        drag-ended() => {
            root.drag-ended();
        }
        open-context-menu(id, x, y, bookmarked, ctype) => {
            root.popup-opening = true;
            ctx-menu-host.open-at(id, x, y, bookmarked, ctype);
            root.popup-opening = false;
        }
        open-hamburger-menu() => {
            root.popup-opening = true;
            hamburger-host.show();
            root.popup-opening = false;
        }
        open-filter-popup() => {
            root.popup-opening = true;
            filter-popup.show();
            root.popup-opening = false;
        }
    }

    // ── Context menu popup host ────────────────────────────────────
    ctx-menu-host := ContextMenuHost {
        x: 0px;
        y: 0px;
        window-width: root.width;
        window-height: root.height;
        send-to-apps: root.ctx-send-to-apps;

        preview-requested(id, x, y) => {
            root.request-preview(id, x, y);
        }
        edit-clip(id) => {
            root.edit-clip(id);
        }
        paste-as(id, mode) => {
            root.paste-as(id, mode);
        }
        transform-clip(id, key) => {
            root.transform-clip(id, key);
        }
        toggle-bookmark(id, current) => {
            root.toggle-bookmark(id, current);
        }
        move-to-top(id) => {
            root.move-to-top(id);
        }
        move-to-bottom(id) => {
            root.move-to-bottom(id);
        }
        move-up-one(id) => {
            root.move-up-one(id);
        }
        move-down-one(id) => {
            root.move-down-one(id);
        }
        send-to-clip(id, app-name) => {
            root.send-to-clip(id, app-name);
        }
        delete-clip(id) => {
            root.delete-clip(id);
        }
    }

    // ── Hamburger menu popup host ────────────────────────────────
    hamburger-host := HamburgerMenuHost {
        x: 0px;
        y: 0px;
        window-width: root.width;
        window-height: root.height;
        toolbar-height: root.toolbar-height;
        popup-just-closed <=> root.popup-just-closed;

        menu-settings() => {
            root.menu-settings();
        }
        menu-about() => {
            root.menu-about();
        }
        menu-close-to-tray() => {
            root.menu-close-to-tray();
        }
    }

    // ── Filter-grid popup host ──────────────────────────────────
    filter-popup := FilterPopup {
        x: 0px;
        y: 0px;
        active-filter <=> root.active-filter;
        window-width: root.width;
        window-height: root.height;
        toolbar-height: root.toolbar-height;

        filter-chosen(f) => {
            root.active-filter = f;
            root.filter-changed(f);
        }
    }

    // ── Preview tooltip overlay ──────────────────────────────────
    preview-overlay := PreviewOverlay {
        x: 0px;
        y: 0px;
        visible-preview: root.preview-visible;
        preview-image: root.preview-image;
        preview-favicon: root.preview-favicon;
        preview-clip-type: root.preview-clip-type;
        preview-text: root.preview-text;
        preview-color: root.preview-color;
        preview-web-title: root.preview-web-title;
        preview-file-info: root.preview-file-info;
        popup-x: root.preview-popup-x;
        popup-y: root.preview-popup-y;

        dismiss-preview() => {
            root.dismiss-preview();
        }
    }

    // ── Toast notification overlay ────────────────────────────────────────
    // Floated over the clip list, centered horizontally, 16px above the toolbar.
    ToastNotification {
        width: Math.min(320px, root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.height - (root.toolbar-height + 12px) - self.height;
        message: root.toast-message;
        severity: root.toast-severity;
        active <=> root.toast-visible;
        dismissed => {
            root.toast-visible = false;
        }
    }

    // ── Resize areas (edges + corner) and border overlay ─────────────────
    ResizeHandles {
        x: 0px;
        y: 0px;
        resize-start() => {
            root.resize-start();
        }
        resize-delta(dx, dy) => {
            root.resize-delta(dx, dy);
        }
        resize-ended() => {
            root.resize-ended();
        }
    }
}
