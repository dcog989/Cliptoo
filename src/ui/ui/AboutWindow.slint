// AboutWindow.slint — About dialog: logo, title, tagline, easter egg, info table.
// Shown from the hamburger menu → About.

import { Theme } from "Theme.slint";

component ClickLink {
    in property <string> text;
    callback clicked;

    private property <color> link-blue: Theme.link-fg;

    horizontal-stretch: 0;

    // Text + underline. Using a VerticalLayout root lets the Text's
    // preferred-width drive the component's natural width directly,
    // avoiding the self-referencing Rectangle { width: text-el.preferred-width }
    // pattern that starves the HorizontalLayout on Qt.
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        text-el := Text {
            text: root.text;
            color: link-blue;
            font-size: Theme.font-size;
            horizontal-alignment: left;
        }

        Rectangle {
            height: 1px;
            width: 100%;
            background: link-blue;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component AboutRow {
    in property <string> label;
    in property <string> value;
    in property <bool> clickable: true;
    callback value-clicked;

    HorizontalLayout {
        spacing: 32px;

        Text {
            width: 64px;
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.font-size;
            horizontal-alignment: left;
            vertical-alignment: center;
        }

        if root.clickable: ClickLink {
            text: root.value;
            clicked => {
                root.value-clicked();
            }
        }
        if !root.clickable: Text {
            height: 100%;
            text: root.value;
            color: Theme.fg-primary;
            font-size: Theme.font-size;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Cliptoo");
    // Keep the window above the main window while it's open.
    always-on-top: true;
    // Size the window to its content. Rust sizes explicitly with
    // set_size(content-width, content-height) since preferred-*
    // alone is unreliable on Wayland/Qt.
    min-width: 400px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    // The user's directories and version, filled in from Rust.
    in property <string> version: "";
    in property <string> install-path: "";
    in property <string> data-path: "";
    in property <string> cache-path: "";
    in property <string> logs-folder-path: "";

    // Content size measured from the layout, read by Rust for set_size.
    // content-layout.preferred-width correctly accounts for all visible
    // AboutRow children (label + gap + value path).  32px = window-frame
    // and font-metric breathing room.
    in-out property <length> content-width: content-layout.preferred-width + 32px;
    in-out property <length> content-height: content-layout.preferred-height;

    callback about-closing();
    callback open-repo();
    callback open-folder(string);

    forward-focus: about-focus;
    about-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.about-closing();
                root.hide();
                accept
            } else {
                reject
            }
        }
    }

    content-layout := VerticalLayout {
        padding: 24px;
        spacing: 8px;
        alignment: start;
        // Header (logo/title/tagline) stays centred; the facts table below
        // spans the full width so the paths hug the left edge.
        cross-axis-alignment: center;

        Image {
            source: @image-url("../assets/cliptoo.svg");
            width: 80px;
            height: 80px;
        }

        Text {
            text: "Cliptoo";
            color: Theme.fg-primary;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "The advanced clipboard manager";
            color: Theme.fg-secondary;
            font-size: Theme.font-size;
            horizontal-alignment: center;
        }

        Text {
            text: "\"Klaatu barada nikto!\"";
            color: Theme.accent-primary;
            font-size: 18px;
            font-italic: true;
            horizontal-alignment: center;
        }

        // Facts table — each AboutRow's HorizontalLayout drives the actual
        // content width via content-layout.preferred-width, so the window
        // naturally fits the longest value path.
        facts-table := VerticalLayout {
            width: 100%;
            cross-axis-alignment: stretch;
            spacing: 8px;

            AboutRow {
                label: "Version";
                value: root.version;
                clickable: false;
            }

            AboutRow {
                label: "Install";
                value: root.install-path;
                value-clicked => {
                    root.open-folder(root.install-path);
                }
            }

            AboutRow {
                label: "Data";
                value: root.data-path;
                value-clicked => {
                    root.open-folder(root.data-path);
                }
            }

            AboutRow {
                label: "Cache";
                value: root.cache-path;
                value-clicked => {
                    root.open-folder(root.cache-path);
                }
            }

            AboutRow {
                label: "Logs";
                value: root.logs-folder-path;
                value-clicked => {
                    root.open-folder(root.logs-folder-path);
                }
            }

            AboutRow {
                label: "Source";
                value: "https://github.com/dcog989/Cliptoo";
                value-clicked => {
                    root.open-repo();
                }
            }
        }

        VerticalLayout {
            padding-top: 8px;

            Text {
                text: "Cliptoo © since 2025. MIT License.";
                color: Theme.fg-muted;
                font-size: Theme.font-size - 2px;
                horizontal-alignment: center;
            }
        }
    }
}
