// AboutWindow.slint — About dialog: logo, title, tagline, easter egg, info table.
// Shown from the hamburger menu → About.

import { Theme } from "Theme.slint";
import { InputBox } from "InputBox.slint";
import { StepperRowBody } from "SettingsComponents.slint";

component AboutRow {
    in property <string> label;
    in property <string> value;
    in property <bool> clickable: true;
    callback value-clicked;

    HorizontalLayout {
        spacing: 32px;
        alignment: start;

        // Label column — fixed width, right-padded by spacing above.
        Text {
            width: 64px;
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.font-size;
            horizontal-alignment: left;
            vertical-alignment: center;
        }

        if root.clickable: Rectangle {
            vertical-stretch: 0;
            horizontal-stretch: 0;
            border-width: link-focus.has-focus ? 1px : 0px;
            border-color: Theme.accent-primary;
            accessible-role: button;
            accessible-label: root.label + ": " + root.value;
            accessible-action-default => {
                root.value-clicked();
            }

            value-text := Text {
                text: root.value;
                color: Theme.link-fg;
                font-size: Theme.font-size;
                horizontal-alignment: left;
                // A deep install/data path must not stretch the window off-screen.
                max-width: 700px;
                overflow: elide;
            }

            Rectangle {
                y: value-text.y + value-text.height;
                height: 1px;
                width: value-text.width;
                background: link-focus.has-focus ? Theme.accent-primary : Theme.link-fg;
            }

            link-focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.value-clicked();
                        accept
                    } else {
                        reject
                    }
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    link-focus.focus();
                    root.value-clicked();
                }
            }
        }

        if !root.clickable: Text {
            text: root.value;
            color: Theme.fg-primary;
            font-size: Theme.font-size;
            horizontal-alignment: left;
            vertical-alignment: center;
            max-width: 700px;
            overflow: elide;
        }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Cliptoo");
    always-on-top: true;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    preferred-width: root.content-width;
    preferred-height: root.content-height;
    min-width: 420px;
    min-height: 320px;

    in property <string> version: "";
    in property <string> install-path: "";
    in property <string> config-path: "";
    in property <string> data-path: "";
    in property <string> cache-path: "";
    in property <string> logs-folder-path: "";
    in property <string> log-level: "";

    in-out property <length> content-width: Math.min(900px, Math.max(560px, content-layout.preferred-width + 40px));
    in-out property <length> content-height: Math.max(360px, content-layout.preferred-height);

    callback about-closing();
    callback open-repo();
    callback open-folder(string);
    callback log-level-step(int);
    callback open-latest-log();

    forward-focus: about-focus;
    about-focus := FocusScope {
        // Focused programmatically on open so Escape works; not a Tab stop.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.about-closing();
                root.hide();
                accept
            } else {
                reject
            }
        }
    }

    content-layout := VerticalLayout {
        padding: 24px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Image {
            source: @image-url("../assets/cliptoo.svg");
            width: 80px;
            height: 80px;
        }

        Text {
            text: "Cliptoo";
            color: Theme.fg-primary;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: @tr("The advanced clipboard manager");
            color: Theme.fg-secondary;
            font-size: Theme.font-size;
            horizontal-alignment: center;
        }

        Text {
            text: @tr("\"Klaatu barada nikto!\"");
            color: Theme.brand-gold;
            font-size: 18px;
            font-italic: true;
            horizontal-alignment: center;
        }

        // Extra breathing room between the header and the facts table.
        SpaceBlock := Rectangle {
            height: 14px;
        }

        facts-table := VerticalLayout {
            width: 100%;
            spacing: 8px;

            AboutRow {
                label: @tr("Version");
                value: root.version;
                clickable: false;
            }

            AboutRow {
                label: @tr("Install");
                value: root.install-path;
                value-clicked => { root.open-folder(root.install-path); }
            }

            AboutRow {
                label: @tr("Config");
                value: root.config-path;
                value-clicked => { root.open-folder(root.config-path); }
            }

            AboutRow {
                label: @tr("Data");
                value: root.data-path;
                value-clicked => { root.open-folder(root.data-path); }
            }

            AboutRow {
                label: @tr("Cache");
                value: root.cache-path;
                value-clicked => { root.open-folder(root.cache-path); }
            }

            AboutRow {
                label: @tr("Logs");
                value: root.logs-folder-path;
                value-clicked => { root.open-folder(root.logs-folder-path); }
            }

            HorizontalLayout {
                spacing: 32px;
                alignment: start;

                Text {
                    width: 64px;
                    text: @tr("Log level");
                    color: Theme.fg-muted;
                    font-size: Theme.font-size;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                InputBox {
                    hover: log-body.prev-hover || log-body.next-hover;

                    log-body := StepperRowBody {
                        leading-glyph: "‹";
                        trailing-glyph: "›";
                        leading-label: @tr("Previous log level");
                        trailing-label: @tr("Next log level");
                        glyph-offset: -2px;
                        step-back() => { root.log-level-step(-1); }
                        step-forward() => { root.log-level-step(1); }

                        Text {
                            text: root.log-level;
                            color: Theme.fg-primary;
                            font-size: Theme.font-size;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            AboutRow {
                label: @tr("Log file");
                value: @tr("Open latest log");
                value-clicked => { root.open-latest-log(); }
            }

            AboutRow {
                label: @tr("Source");
                value: "https://github.com/dcog989/Cliptoo";
                value-clicked => { root.open-repo(); }
            }
        }

        VerticalLayout {
            padding-top: 14px;

            Text {
                text: @tr("Cliptoo © since 2025. GPL-3.0 License.");
                color: Theme.fg-muted;
                font-size: Theme.font-size - 2px;
                horizontal-alignment: center;
            }
        }
    }
}
