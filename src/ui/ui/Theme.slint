// Theme.slint — Global design token definitions.
// Color and typography tokens are populated from Rust at startup by
// `theme::fill_theme`. The accent is the user's `accent_color` hex (or the
// detected OS accent when cleared); its border tint is derived in OKLCH.
// Components reference Theme.* rather than hardcoding values.

export global Theme {
    // True when the resolved theme is dark. Filled from Rust so hover/emphasis
    // directions follow the actual mode instead of assuming dark.
    in property <bool> dark: true;

    // ── Colors (populated by Rust in theme::fill_theme) ─────────────────────
    // Accent palette derived from settings.accent_color (or the OS accent),
    // with the border tint derived in OKLCH. Defaults are fallbacks used only
    // until Rust applies the real values.
    in property <color> accent-primary:    #7C6EE6;
    // Filled accent shapes: toggle tracks, slider thumbs, pills and badges.
    // Derived with a lower APCA floor than `accent-primary` so the picked
    // color survives instead of being lightened into a pastel.
    in property <color> accent-fill:       #7C6EE6;
    in property <color> border-accent:     #5A5A5A;
    // Foreground for FTS search-match spans. Calibrated from the accent's hue
    // but rendered at a fixed strong chroma and high contrast against the row
    // surface, so a match stands out from the (often achromatic) body text.
    in property <color> match-highlight:   #A78BFA;
    // Foreground (black/white) that stays readable on an `accent-fill`
    // background; derived from that same fill by APCA contrast. Used for text,
    // icons and the toggle knob drawn on a filled accent shape.
    in property <color> accent-fg:         #ffffff;

    in property <color> bg-primary:        #181818;
    in property <color> bg-header:         #121212;
    in property <color> bg-row-alt:        #1C1C1C;
    // Hovered-row surface: a neutral step away from the page colour (lighter
    // in dark mode, darker in light mode), never the accent. Filled from Rust.
    in property <color> bg-row-hover:      #2D2D2D;
    // Selected-row surface: the accent hue at a low lightness, so muted
    // at-rest icons/text stay legible on it (filled from Rust). Keyboard
    // selection keeps the accent; pointer hover never does.
    in property <color> bg-row-selected:   #30295F;
    in property <color> bg-input:          #242424;

    in property <color> fg-primary:        #E4E4E4;
    in property <color> fg-secondary:      #A1A1A1;
    in property <color> fg-clip-list:      #B4B4B4;
    in property <color> fg-muted:          #999999;
    in property <color> fg-bookmarked:     #E5B567;
    // The logo's gold stroke (`assets/cliptoo.svg`), used for the About
    // window's tagline. Static in both theme modes.
    in property <color> brand-gold:        #ff9500;
    // Per-clip-type body-text and filter-icon colours, used only when
    // `color-code-clip-types` is on. Plain text keeps `fg-clip-list`.
    // `theme::palette` generates both modes; these dark defaults are fallbacks
    // used only until Rust applies the real values.
    in property <color> fg-type-danger:    #C6706A;
    in property <color> fg-type-video:     #E09865;
    in property <color> fg-type-audio:     #EBC573;
    in property <color> fg-type-image:     #A179BE;
    in property <color> fg-type-archive:   #B8A990;
    in property <color> fg-type-path:      #29A288;
    in property <color> fg-type-folder:    #74E2C6;
    in property <color> fg-type-text-file: #67DEF2;
    in property <color> fg-type-rich:      #F2D7B0;
    in property <color> fg-type-document:  #4494C8;
    in property <color> fg-type-link:      #89A9F1;
    in property <color> fg-type-code:      #8A943F;
    in property <color> fg-type-dev:       #A8B35E;
    in property <color> fg-type-color:     #D291CC;
    in property <color> fg-type-data:      #FFB0CE;
    in property <color> fg-type-generic:   #7E8E9F;

    in property <color> border-subtle:     #444444;
    // Hover-preview frame. One step brighter than border-subtle in dark mode
    // so the always-on-top surface reads against other windows.
    in property <color> border-preview:    #666666;
    in property <color> shadow:            #00000030;

    // ── Status & control colors (static, not accent-derived) ───────────────
    in property <color> warn-base:      #e67e22;  // amber fill (warning toasts)
    // White is the APCA pick over black for every warn fill (>= Lc 53).
    in property <color> warn-fg:        #ffffff;
    in property <color> link-fg:        #4C9EFF;  // link blue, readable on any background
    in property <color> bg-track:       #555555;  // slider track / toggle-off background

    // Destructive/error palette. `danger-fg` is set per theme mode by
    // `theme::fill_theme` so it clears the same text floor as the rest of the
    // page text; the fill and on-fill pair stay static.
    in property <color> danger-fg:      #e24b39;  // red foreground / accent
    in property <color> danger-bg:      #9c2a1e;  // filled destructive surface
    in property <color> danger-on-bg:   #fdd9d3;  // content on a danger fill

    // ── Typography ────────────────────────────────────────────────────────────
    in property <string> font-family:      "Inter";
    // Base UI font, fixed at the theme default. The user-facing "font size"
    // setting drives clip-list-font-size below, not this.
    in property <length> font-size:        13px;
    in property <length> clip-list-font-size: 13px;
    // When true, clip-list body text and filter-grid icons are tinted by clip
    // type. Plain text keeps the base list colour. `ClipTypeMap.color-for`
    // holds the mapping.
    in property <bool> color-code-clip-types: false;
    in property <length> preview-font-size: 12px;
    // Max box (px) for the hover preview; drives the popup's width and height
    // cap for every clip type (and the on-disk image generation size).
    in property <length> preview-size: 300px;

    // ── Layout ────────────────────────────────────────────────────────────────
    // Row height by padding mode: Compact=24, Standard=32, Luxury=40
    in property <length> row-height:       32px;
    in property <length> border-radius:    6px;
    // Main-window bottom bar (search + filter + hamburger) height.
    in property <length> toolbar-height:   48px;
    // Popup menu metrics, shared by MenuRow, MenuSeparator and the popup
    // geometry math so a change to one cannot desync the others.
    in property <length> menu-row-height:  32px;
    in property <length> menu-separator-height: 9px;
    in property <length> menu-padding:     4px;

    // ── Timing ────────────────────────────────────────────────────────────────
    in property <duration> anim-fast:       120ms;
    in property <duration> hover-preview-delay: 400ms;
}
