// SettingsPage.slint — Settings > main page: options grouped by category
// (General | Appearance | External Apps).

import { Theme } from "Theme.slint";
import {
    TextRow,
    IntRow,
    FloatRow,
    DropRow,
    ToggleRow,
    SliderRow,
    StepperButton,
    SectionHeader,
} from "SettingsComponents.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsPage inherits ScrollView {
    // ── Row values ────────────────────────────────────────────────────────────
    in-out property <bool> s-start-with-system:    true;
    in-out property <bool> s-always-close-to-tray: true;
    in-out property <int> s-log-level-idx:        1;  // Debug/Info/Warn/Error
    in-out property <int> s-theme-idx:            0;  // System/Light/Dark
    in-out property <color> s-accent-color:       #7C6EE6;
    in-out property <string> s-font-family:          "Inter";
    in-out property <int> s-font-size-hundredths: 1300;  // 13.00 pt
    in-out property <int> s-preview-font-size-hundredths: 1200;
    in-out property <int> s-row-padding-idx:      1;  // Compact/Standard/Luxury
    in-out property <int> hover-delay:            400;
    in-out property <int> s-image-preview-size:   300;
    in-out property <bool> s-color-code-clip-types: false;
    in-out property <bool> s-paste-as-plain-text:  false;
    in-out property <bool> s-paste-moves-to-top:   true;
    in-out property <string> s-diff-tool-path:       "";
    in-out property <string> s-send-to-apps:         "";
    in-out property <string> s-blacklist-apps:       "";

    callback setting-changed(string, string);
    callback clear-accent-color();
    callback accent-picker();
    callback font-picker();
    callback open-log();

    // Tooltip text for inline controls (Tooltip.text is styled-text, so @tr is
    // bound here and interpolated through @markdown at the use site).
    private property <string> tip-open-log: @tr("Open the most recent log file in your default viewer");
    private property <string> tip-log-level: @tr("Verbosity of messages written to the log file");
    private property <[string]> log-levels: ["Debug", "Info", "Warn", "Error"];
    private property <string> tip-accent-picker: @tr("Pick a custom accent color");
    private property <string> tip-font-family: @tr("Font family used for the clip list. Click to pick a font");

    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

    out property <length> content-preferred-height: content-layout.preferred-height;

    content-layout := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 24px;
        spacing: 10px;
        // Non-stretch alignment: the ScrollView gives this layout the full
        // visible height, so stretch (the default) would distribute the
        // leftover space into every child — each SectionHeader grows, pushing
        // results down. Pinning the children to their minimum sizes keeps the
        // content packed at the top with any empty space at the bottom.
        alignment: start;

        // ── General ──────────────────────────────────────────────────────
        SectionHeader {
            text: @tr("General");
            top-margin: 0px;
        }

        ToggleRow {
            label: @tr("Start with system");
            tooltip-text: @tr("Launch Cliptoo automatically when you log in");
            value <=> root.s-start-with-system;
            committed(v) => {
                root.setting-changed("start_with_system", v ? "true" : "false");
            }
        }

        ToggleRow {
            label: @tr("Always close to tray");
            tooltip-text: @tr("Hide to the system tray when the window loses focus");
            value <=> root.s-always-close-to-tray;
            committed(v) => {
                root.setting-changed("always_close_to_tray", v ? "true" : "false");
            }
        }

        ToggleRow {
            label: @tr("Paste as plain text");
            tooltip-text: @tr("Strip formatting when pasting text, and paste file paths as text instead of attaching the file");
            value <=> root.s-paste-as-plain-text;
            committed(v) => {
                root.setting-changed("paste_as_plain_text", v ? "true" : "false");
            }
        }

        ToggleRow {
            label: @tr("Paste moves clip to top");
            tooltip-text: @tr("Move a clip to the top of the list when you paste it");
            value <=> root.s-paste-moves-to-top;
            committed(v) => {
                root.setting-changed("paste_moves_to_top", v ? "true" : "false");
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            height: 32px;
            Text {
                width: 180px;
                text: @tr("Log level");
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }

            Rectangle {
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.border-accent;
                background: Theme.bg-input;

                Tooltip {
                    text: @markdown("\{root.tip-log-level}");
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 4px;
                    cross-axis-alignment: center;
                    StepperButton {
                        text: "‹";
                        clicked => {
                            root.s-log-level-idx = root.s-log-level-idx == 0 ? root.log-levels.length - 1 : root.s-log-level-idx - 1;
                            root.setting-changed("logging_level", root.log-levels[root.s-log-level-idx]);
                        }
                    }

                    Text {
                        text: root.log-levels[root.s-log-level-idx];
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        horizontal-alignment: center;
                    }

                    StepperButton {
                        text: "›";
                        clicked => {
                            root.s-log-level-idx = Math.mod(root.s-log-level-idx + 1, root.log-levels.length);
                            root.setting-changed("logging_level", root.log-levels[root.s-log-level-idx]);
                        }
                    }
                }
            }

            Text {
                text: @tr("Open latest log");
                color: Theme.link-fg;
                font-size: Theme.font-size;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    Tooltip {
                        text: @markdown("\{root.tip-open-log}");
                    }

                    clicked => {
                        root.open-log();
                    }
                }
            }
        }

        // ── Appearance ───────────────────────────────────────────────────
        SectionHeader {
            text: @tr("Appearance");
        }

        DropRow {
            label: @tr("Theme");
            index <=> root.s-theme-idx;
            options: ["System", "Light", "Dark"];
            committed(v) => {
                root.setting-changed("theme", v);
            }
        }

        ToggleRow {
            label: @tr("Color code clip types");
            tooltip-text: @tr("Tint clip text by type: URLs blue, images green, videos red, rich text cream, and so on");
            value <=> root.s-color-code-clip-types;
            committed(v) => {
                root.setting-changed("color_code_clip_types", v ? "true" : "false");
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            height: 32px;
            Text {
                width: 180px;
                text: @tr("Accent color");
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.border-accent;
                background: root.s-accent-color;

                Tooltip {
                    text: @markdown("\{root.tip-accent-picker}");
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.accent-picker();
                    }
                }
            }

            Text {
                text: @tr("Clear");
                color: Theme.danger-fg;
                font-size: Theme.font-size;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.clear-accent-color();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            height: 32px;
            Text {
                width: 180px;
                text: @tr("Font family");
                color: Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: font-touch.has-hover ? Theme.accent-primary : Theme.border-accent;
                background: Theme.bg-input;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.s-font-family;
                        color: Theme.fg-primary;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Tooltip {
                    text: @markdown("\{root.tip-font-family}");
                }

                font-touch := TouchArea {
                    clicked => {
                        root.font-picker();
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        FloatRow {
            label: @tr("Clip list font size");
            tooltip-text: @tr("Font size of clip entries in the main list");
            value-hundredths <=> root.s-font-size-hundredths;
            min-hundredths: 800;
            max-hundredths: 2400;
            step-hundredths: 100;
            unit: " px";
            committed(v) => {
                root.setting-changed("font_size", "\{v}");
            }
        }

        FloatRow {
            label: @tr("Preview font size");
            tooltip-text: @tr("Font size used for code and color previews");
            value-hundredths <=> root.s-preview-font-size-hundredths;
            min-hundredths: 800;
            max-hundredths: 2400;
            step-hundredths: 100;
            unit: " px";
            committed(v) => {
                root.setting-changed("preview_font_size", "\{v}");
            }
        }

        DropRow {
            label: @tr("Row padding");
            tooltip-text: @tr("Vertical padding of items in the clip list");
            index <=> root.s-row-padding-idx;
            options: ["Compact", "Standard", "Luxury"];
            committed(v) => {
                root.setting-changed("clip_item_padding", v);
            }
        }

        SliderRow {
            label: @tr("Preview hover delay");
            tooltip-text: @tr("Delay before the hover preview appears");
            value <=> root.hover-delay;
            min-val: 0;
            max-val: 2000;
            step: 50;
            unit: " ms";
            zero-is-off: true;
            committed(v) => {
                root.setting-changed("hover_preview_delay", "\{v}");
            }
        }

        IntRow {
            label: @tr("Preview size");
            tooltip-text: @tr("Maximum width/height of hover previews");
            value <=> root.s-image-preview-size;
            min-val: 100;
            max-val: 800;
            step: 50;
            unit: " px";
            committed(v) => {
                root.setting-changed("hover_image_preview_size", "\{v}");
            }
        }

        // ── External Apps ────────────────────────────────────────────────
        SectionHeader {
            text: @tr("External Apps");
        }

        TextRow {
            label: @tr("Diff tool path");
            tooltip-text: @tr("Command used to compare two text clips");
            value <=> root.s-diff-tool-path;
            committed(v) => {
                root.setting-changed("compare_tool_path", v);
            }
        }

        TextRow {
            label: @tr("Send To apps");
            tooltip-text: @tr("Comma-separated list of apps that can open a clip. 'Name: command'");
            value <=> root.s-send-to-apps;
            committed(v) => {
                root.setting-changed("send_to_apps", v);
            }
        }

        TextRow {
            label: @tr("Blacklist apps");
            tooltip-text: @tr("Comma-separated list of apps excluded from clipboard capture");
            value <=> root.s-blacklist-apps;
            committed(v) => {
                root.setting-changed("blacklisted_apps", v);
            }
        }
    }
}
