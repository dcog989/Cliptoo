// MainClipArea.slint — Clip list + toolbar and all keyboard handling.
// Owns the FocusScope that receives key input and drives the blur-detection
// poll. AppWindow keeps the window-level state and delegates focus here.

import { ClipList }  from "ClipList.slint";
import { Toolbar }   from "Toolbar.slint";
import { Theme }     from "Theme.slint";
import { ClipData }  from "ClipData.slint";

export component MainClipArea inherits Rectangle {
    border-radius: Theme.border-radius;
    clip: true;
    background: transparent;
    // Seed focus to the key-handling scope (AppWindow re-anchors it on every
    // show via reset-focus()).
    forward-focus: focus-scope;

    in property <[ClipData]> clips: [];
    in property <bool> is-searching: false;
    in-out property <bool> quick-paste-active: false;
    // Set from Rust on every show/hide of the main window. Gates the
    // focus-poll timer so it never runs while the window is hidden.
    in property <bool> window-visible: false;
    property <int> quick-paste-slots: 9;
    // Encoded KeyEvent.text produced by the quick-paste modifier key
    // (Alt=U+0012, AltGr/right-alt=U+0013, Control=U+0011); computed in
    // AppWindow from quick-paste-mod.
    in property <string> quick-paste-mod-text: "\u{0013}";
    // Blur guards, aggregated/owned by AppWindow (popups are host components).
    in property <bool> popup-open: false;
    in-out property <bool> popup-just-closed: false;
    in property <bool> preview-hovered: false;

    in-out property <int> selected-index: 0;  // reset by Rust on search/filter change
    in-out property <string> search-text: "";
    in-out property <string> active-filter: "all";

    callback search-changed(string);
    callback search-backspace();
    callback search-word-backspace();
    callback filter-changed(string);
    callback item-activated(int);
    callback request-preview(int, float, float);  // id, x, y
    callback dismiss-preview();
    callback close-window();           // ESC pressed
    callback blur-closed();            // window lost focus
    callback drag-started();
    callback drag-ended();
    callback open-context-menu(int, float, float, bool, string);  // id, x, y, is-bookmarked, clip-type
    callback open-hamburger-menu();
    callback open-filter-popup();
    callback focus-regained();         // window regained OS focus (e.g. Alt+Tab back in)

    // Re-anchors keyboard focus to focus-scope. Called by AppWindow's
    // reset-focus() on every show() (see AppWindow.slint reset-focus doc).
    public function reset-focus() {
        focus-scope.focus();
    }
    // Scrolls the clip list back to the top and selects the first row.
    public function reset-scroll() {
        clip-list.nav-home();
    }

    focus-scope := FocusScope {
        key-pressed(e) => {
            // Track the quick-paste modifier key (encoded in e.text) for
            // the overlay. Only the modifier's own press flips it on, so a
            // subsequent digit press keeps the overlay active.
            if (e.text == root.quick-paste-mod-text) {
                root.quick-paste-active = true;
            }

            // ── Navigation — always intercepted regardless of search state ──
            if (e.text == Key.UpArrow) {
                clip-list.nav-up();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                clip-list.nav-down();
                return accept;
            }
            if (e.text == Key.Home) {
                clip-list.nav-home();
                return accept;
            }
            if (e.text == Key.End) {
                clip-list.nav-end();
                return accept;
            }
            if (e.text == Key.PageUp) {
                clip-list.nav-page-up();
                return accept;
            }
            if (e.text == Key.PageDown) {
                clip-list.nav-page-down();
                return accept;
            }
            // ── ESC: clear search first, then close ──
            if (e.text == Key.Escape) {
                if (root.popup-open || root.popup-just-closed) {
                    return accept;
                }
                if (root.search-text != "") {
                    root.search-text = "";
                    root.search-changed("");
                } else {
                    root.close-window();
                }
                return accept;
            }

            // ── Quick-paste: modifier held + digit 1–9 ──
            if (root.quick-paste-active && e.text >= "1" && e.text <= "\{root.quick-paste-slots}") {
                let digit = Math.floor(e.text.to-float());
                if (digit >= 1 && digit <= root.quick-paste-slots && root.clips.length > digit - 1) {
                    root.item-activated(root.clips[digit - 1].id);
                }
                return accept;
            }

            // ── Text input — only handled when LineEdit is NOT focused ──
            if (!toolbar.search-focused) {
                if (e.text == Key.Return) {
                    clip-list.activate();
                    return accept;
                }
                if (e.text == Key.Backspace && e.modifiers.control) {
                    root.search-word-backspace();
                    return accept;
                }
                if (e.text == Key.Backspace) {
                    root.search-backspace();
                    return accept;
                }
                // Only accept keys that produce printable text. Slint encodes
                // non-printable keys (PageUp/Down, Insert, Delete, F-keys, …) as
                // private-use or control characters — same filter TextInput uses.
                if (e.text != ""
                    && !e.modifiers.alt && !e.modifiers.control && !e.modifiers.meta
                    && !(e.text >= "\u{f700}" && e.text <= "\u{f7ff}")
                    && !(e.text >= "\u{0000}" && e.text <= "\u{001f}")
                    && !(e.text >= "\u{007f}" && e.text <= "\u{009f}")) {
                    root.search-text += e.text;
                    root.search-changed(root.search-text);
                    return accept;
                }
            }
            reject
        }
        key-released(e) => {
            // Clear quick-paste overlay when the modifier key is released.
            if (e.text == root.quick-paste-mod-text) {
                root.quick-paste-active = false;
            }
            reject
        }
        focus-lost(reason) => {
            // Alt may be released while the window is unfocused (e.g.
            // Alt+Tab task switcher), so key-released never fires and the
            // overlay would latch on — force it off on blur.
            root.quick-paste-active = false;
            if (reason == FocusReason.window-activation && !root.popup-open && !root.popup-just-closed) {
                root.blur-closed();
            }
        }
        focus-gained(reason) => {
            // When "always close to tray" is off, the window stays open but
            // unfocused after Alt+Tab away; switching back only restores
            // keyboard focus, not Qt/compositor activation, so the first
            // click would still just focus the window rather than register
            // on the widget beneath it. Re-request activation here, mirroring
            // show_window()'s activate_window() call.
            if (reason == FocusReason.window-activation) {
                root.focus-regained();
            }
        }

        focus-poll := Timer {
            interval: 200ms;
            // Gated on visibility: Rust sets window-visible on every
            // show/hide, so this never polls while the window is hidden.
            running: root.window-visible;
            triggered() => {
                if (!root.popup-open && !root.popup-just-closed && !focus-scope.has-focus && !toolbar.search-focused) {
                    root.blur-closed();
                }
            }
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // Clip list — fills all available vertical space
            clip-list := ClipList {
                clips: root.clips;
                quick-paste-active: root.quick-paste-active;
                quick-paste-slots: root.quick-paste-slots;
                is-searching: root.is-searching;
                selected-index <=> root.selected-index;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                // Toolbar is at the bottom of the VerticalLayout, so the list
                // top edge is at window Y=0 — no offset needed here.
                list-offset-y: 0.0;

                item-activated(id) => {
                    root.item-activated(id);
                }
                item-right-clicked(id, x, y, bookmarked, ctype) => {
                    root.open-context-menu(id, x, y, bookmarked, ctype);
                }
                request-preview(id, x, y) => {
                    root.request-preview(id, x, y);
                }
                dismiss-preview => {
                    // Cursor may have moved onto the tooltip itself rather
                    // than away from the preview area — the tooltip-hover
                    // Timer in PreviewOverlay takes over closing it there.
                    if (!root.preview-hovered) {
                        root.dismiss-preview();
                    }
                }
            }

            // Bottom bar: search + filter icon + hamburger menu
            toolbar := Toolbar {
                search-text <=> root.search-text;
                search-changed(s) => {
                    root.search-changed(s);
                }
                accepted() => {
                    clip-list.activate();
                }
                filter-changed(f) => {
                    root.filter-changed(f);
                }
                toggle-filter-grid() => {
                    root.open-filter-popup();
                }
                menu-clicked() => {
                    root.open-hamburger-menu();
                }
                drag-started() => {
                    root.drag-started();
                }
                drag-ended() => {
                    root.drag-ended();
                }
                active-filter: root.active-filter;
            }
        }
    }
}
