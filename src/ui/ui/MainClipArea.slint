// MainClipArea.slint — Clip list + toolbar and all keyboard handling.
// Owns the FocusScope that receives key input and drives the blur-detection
// poll. AppWindow keeps the window-level state and delegates focus here.

import { ClipList } from "ClipList.slint";
import { Toolbar } from "Toolbar.slint";
import { Theme } from "Theme.slint";
import { ClipData } from "ClipData.slint";

export component MainClipArea inherits Rectangle {
    border-radius: Theme.border-radius;
    clip: true;
    background: Theme.bg-primary;
    // Seed focus to the key-handling scope (AppWindow re-anchors it on every
    // show via reset-focus()).
    forward-focus: focus-scope;

    in property <[ClipData]> clips: [];
    // True while older rows of the current view can still be appended.
    in property <bool> clips-has-more: false;
    // True once the first query result has been applied; gates the empty state.
    in property <bool> clips-loaded: false;
    in property <bool> is-searching: false;
    in-out property <bool> quick-paste-active: false;
    // Set from Rust on every show/hide of the main window. Gates the
    // focus-poll timer so it never runs while the window is hidden.
    in property <bool> window-visible: false;
    property <int> quick-paste-slots: 9;
    // Encoded KeyEvent.text produced by the quick-paste modifier key
    // (Alt=U+0012, AltGr/right-alt=U+0013, Control=U+0011); computed in
    // AppWindow from quick-paste-mod.
    in property <string> quick-paste-mod-text: "\u{0013}";
    // Blur guards, aggregated/owned by AppWindow (popups are host components).
    in property <bool> popup-open: false;
    // Only the PopupWindow menus (context/hamburger/filter), excluding the
    // Settings/About/Edit child windows. The blur poll keys its popup branch
    // off this so blurring while the settings window is open keeps its current
    // behavior.
    in property <bool> popup-windows-open: false;
    // Set from Rust on a 200ms poll of the Qt window system: true while any of
    // the app's windows still holds OS activation. A popup menu steals the
    // main window's keyboard focus, so item focus is no blur signal there.
    in property <bool> window-active: true;
    in-out property <bool> popup-just-closed: false;
    // Mirrors AppWindow's flag: set by the context menu's Preview action so
    // the focus restore from the closing popup does not dismiss the request.
    in-out property <bool> menu-preview-pending: false;

    // Window-space anchor of the hamburger button, forwarded to the menu host.
    out property <length> menu-anchor-x: toolbar.menu-anchor-x;
    out property <length> menu-anchor-y: toolbar.menu-anchor-y;

    in-out property <int> selected-index: 0;  // reset by Rust on search/filter change
    in-out property <string> search-text: "";
    in-out property <string> active-filter: "all";
    property <bool> window-was-focused: false;
    // Latches while a popup menu is open and the app is inactive; fires
    // blur-closed on the second consecutive inactive tick (see the poll).
    property <bool> popup-blur-pending: false;

    callback search-changed(string);
    callback search-backspace();
    callback search-word-backspace();
    callback item-activated(int);
    callback request-delete(int);      // Delete key: arm, then confirm on a second press
    // Multi-selection bulk actions: row range plus ids added/removed from it.
    callback request-delete-selection(int, int, string, string);
    callback merge-selection(int, int, string, string);
    callback copy-clip(int);           // Ctrl+C: copy without pasting
    callback edit-clip(int);           // Ctrl+E: open the editor
    callback request-preview(int, float, float);  // id, x, y
    callback dismiss-preview();
    callback load-more();              // list neared its end: append the next page
    callback close-window();           // ESC pressed
    callback blur-closed();            // window lost focus
    callback open-context-menu(int, float, float, bool, string);  // id, x, y, is-bookmarked, clip-type
    callback open-hamburger-menu();
    callback open-filter-popup();
    callback menu-settings();          // Ctrl+, (KDE's Settings shortcut)
    callback focus-regained();         // window regained OS focus (e.g. Alt+Tab back in)

    // Re-anchors keyboard focus to focus-scope. Called by AppWindow's
    // reset-focus() on every show() (see AppWindow.slint reset-focus doc).
    public function reset-focus() {
        focus-scope.focus();
    }
    // Scrolls the clip list back to the top and selects the first row.
    public function reset-scroll() {
        clip-list.nav-home();
    }
    // Scrolls the clip list back to the top without moving the selection.
    public function scroll-to-top() {
        clip-list.scroll-to-top();
    }

    // True when selected-index points at a row. The key handler indexes clips[]
    // with it, so an empty or stale list must not reach the lookup.
    function has-selection() -> bool {
        return root.selected-index >= 0 && root.selected-index < root.clips.length;
    }

    // Multi-selection spec, read by AppWindow when the context menu opens and
    // when its bulk actions run.
    public pure function has-multi-selection() -> bool {
        return clip-list.has-multi-selection();
    }
    public pure function selection-lo() -> int { return clip-list.selection-lo(); }
    public pure function selection-hi() -> int { return clip-list.selection-hi(); }
    public pure function selection-added() -> string { return clip-list.selection-added(); }
    public pure function selection-removed() -> string { return clip-list.selection-removed(); }

    focus-scope := FocusScope {
        // The window-level scope is focused programmatically on show; keeping it
        // out of Tab traversal prevents an invisible, actionless Tab stop.
        focus-on-tab-navigation: false;
        // Captured before the search field sees them, so the menus still open
        // while the field has focus.
        capture-key-pressed(e) => {
            // Context menu without a pointer: the Menu key, plus Shift+F10
            // which is the conventional keyboard binding on X11/Wayland.
            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) {
                if (root.has-selection()) {
                    root.open-context-menu(
                        root.clips[root.selected-index].id,
                        8,
                        clip-list.selected-row-y(),
                        root.clips[root.selected-index].is-bookmarked,
                        root.clips[root.selected-index].clip-type);
                }
                return accept;
            }
            if (e.modifiers.control && e.modifiers.shift) {
                if (e.text.to-lowercase() == "f") {
                    root.open-filter-popup();
                    return accept;
                }
                if (e.text.to-lowercase() == "m") {
                    root.open-hamburger-menu();
                    return accept;
                }
            }
            // KDE convention: Ctrl+, opens Settings, also while the search
            // field has focus.
            if (e.modifiers.control && e.text == ",") {
                root.menu-settings();
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            // Track the quick-paste modifier key (encoded in e.text) for
            // the overlay. Only the modifier's own press flips it on, so a
            // subsequent digit press keeps the overlay active.
            if (e.text == root.quick-paste-mod-text) {
                root.quick-paste-active = true;
            }

            // ── Navigation ──
            // Reached when the clip list has focus; the search field forwards
            // Up/Down itself because TextInput consumes them for the cursor.
            if (e.text == Key.UpArrow) {
                clip-list.nav-up();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                clip-list.nav-down();
                return accept;
            }
            if (e.text == Key.Home) {
                clip-list.nav-home();
                return accept;
            }
            if (e.text == Key.End) {
                clip-list.nav-end();
                return accept;
            }
            if (e.text == Key.PageUp) {
                clip-list.nav-page-up();
                return accept;
            }
            if (e.text == Key.PageDown) {
                clip-list.nav-page-down();
                return accept;
            }
            // ── ESC: dismiss any open menu, then clear search, then close ──
            if (e.text == Key.Escape) {
                if (root.popup-just-closed) {
                    return accept;
                }
                // When a popup menu is open, ESC goes to the popup window
                // (each menu's esc-scope handles it), never here.
                if (root.search-text != "") {
                    root.search-text = "";
                    root.search-changed("");
                } else {
                    root.close-window();
                }
                return accept;
            }

            // ── Quick-paste: modifier held + digit 1–9 ──
            if (root.quick-paste-active && e.text >= "1" && e.text <= "\{root.quick-paste-slots}") {
                let digit = Math.floor(e.text.to-float());
                if (digit >= 1 && digit <= root.quick-paste-slots && root.clips.length > digit - 1) {
                    root.item-activated(root.clips[digit - 1].id);
                }
                return accept;
            }

            // ── Text input — only handled when the search field is NOT focused ──
            if (!toolbar.search-focused) {
                if (e.modifiers.control && e.text.to-lowercase() == "a") {
                    clip-list.select-all();
                    return accept;
                }
                // Merge selected clips into one new clip.
                if (e.modifiers.control && e.text.to-lowercase() == "m") {
                    if (clip-list.has-multi-selection()) {
                        root.merge-selection(
                            clip-list.selection-lo(),
                            clip-list.selection-hi(),
                            clip-list.selection-added(),
                            clip-list.selection-removed());
                    }
                    return accept;
                }
                // Held Delete would remove one clip per repeat, so it is
                // restricted to discrete presses. The Rust side asks for a
                // second press: Delete is one key away from Backspace and the
                // delete cannot be undone.
                if (e.text == Key.Delete && !e.repeat && root.has-selection()) {
                    if (clip-list.has-multi-selection()) {
                        root.request-delete-selection(
                            clip-list.selection-lo(),
                            clip-list.selection-hi(),
                            clip-list.selection-added(),
                            clip-list.selection-removed());
                    } else {
                        root.request-delete(root.clips[root.selected-index].id);
                    }
                    return accept;
                }
                if (e.modifiers.control && root.has-selection()) {
                    if (e.text.to-lowercase() == "c") {
                        root.copy-clip(root.clips[root.selected-index].id);
                        return accept;
                    }
                    if (e.text.to-lowercase() == "e") {
                        root.edit-clip(root.clips[root.selected-index].id);
                        return accept;
                    }
                }
                if (e.text == Key.Return) {
                    clip-list.activate();
                    return accept;
                }
                if (e.text == Key.Backspace && e.modifiers.control) {
                    root.search-word-backspace();
                    return accept;
                }
                if (e.text == Key.Backspace) {
                    root.search-backspace();
                    return accept;
                }
                // Only accept keys that produce printable text. Slint encodes
                // non-printable keys (PageUp/Down, Insert, Delete, F-keys, …) as
                // private-use or control characters — same filter TextInput uses.
                if (e.text != ""
                    && !e.modifiers.alt && !e.modifiers.control && !e.modifiers.meta
                    && !(e.text >= "\u{f700}" && e.text <= "\u{f7ff}")
                    && !(e.text >= "\u{0000}" && e.text <= "\u{001f}")
                    && !(e.text >= "\u{007f}" && e.text <= "\u{009f}")) {
                    root.search-text += e.text;
                    root.search-changed(root.search-text);
                    return accept;
                }
            }
            reject
        }
        key-released(e) => {
            // Clear quick-paste overlay when the modifier key is released.
            if (e.text == root.quick-paste-mod-text) {
                root.quick-paste-active = false;
            }
            reject
        }
        focus-lost(reason) => {
            // Alt may be released while the window is unfocused (e.g.
            // Alt+Tab task switcher), so key-released never fires and the
            // overlay would latch on — force it off on blur.
            root.quick-paste-active = false;
            if (reason == FocusReason.window-activation && !root.popup-open && !root.popup-just-closed) {
                root.blur-closed();
            }
        }
        focus-gained(reason) => {
            // When "always close to tray" is off, the window stays open but
            // unfocused after Alt+Tab away; switching back only restores
            // keyboard focus, not Qt/compositor activation, so the first
            // click would still just focus the window rather than register
            // on the widget beneath it. Re-request activation here, mirroring
            // show_window()'s activate_window() call.
            // Skipped while a popup menu or child window (Settings/About/Edit)
            // is open: dismissing a menu popup returns activation to this
            // window (its parent toplevel), and re-activating then would raise
            // the main window above a just-opened child window.
            if (reason == FocusReason.window-activation && !root.popup-open) {
                root.focus-regained();
            }
        }

        // Safety net: if the popup close did not hand focus back to the search
        // field, stop suppressing the next genuine search click after a moment.
        menu-preview-expiry := Timer {
            interval: 500ms;
            running: root.menu-preview-pending;
            triggered => {
                root.menu-preview-pending = false;
            }
        }

        focus-poll := Timer {
            interval: 200ms;
            // Gated on visibility: Rust sets window-visible on every
            // show/hide, so this never polls while the window is hidden.
            running: root.window-visible;
            triggered() => {
                if (!root.popup-just-closed) {
                    if (root.popup-windows-open) {
                        // A popup menu steals the window's keyboard focus while
                        // open, so item focus is no blur signal here. The Rust
                        // window-active poll reports whether any of the app's
                        // windows still holds OS activation; require two
                        // consecutive inactive ticks so the brief deactivation
                        // as a popup opens can't close the app.
                        if (!root.window-active) {
                            if (root.popup-blur-pending) {
                                root.blur-closed();
                            } else {
                                root.popup-blur-pending = true;
                            }
                        } else {
                            root.popup-blur-pending = false;
                        }
                    } else {
                        root.popup-blur-pending = false;
                        // `popup-open` (broad) also covers the Settings/About/
                        // Edit child windows — without it, opening one would
                        // make this branch blur-close the main window as soon
                        // as the child window steals focus.
                        if (!root.popup-open && !focus-scope.has-focus && !toolbar.search-focused) {
                            root.blur-closed();
                        }
                    }
                }
                // focus-gained above only fires when the focus-scope itself
                // holds focus; the search field keeps focus once clicked, so
                // detect the false→true focus transition here to re-activate
                // on Alt+Tab back. Skipped while a popup menu or a child
                // window (Settings/About/Edit) is open: closing a menu restores
                // item focus to this scope, and firing focus-regained then
                // would raise the main window above the just-opened child
                // window (Qt activation is asynchronous).
                if (!root.popup-open
                    && (focus-scope.has-focus || toolbar.search-focused)
                    && !root.window-was-focused) {
                    root.focus-regained();
                }
                root.window-was-focused = focus-scope.has-focus || toolbar.search-focused;
            }
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // Clip list — fills all available vertical space
            clip-list := ClipList {
                clips: root.clips;
                has-more: root.clips-has-more;
                loaded: root.clips-loaded;
                quick-paste-active: root.quick-paste-active;
                quick-paste-slots: root.quick-paste-slots;
                is-searching: root.is-searching;
                is-filtered: root.is-searching || root.active-filter != "all";
                popup-open: root.popup-open;
                selected-index <=> root.selected-index;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                item-activated(id) => {
                    root.item-activated(id);
                }
                clear-search => {
                    root.search-text = "";
                    root.search-changed("");
                }
                item-right-clicked(id, x, y, bookmarked, ctype) => {
                    root.open-context-menu(id, x, y, bookmarked, ctype);
                }
                request-preview(id, x, y) => {
                    root.request-preview(id, x, y);
                }
                dismiss-preview => {
                    root.dismiss-preview();
                }
                load-more => {
                    root.load-more();
                }
            }

            // Bottom bar: search + filter icon + hamburger menu
            toolbar := Toolbar {
                search-text <=> root.search-text;
                search-changed(s) => {
                    root.search-changed(s);
                }
                accepted() => {
                    clip-list.activate();
                }
                search-nav-up() => {
                    clip-list.nav-up();
                }
                search-nav-down() => {
                    clip-list.nav-down();
                }
                search-nav-page-up() => {
                    clip-list.nav-page-up();
                }
                search-nav-page-down() => {
                    clip-list.nav-page-down();
                }
                toggle-filter-grid() => {
                    root.open-filter-popup();
                }
                menu-clicked() => {
                    root.open-hamburger-menu();
                }
                active-filter: root.active-filter;
                search-focus-changed(focused) => {
                    if (focused) {
                        // Focus handed back when the context menu closed,
                        // often to the search field. The menu's Preview action
                        // just requested a preview; dismissing here would bump
                        // the preview generation and cancel that request.
                        if (root.menu-preview-pending) {
                            root.menu-preview-pending = false;
                        } else {
                            root.dismiss-preview();
                        }
                    }
                }
            }
        }
    }
}
