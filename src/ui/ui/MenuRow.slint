// MenuRow.slint — A single row for a popup menu: optional icon + label +
// optional right-arrow, with selected/pressed accent styling and a hover tint.
// Used by ContextMenu (32px rows) and HamburgerMenu (36px rows).
// MenuSeparator is the divider variant: keeping it a separate component means
// MenuRow always contributes its label width, which the popups size from.

import { Theme } from "Theme.slint";

export component MenuSeparator {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border-subtle;
    }
}

export component MenuRow {
    in property <image> icon;
    in property <string> label;
    in property <bool> is-danger: false;
    // Destructive row in its confirm state: the second activation deletes, so
    // the row switches to the warning palette instead of the danger one.
    in property <bool> armed: false;
    in property <bool> has-arrow: false;
    // Keyboard selection highlight, driven by the owning menu.
    in property <bool> selected: false;
    in property <length> row-height: 32px;
    callback clicked;

    height: root.row-height;

    content := Rectangle {
        // Rows are keyboard-driven by the owning menu (arrow keys move
        // `selected`), so expose each one as a selectable list item and let
        // assistive tech activate the same callback as a click.
        accessible-role: list-item;
        accessible-label: root.label;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected;
        accessible-action-default => { root.clicked(); }

        border-radius: 5px;
        border-width: 1px;
        // A destructive row (Delete) swaps the hover fill for a red fill and
        // pale content, plus a pale outline while active; once armed for
        // confirmation it takes the amber warning fill instead.
        // Keyboard selection keeps the accent outline; pointer hover is only a
        // surface tint, so it never reads as the row Enter will activate.
        property <bool> active: root.selected || touch.pressed;
        property <bool> hover-only: touch.has-hover && !active;
        property <bool> danger-hot: root.is-danger && !root.armed && (active || hover-only);
        property <bool> confirming: root.is-danger && root.armed;
        border-color: confirming
            ? Theme.warn-base
            : active
            ? (root.is-danger ? Theme.danger-on-bg : Theme.accent-primary)
            : transparent;
        background: confirming
            ? Theme.warn-base.mix(Theme.bg-primary, 0.85)
            : danger-hot
            ? Theme.danger-bg
            : active
            ? Theme.bg-row-selected
            : hover-only
            ? Theme.bg-row-hover
            : transparent;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            if root.icon.width > 0: Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: root.is-danger
                    ? (content.confirming ? Theme.warn-fg : content.danger-hot ? Theme.danger-on-bg : Theme.danger-fg)
                    : Theme.fg-secondary;
            }

            Text {
                text: root.label;
                color: root.is-danger
                    ? (content.confirming ? Theme.warn-fg : content.danger-hot ? Theme.danger-on-bg : Theme.danger-fg)
                    : Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
                horizontal-stretch: root.has-arrow ? 1 : 0;
            }

            if root.has-arrow: Text {
                text: "…";
                color: touch.has-hover && !touch.pressed ? Theme.fg-clip-list : Theme.fg-muted;
                font-size: Theme.font-size + 2px;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            mouse-cursor: pointer;
        }
    }
}
