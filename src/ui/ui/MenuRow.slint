// MenuRow.slint — A single row for a popup menu: optional icon + label +
// optional sublabel + optional right-arrow, with hover/press accent styling.
// Used by ContextMenu (32px rows) and HamburgerMenu (36px rows).

import { Theme } from "Theme.slint";

export component MenuRow {
    in property <image> icon;
    in property <string> label;
    in property <string> sublabel: "";
    in property <bool> is-danger: false;
    in property <bool> has-arrow: false;
    // "…" submenu affordance, sits at the row's right edge.
    in property <length> arrow-size: Theme.font-size + 2px;
    in property <bool> is-separator: false;
    in property <length> row-height: 32px;
    callback clicked;

    height: root.is-separator ? 9px : root.row-height;

    // Separator line; only visible for separator rows. Always instantiated so
    // the row keeps a content-based preferred size (if-conditional children
    // contribute no preferred-size constraint to the row).
    sep := Rectangle {
        visible: root.is-separator;
        y: 4px;
        height: 1px;
        background: Theme.border-subtle;
    }

    content := Rectangle {
        visible: !root.is-separator;
        border-radius: 5px;
        border-width: 1px;
        // A destructive row (Delete) swaps the accent hover for a red fill,
        // a pale outline and pale content.
        property <bool> danger-hot: root.is-danger && (touch.has-hover || touch.pressed);
        border-color: touch.has-hover || touch.pressed
            ? (root.is-danger ? Theme.danger-on-bg : Theme.accent-primary)
            : transparent;
        background: danger-hot
            ? Theme.danger-bg
            : touch.pressed ? Theme.bg-row-selected : touch.has-hover ? Theme.bg-row-hover : transparent;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            if root.icon.width > 0: Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: root.is-danger
                    ? (content.danger-hot ? Theme.danger-on-bg : Theme.danger-fg)
                    : Theme.fg-secondary;
            }

            Text {
                text: root.label;
                color: root.is-danger
                    ? (content.danger-hot ? Theme.danger-on-bg : Theme.danger-fg)
                    : Theme.fg-primary;
                font-size: Theme.font-size;
                vertical-alignment: center;
                horizontal-stretch: root.has-arrow ? 1 : 0;
            }

            if root.sublabel != "": Text {
                text: root.sublabel;
                color: touch.has-hover && !touch.pressed ? Theme.fg-clip-list : Theme.fg-muted;
                font-size: Theme.font-size - 1px;
                vertical-alignment: center;
            }

            if root.has-arrow: Text {
                text: "…";
                color: touch.has-hover && !touch.pressed ? Theme.fg-clip-list : Theme.fg-muted;
                font-size: root.arrow-size;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            mouse-cursor: pointer;
        }
    }
}
